<div class="section-template--product-recommendations" data-js="product-recommendations-root">
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <section class="py-8">
      <h2 class="text-xl font-semibold mb-4">You may also like</h2>
      <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4" role="list">
        {% for product in recommendations.products limit: section.settings.products_limit %}
          <li>
            <a href="{{ product.url }}" class="group block">
              {% if product.featured_media %}
                {%- assign image = product.featured_media.preview_image -%}
                {% render 'image', image: image, widths: '300,600', class: 'w-full aspect-square object-cover' %}
              {% endif %}
              <p class="mt-2 text-sm font-medium group-hover:underline">{{ product.title }}</p>
              <p class="text-sm text-gray-600">{{ product.price | money }}</p>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
