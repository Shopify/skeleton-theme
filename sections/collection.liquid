<main class="collection-main">
  <h1>{{ collection.title }}</h1>

  {% render 'filters' %}

  <div class="collection-products">
    {% paginate collection.products by 20 %}
      <div class="collection-products-grid">
        {% for product in collection.products %}
          <div class="collection-product">
            {% if product.featured_image %}
              {% render 'image-collection', image: product.featured_image, url: product.url %}
            {% endif %}
            <div class="collection-product-content">
              <h2 class="collection-product-title">
                <a href="{{ product.url }}" class="link-reset">{{ product.title | escape }}</a>
              </h2>
              <div>
                {% render 'price', product: product %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</main>

{% stylesheet %}
  .collection-products-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 576px) {
    .collection-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .collection-products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-product {
    display: grid;
    gap: 1rem;
  }

  .collection-product-content {
    display: grid;
    gap: 0.5rem;
  }

  .collection-product-title {
    font-size: 1.6rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
