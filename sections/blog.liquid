<main class="blog-main">
  <h1>{{ blog.title }}</h1>

  <div class="blog-grid">
    {% paginate blog.articles by 5 %}
      {% for article in blog.articles %}
        <article class="blog-grid-article">
          {% if article.image %}
            {% render 'image-blog', image: article.image, url: article.url %}
          {% endif %}
          <h2>
            {{ article.title | link_to: article.url }}
          </h2>
          {% assign date = article.published_at | time_tag: format: 'date' %}
          <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
          {% if article.excerpt != blank %}
            <p>{{ article.excerpt }}</p>
          {% else -%}
            <p>{{ article.content | strip_html | truncate: 200 }}</p>
          {% endif %}
        </article>
      {% endfor %}

      {%- if paginate.pages > 1 -%}
        {{- paginate | default_pagination -}}
      {%- endif -%}
    {% endpaginate %}
  </div>
</main>

{% stylesheet %}
  .blog-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 576px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-grid-article {
    display: grid;
    gap: 1rem;
  }

  .blog-grid-article a {
    text-decoration: none;
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
