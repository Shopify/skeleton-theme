<main class="contact-main">
  <h1>{{ 'contact.title' | t }}</h1>

  {% form 'contact', class: 'contact-form' %}
    {{ form.errors | default_errors }}

    {% if form.posted_successfully? %}
      <p class="contact-success">Thanks for contacting us. We'll get back to you as soon as possible.</p>
    {% endif %}

    <div class="form-group">
      <input
        type="text"
        name="contact[name]"
        id="name"
        class="form-group-input"
        placeholder="{{ 'contact.name' | t }}"
        required
      >
      <label for="name" class="form-group-label">{{ 'contact.name' | t }}</label>
    </div>

    <div class="form-group">
      <input
        type="tel"
        name="contact[phone]"
        id="phone"
        class="form-group-input"
        placeholder="{{ 'contact.phone' | t }}"
      >
      <label for="phone" class="form-group-label">{{ 'contact.phone' | t }}</label>
    </div>

    <div class="form-group">
      <input
        type="email"
        name="contact[email]"
        id="email"
        class="form-group-input"
        placeholder="{{ 'contact.email' | t }}"
        required
      >
      <label for="email" class="form-group-label">{{ 'contact.email' | t }}</label>
    </div>

    <div class="form-group">
      <textarea
        name="contact[body]"
        id="message"
        class="form-group-input"
        placeholder="{{ 'contact.message' | t }}"
        required
      ></textarea>
      <label for="message" class="form-group-label">{{ 'contact.message' | t }}</label>
    </div>

    <div class="submit">
      <button type="submit" class="button">{{ 'contact.submit' | t }}</button>
    </div>
  {% endform %}
</main>

{% stylesheet %}
  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .contact-main .errors ul {
    margin: 0 0 2rem;
    padding: 0 0 0 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [],
  "presets": [{ "name": "t:general.contact" }]
}
{% endschema %}
