<main class="cart-main">
  <h1>{{ 'cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <table class="cart-table">
        <thead>
          <tr class="cart-table-row-head">
            <th colspan="2">{{ 'cart.product' | t }}</th>
            <th class="hide-sm">{{ 'cart.quantity' | t }}</th>
            <th>{{ 'cart.subtotal' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr class="cart-table-row" data-key="{{ item.key }}">
              <td class="cart-table-image">
                {% render 'image',
                  image: item.image,
                  url: item.url,
                  width: 400,
                  height: 400,
                  crop: 'center',
                  sizes: '90px'
                %}
              </td>
              <td class="cart-table-product">
                <p>
                  <a href="{{ item.url }}" class="link-reset">{{ item.product.title }}</a>
                </p>
                {% if item.product.has_only_default_variant == false %}
                  {% for option in item.options_with_values %}
                    <p class="cart-table-option">{{ option.name }}: {{ option.value }}</p>
                  {% endfor %}
                {% endif %}
                <div class="cart-table-item-price">
                  <div>
                    {% if item.original_price > item.final_price %}
                      <s>{{ item.original_price | money }}</s>
                    {% endif %}

                    {{ item.final_price | money }}
                  </div>
                  <div>
                    {% if item.line_level_discount_allocations.size > 0 %}
                      <ul class="cart-table-item-discounts list-reset">
                        {% for discount_allocation in item.line_level_discount_allocations %}
                          <li class="cart-table-item-discount">
                            {{ 'icon-discount.svg' | inline_asset_content }}
                            {{ discount_allocation.discount_application.title }}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>
              </td>
              <td class="cart-table-actions">
                <div class="cart-item-actions">
                  <div class="cart-item-quantity" aria-label="Quantity selector for {{ item.product.title | escape }}">
                    <button
                      type="button"
                      class="cart-item-qty-button"
                      data-delta="-1"
                      data-key="{{ item.key }}"
                      aria-label="Decrease quantity for {{ item.product.title | escape }}"
                    >
                      −
                    </button>
                    <input
                      type="number"
                      min="0"
                      step="1"
                      class="cart-item-quantity-value"
                      aria-live="polite"
                      value="{{ item.quantity }}"
                      inputmode="numeric"
                    >
                    <button
                      type="button"
                      class="cart-item-qty-button"
                      data-delta="1"
                      data-key="{{ item.key }}"
                      aria-label="Increase quantity for {{ item.product.title | escape }}"
                    >
                      +
                    </button>
                  </div>
                  <button
                    type="button"
                    class="cart-item-remove button-reset"
                    data-key="{{ item.key }}"
                    aria-label="Remove item"
                  >
                    {{ 'icon-trash.svg' | inline_asset_content }}
                  </button>
                </div>
              </td>
              <td class="cart-table-line-price">
                <div class="cart-table-item-line-price">
                  <div>
                    {% if item.original_line_price > item.final_line_price %}
                      <s>{{ item.original_line_price | money }}</s>
                    {% endif %}
                  </div>
                  <div>
                    {{ item.final_line_price | money }}
                  </div>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="cart-footer">
        <div class="cart-footer-subtotal">{{ 'cart.total' | t }}: {{ cart.total_price | money }}</div>
        <div>
          {% if cart.cart_level_discount_applications.size > 0 %}
            <ul class="cart-footer-discounts list-reset">
              {% for discount_application in cart.cart_level_discount_applications %}
                <li class="cart-footer-discount">
                  {{ 'icon-discount.svg' | inline_asset_content }}
                  {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <div class="cart-footer-calc">{{ 'cart.calculate' | t }}</div>
        <div class="cart-footer-actions">
          <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}" class="button">
        </div>
      </div>
    </form>
  {% else %}
    <p>{{ 'cart.empty' | t }}</p>
  {% endif %}
</main>

{% stylesheet %}
  .cart-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }

  .cart-table th {
    text-align: left;
  }

  @media (max-width: 767px) {
    .cart-table-row-head {
      display: flex;
      justify-content: space-between;
    }
  }

  .cart-table-row,
  .cart-table-row-head {
    border-bottom: 0.1rem solid rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 767px) {
    .cart-table-row {
      display: grid;
      grid-template: repeat(2, auto) / repeat(4, 1fr);
      gap: 0.5rem;
    }
  }

  .cart-table-row-head th {
    font-weight: 400;
    padding: 1rem 0;
  }

  .cart-table-image {
    width: 10rem;
    padding: 1rem 1rem 1rem 0;
  }

  @media (max-width: 767px) {
    .cart-table-image {
      grid-row: 1 / 3;
    }
  }

  .cart-table-product {
    padding: 1rem 0;
  }

  @media (max-width: 767px) {
    .cart-table-product {
      grid-column: 2 / 4;
    }
  }

  .cart-main .icon-discount {
    width: 1.2rem;
  }

  .cart-table-item-discount {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cart-table s {
    opacity: 0.8;
    font-size: 1.4rem;
  }

  .cart-table-option {
    margin: 0.2rem 0;
    color: rgba(0, 0, 0, 0.7);
  }

  .cart-table-item-price {
    margin-top: 1rem;
  }

  .cart-table-actions {
    padding: 1rem 0;
  }

  @media (max-width: 767px) {
    .cart-table-actions {
      grid-column: 2 / 4;
    }
  }

  .cart-item-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .cart-item-actions {
      flex-direction: row;
    }
  }

  .cart-item-quantity {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border: 0.1rem solid rgba(0, 0, 0, 0.15);
    border-radius: 999rem;
  }

  .cart-item-qty-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    cursor: pointer;
    font-size: 1.8rem;
    line-height: 1;
  }

  .cart-item-quantity-value {
    width: 4rem;
    min-width: 2rem;
    text-align: center;
    border: 0;
    background: transparent;
    font: inherit;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .cart-item-quantity-value::-webkit-outer-spin-button,
  .cart-item-quantity-value::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item-remove {
    display: inline-block;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    width: 3rem;
  }

  .cart-table-line-price {
    padding: 1rem 0;
  }

  @media (max-width: 767px) {
    .cart-table-line-price {
      display: flex;
      grid-column: 4 / 5;
      grid-row: 1;
    }
  }

  .cart-footer {
    display: grid;
    justify-content: flex-end;
    text-align: right;
    gap: 1rem;
    margin-top: 2rem;
  }

  .cart-footer-discounts {
    display: flex;
    justify-content: flex-end;
    opacity: 0.8;
    font-size: 1.4rem;
  }

  .cart-footer-discount {
    display: flex;
    gap: 0.4rem;
  }

  .cart-footer-calc {
    font-size: 1.2rem;
  }

  .cart-footer-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: flex-end;
  }

  .cart-table-item-line-price.is-loading {
    position: relative;
    color: transparent;
  }

  .cart-table-item-line-price.is-loading::before {
    content: '';
    display: block;
    width: 1.8rem;
    height: 1.8rem;
    border: 0.2rem solid rgba(0, 0, 0, 0.15);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    animation: cart-spin 0.7s linear infinite;
  }

  @keyframes cart-spin {
    to {
      transform: rotate(360deg);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const refreshCartSection = async () => {
      try {
        const response = await fetch('/?sections=cart');
        if (!response.ok) throw new Error('Unable to refresh cart section.');

        const data = await response.json();
        const sectionHtml = data.cart;

        if (!sectionHtml) return;

        const parser = new DOMParser();
        const parsedHtml = parser.parseFromString(sectionHtml, 'text/html');
        const cartMain = parsedHtml.querySelector('.cart-main');
        const cartMainTarget = document.querySelector('.cart-main');

        if (cartMain && cartMainTarget) {
          cartMainTarget.innerHTML = cartMain.innerHTML;
        }
      } catch (error) {
        console.error(error);
      }
    };

    const refreshCartCounts = async () => {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Unable to refresh cart count.');

        const cart = await response.json();
        const updateTargets = document.querySelectorAll('.cart-item-count');

        updateTargets.forEach((target) => {
          target.textContent = cart.item_count;
          if (cart.item_count > 0) {
            target.classList.remove('hidden');
          } else {
            target.classList.add('hidden');
          }
        });
      } catch (error) {
        console.error(error);
      }
    };

    const queuedQuantityUpdates = new Map();
    let queuedQuantityTimer = null;

    const flushQueuedQuantityUpdates = async () => {
      if (!queuedQuantityUpdates.size) return;

      const queuedUpdates = Array.from(queuedQuantityUpdates.entries());
      queuedQuantityUpdates.clear();

      const body = new URLSearchParams();
      const linePrices = [];

      queuedUpdates.forEach(([itemKey, quantity]) => {
        body.append(`updates[${itemKey}]`, String(quantity));

        const row = document.querySelector(`.cart-table-row[data-key="${itemKey}"]`);
        const linePrice = row ? row.querySelector('.cart-table-item-line-price') : null;

        if (linePrice) {
          linePrice.classList.add('is-loading');
          linePrice.setAttribute('aria-busy', 'true');
          linePrices.push(linePrice);
        }
      });

      try {
        const response = await fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          },
          body,
        });

        if (!response.ok) {
          throw new Error('Unable to update quantities.');
        }

        await refreshCartSection();
        await refreshCartCounts();
      } catch (error) {
        console.error(error);
        alert('There was a problem updating the cart. Please try again.');
      } finally {
        linePrices.forEach((price) => {
          price.classList.remove('is-loading');
          price.removeAttribute('aria-busy');
        });
      }
    };

    document.addEventListener('click', async (event) => {
      const removeButton = event.target.closest('.cart-item-remove');

      if (removeButton) {
        const itemKey = removeButton.dataset.key;
        const cartRow = removeButton.closest('.cart-table-row');
        const linePrice = cartRow ? cartRow.querySelector('.cart-table-item-line-price') : null;

        if (linePrice) {
          linePrice.classList.add('is-loading');
          linePrice.setAttribute('aria-busy', 'true');
        }

        try {
          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            },
            body: new URLSearchParams({
              id: itemKey,
              quantity: 0,
            }),
          });

          if (!response.ok) {
            throw new Error('Unable to remove item.');
          }

          await refreshCartSection();
          await refreshCartCounts();
        } catch (error) {
          console.error(error);
          if (linePrice) {
            linePrice.classList.remove('is-loading');
            linePrice.removeAttribute('aria-busy');
          }
          alert('There was a problem removing this item. Please try again.');
        }

        return;
      }

      const button = event.target.closest('.cart-item-qty-button');

      if (!button) return;

      const itemKey = button.dataset.key;
      const delta = Number(button.dataset.delta);
      const cartRow = button.closest('.cart-table-row');
      const linePrice = cartRow ? cartRow.querySelector('.cart-table-item-line-price') : null;
      const quantityContainer = button.closest('.cart-item-quantity');
      const quantityValue = quantityContainer ? quantityContainer.querySelector('.cart-item-quantity-value') : null;
      const currentQuantity = quantityValue ? Number(quantityValue.value || 0) : 0;
      const lastQueuedQuantity = queuedQuantityUpdates.has(itemKey)
        ? Number(queuedQuantityUpdates.get(itemKey))
        : currentQuantity;
      const updatedQuantity = Math.max(0, lastQueuedQuantity + delta);

      if (quantityValue) {
        quantityValue.value = String(updatedQuantity);
      }

      if (linePrice) {
        linePrice.classList.add('is-loading');
        linePrice.setAttribute('aria-busy', 'true');
      }

      queuedQuantityUpdates.set(itemKey, updatedQuantity);

      if (queuedQuantityTimer) {
        clearTimeout(queuedQuantityTimer);
      }

      queuedQuantityTimer = setTimeout(() => {
        flushQueuedQuantityUpdates();
      }, 1000);
    });

    document.addEventListener('change', (event) => {
      const quantityInput = event.target.closest('.cart-item-quantity-value');

      if (!quantityInput) return;

      const cartRow = quantityInput.closest('.cart-table-row');
      const itemKey = cartRow ? cartRow.dataset.key : null;
      if (!itemKey) return;

      const parsedValue = Number(quantityInput.value || 0);
      const updatedQuantity = Math.max(0, Number.isFinite(parsedValue) ? parsedValue : 0);
      quantityInput.value = String(updatedQuantity);

      const linePrice = cartRow ? cartRow.querySelector('.cart-table-item-line-price') : null;

      if (linePrice) {
        linePrice.classList.add('is-loading');
        linePrice.setAttribute('aria-busy', 'true');
      }

      queuedQuantityUpdates.set(itemKey, updatedQuantity);

      if (queuedQuantityTimer) {
        clearTimeout(queuedQuantityTimer);
      }

      queuedQuantityTimer = setTimeout(() => {
        flushQueuedQuantityUpdates();
      }, 1000);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
