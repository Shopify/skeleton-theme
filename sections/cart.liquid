{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<h1>{{ 'cart.title' | t }}</h1>

<div data-js="cart-page" data-section-id="{{ section.id }}" data-currency="{{ cart.currency.iso_code }}" class="space-y-4">
  <p data-js="cart-page-status" role="status" aria-live="polite" class="sr-only"></p>
  <p data-js="cart-page-error" role="alert" class="min-h-5 text-sm text-red-700"></p>

  <div data-js="cart-page-empty" {% if cart.item_count > 0 %}hidden{% endif %}>
    <p>{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="underline">{{ 'cart.continue_shopping' | t }}</a>
  </div>

  <ul data-js="cart-page-items" class="space-y-3" {% if cart.item_count == 0 %}hidden{% endif %}>
    {% for item in cart.items %}
      <li class="relative grid grid-cols-[80px_1fr] gap-3 border-b pb-3" data-line="{{ forloop.index }}">
        <div data-js="cart-page-line-overlay" class="pointer-events-none absolute inset-0 z-10 hidden items-center justify-center bg-white/60">
          <span class="h-5 w-5 rounded-full border-2 border-black/20 border-t-black animate-spin" aria-hidden="true"></span>
        </div>
        {% if item.image %}
          <a href="{{ item.url }}" class="block h-20 w-20 overflow-hidden border">
            {% render 'image', image: item.image, width: 160, class: 'h-full w-full object-cover' %}
          </a>
        {% endif %}

        <div class="space-y-2">
          <a href="{{ item.url }}" class="font-medium">{{ item.product.title }}</a>
          {% if item.variant.title != 'Default Title' %}
            <p class="text-sm opacity-70">{{ item.variant.title }}</p>
          {% endif %}

          <div class="flex items-center gap-2">
            <button type="button" data-js="cart-page-dec" data-line="{{ forloop.index }}" class="h-8 w-8 border" aria-label="Decrease quantity">-</button>
            <span data-js="cart-page-qty" class="min-w-6 text-center">{{ item.quantity }}</span>
            <button type="button" data-js="cart-page-inc" data-line="{{ forloop.index }}" class="h-8 w-8 border" aria-label="Increase quantity">+</button>
            <button type="button" data-js="cart-page-remove" data-line="{{ forloop.index }}" class="ml-auto underline">{{ 'cart.remove' | t }}</button>
          </div>

          <p>{{ item.final_line_price | money }}</p>
        </div>
      </li>
    {% endfor %}
  </ul>

  <div data-js="cart-page-footer" class="space-y-3" {% if cart.item_count == 0 %}hidden{% endif %}>
    <p class="text-sm">{{ 'cart.subtotal' | t }}: <strong data-js="cart-page-subtotal">{{ cart.total_price | money }}</strong></p>

    <form action="{{ routes.cart_url }}" method="post" class="space-y-3 border p-3">
      <label for="CartNote" class="block text-sm font-medium">{{ 'cart.note' | t }}</label>
      <textarea
        id="CartNote"
        name="note"
        rows="3"
        class="w-full border px-3 py-2"
      >{{ cart.note }}</textarea>

      <label for="CartOrderReference" class="block text-sm font-medium">{{ 'cart.order_reference' | t }}</label>
      <input
        id="CartOrderReference"
        type="text"
        name="attributes[order_reference]"
        value="{{ cart.attributes.order_reference | escape }}"
        class="w-full border px-3 py-2"
      >

      <button type="submit" name="update" class="border px-3 py-2">{{ 'cart.update' | t }}</button>
    </form>

    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="border px-3 py-2">{{ 'cart.checkout' | t }}</button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
