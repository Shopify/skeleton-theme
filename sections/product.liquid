{% comment %} Âme — Página de Produto {% endcomment %}

{%- liquid
  # cv é nil quando nenhum option_values foi enviado na URL — força o cliente a escolher
  assign cv = product.selected_variant
  assign has_variant = false
  if cv != blank
    assign has_variant = true
  endif
  assign media_size = product.media.size

  assign pdp_videos_show = false
  assign pdp_videos_count = 0
  if section.settings.videos_enabled
    for m in product.media
      if m.media_type == 'video' or m.media_type == 'external_video'
        assign pdp_videos_count = pdp_videos_count | plus: 1
      endif
    endfor
    if pdp_videos_count > 0
      assign pdp_videos_show = true
    endif
  endif
  assign pdp_videos_pos = section.settings.videos_position | default: 'below-title'
-%}

{%- capture pdp_videos_widget -%}
  {%- if pdp_videos_show -%}
    {%- render 'video-stories',
      videos: product.media,
      source_type: 'media',
      widget_id: 'pdp',
      format: section.settings.videos_format,
      border_type: section.settings.videos_border_type,
      cor: section.settings.videos_cor,
      cor_fim: section.settings.videos_cor_fim,
      cor_3: section.settings.videos_cor_3,
      angulo: section.settings.videos_angulo,
      tamanho: section.settings.videos_tamanho,
      espessura: section.settings.videos_espessura,
      espacamento: section.settings.videos_espacamento,
      mostrar_titulo: section.settings.videos_mostrar_titulo,
      autoplay: section.settings.videos_autoplay
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign pdp_btn_bg = section.settings.pdp_btn_bg_color | default: '#000000'
  assign pdp_btn_fg = section.settings.pdp_btn_fg_color | default: '#ffffff'
-%}
<style>
  #shopify-section-{{ section.id }} .pdp {
    --pdp-btn-bg: {{ pdp_btn_bg }};
    --pdp-btn-fg: {{ pdp_btn_fg }};
  }
</style>

<!-- Breadcrumb -->
<nav class="pdp-breadcrumb full-width" aria-label="Navegação">
  <a href="{{ routes.root_url }}">Início</a>
  <span aria-hidden="true">/</span>
  {%- if collection -%}
    <a href="{{ collection.url }}">{{ collection.title }}</a>
    <span aria-hidden="true">/</span>
  {%- endif -%}
  <span aria-current="page">{{ product.title }}</span>
</nav>

<div class="pdp full-width">
  <!-- ── Coluna esquerda: galeria ── -->
  <div class="pdp__gallery">
    {%- assign selection_pos = section.settings.selection_info_position | default: 'below' -%}
    <!-- Wrapper sticky no mobile: imagem + barra de seleção compactam juntas -->
    <div class="pdp__sticky-wrap pdp__sticky-wrap--selection-{{ selection_pos }}">
      <!-- Imagem principal -->
      <div class="pdp__main-img-wrap">
        {%- if media_size > 0 -%}
          <div class="pdp__track" id="pdp-track">
            {%- for media in product.media -%}
              <div class="pdp__slide" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign img_loading = 'lazy'
                    assign img_fetchpriority = 'auto'

                    # ⚡ Bolt: Eager load the LCP (Largest Contentful Paint) image.
                    # 💡 What: Apply `loading: 'eager'` and `fetchpriority: 'high'` to the first image in the product gallery.
                    # 🎯 Why: Hardcoding `loading: 'lazy'` for all images delays the LCP. Eager loading the first image improves perceived load time.
                    # 📊 Impact: Improves LCP Web Vital metric significantly.
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_fetchpriority = 'high'
                    endif
                    assign img_alt = media.alt | default: product.title | escape
                  -%}
                  {{-
                    media
                    | image_url: width: 1200
                    | image_tag:
                      loading: img_loading,
                      fetchpriority: img_fetchpriority,
                      class: 'pdp__slide-img',
                      alt: img_alt
                  -}}
                {%- elsif media.media_type == 'video' -%}
                  {{ media | video_tag: class: 'pdp__slide-img', autoplay: false, loop: true, muted: true }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <!-- contador -->
          <div class="pdp__counter" aria-live="polite"><span id="pdp-current">1</span> / {{ media_size }}</div>
          <!-- botões de navegação -->
          <button class="pdp__nav pdp__nav--prev" id="pdp-prev" aria-label="Anterior">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back_ios</span>
          </button>
          <button class="pdp__nav pdp__nav--next" id="pdp-next" aria-label="Próximo">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span>
          </button>
        {%- else -%}
          <div class="pdp__track" id="pdp-track">
            <div class="pdp__slide">
              {{ 'product-1' | placeholder_svg_tag: 'pdp__slide-img pdp__slide-img--placeholder' }}
            </div>
          </div>
        {%- endif -%}

        {%- liquid
          assign img_base_price = cv.price | default: product.price_min
          assign img_compare = cv.compare_at_price | default: 0
          if img_compare == 0
            assign img_compare = product.compare_at_price_max | default: 0
          endif
          assign pdp_img_discount = 0
          if img_compare > img_base_price
            assign pdp_img_discount = img_compare | minus: img_base_price | times: 100 | divided_by: img_compare | round
          elsif settings.auto_discount_enabled and settings.auto_discount_percent > 0
            assign pdp_img_discount = settings.auto_discount_percent
          endif
        -%}
        <div id="pdp-img-badge-wrap">
          {%- if pdp_img_discount > 0 -%}
            <span class="pdp__img-discount-badge" aria-label="{{ pdp_img_discount }}% de desconto">
              {{ pdp_img_discount }}% OFF
            </span>
          {%- endif -%}
        </div>

        {%- if product.tags contains 'customizacao_pingente' -%}
          <div class="pdp__pingente-overlay" data-pingente-overlay hidden aria-hidden="true">
            {%- comment -%} theme-check-disable AssetUrl {%- endcomment -%}
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              alt=""
              data-pingente-overlay-img
              loading="lazy"
              width="800"
              height="800"
            >
            {%- comment -%} theme-check-enable AssetUrl {%- endcomment -%}
          </div>
        {%- endif -%}

        {%- if selection_pos == 'over' -%}
          <!-- Resumo sobre a imagem (overlay no topo) -->
          <div class="pdp__selection-info" data-selection-info hidden aria-live="polite">
            <span class="pdp__selection-info__label">Você selecionou:</span>
            <span class="pdp__selection-info__values" data-selection-info-values></span>
          </div>
        {%- endif -%}
      </div>

      {%- if selection_pos != 'over' -%}
        <!-- Resumo abaixo da imagem (padrão) -->
        <div class="pdp__selection-info" data-selection-info hidden aria-live="polite">
          <span class="pdp__selection-info__label">Você selecionou:</span>
          <span class="pdp__selection-info__values" data-selection-info-values></span>
        </div>
      {%- endif -%}
    </div>
    <!-- /pdp__sticky-wrap -->

    <!-- Thumbnails em linha horizontal com scroll -->
    {%- if media_size > 1 -%}
      <div class="pdp__thumbs-wrap">
        <div class="pdp__thumbs-fade pdp__thumbs-fade--top" aria-hidden="true"></div>
        <div class="pdp__thumbs" role="list">
          {%- for media in product.media -%}
            <button
              class="pdp__thumb{% if forloop.first %} pdp__thumb--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Imagem {{ forloop.index }}"
              role="listitem"
              type="button"
            >
              {{-
                media.preview_image
                | image_url: width: 160
                | image_tag: loading: 'lazy', alt: '', class: 'pdp__thumb-img'
              -}}
            </button>
          {%- endfor -%}
        </div>
        <div class="pdp__thumbs-fade pdp__thumbs-fade--bottom" aria-hidden="true"></div>
      </div>
    {%- endif -%}
  </div>

  <!-- ── Coluna direita: informações ── -->
  <div class="pdp__info">
    <!-- Badge de coleção / heritage -->
    {%- liquid
      assign show_meta = false
      for tag in product.tags
        if tag == 'heritage' or tag == 'Heritage'
          assign show_meta = true
        endif
      endfor
      if product.available == false
        assign show_meta = true
      endif
    -%}
    {%- if show_meta -%}
      <div class="pdp__meta">
        {%- for tag in product.tags -%}
          {%- if tag == 'heritage' or tag == 'Heritage' -%}
            <span class="ame-chip">Heritage Series</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if product.available == false -%}
          <span class="ame-chip">Esgotado</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if pdp_videos_pos == 'above-title' -%}{{ pdp_videos_widget }}{%- endif -%}

    <!-- Título -->
    <h1 class="pdp__title">{{ product.title }}</h1>

    {%- if pdp_videos_pos == 'below-title' -%}{{ pdp_videos_widget }}{%- endif -%}

    <!-- Rating (placeholder — substituir por app) -->
    <div class="pdp__rating" aria-label="4.8 de 5 estrelas">
      <div class="pdp__stars" aria-hidden="true">
        <span
          class="material-symbols-outlined"
          style="font-variation-settings:'FILL' 1;font-size:0.9rem;color:var(--color-primary);"
          >star</span
        >
        <span
          class="material-symbols-outlined"
          style="font-variation-settings:'FILL' 1;font-size:0.9rem;color:var(--color-primary);"
          >star</span
        >
        <span
          class="material-symbols-outlined"
          style="font-variation-settings:'FILL' 1;font-size:0.9rem;color:var(--color-primary);"
          >star</span
        >
        <span
          class="material-symbols-outlined"
          style="font-variation-settings:'FILL' 1;font-size:0.9rem;color:var(--color-primary);"
          >star</span
        >
        <span
          class="material-symbols-outlined"
          style="font-variation-settings:'FILL' 0;font-size:0.9rem;color:var(--color-outline-variant);"
          >star</span
        >
      </div>
      <span class="pdp__rating-text">4.8 · 32 avaliações</span>
    </div>

    <!-- ── Bloco de preços ── -->
    {%- liquid
      # Sem variante selecionada: usa price_min do produto
      assign base_price = cv.price
      if has_variant == false
        assign base_price = product.price_min
      endif

      assign cv_compare = cv.compare_at_price | default: 0
      if cv_compare == 0
        assign cv_compare = product.compare_at_price_max | default: 0
      endif
      assign has_compare = false
      assign discount_pct = 0
      if cv_compare > base_price
        assign has_compare = true
        assign discount_pct = cv_compare | minus: base_price | times: 100 | divided_by: cv_compare
      endif

      assign effective_price = base_price
      assign displayed_compare = cv_compare
      if has_compare == false and settings.auto_discount_enabled and settings.auto_discount_percent > 0
        assign has_compare = true
        assign discount_pct = settings.auto_discount_percent
        assign displayed_compare = base_price
        assign disc_cents = base_price | times: discount_pct | divided_by: 100
        assign effective_price = base_price | minus: disc_cents
      endif

      assign pix_pct = settings.pix_discount | default: 5
      assign pix_price_cents = effective_price | times: pix_pct | divided_by: 100
      assign pix_price_cents = effective_price | minus: pix_price_cents
      assign inst_count = settings.installments_count | default: 3
      assign inst_value = effective_price | divided_by: inst_count
    -%}

    <div class="pdp__price-block" id="pdp-price-block">
      <!-- Linha "De:" riscado -->
      {%- if has_compare -%}
        <div class="pdp__price-compare-row">
          <s class="pdp__price-compare">De: {{ displayed_compare | money }}</s>
        </div>
      {%- endif -%}

      <!-- Preço no cartão + badge de desconto -->
      <div class="pdp__price-card-row">
        <span class="pdp__price-label">a partir de</span>
        <strong class="pdp__price-main">{{ effective_price | money }}</strong>
        <span class="pdp__price-label">no cartão</span>
        {%- if has_compare -%}
          <span class="pdp__discount-badge">−{{ discount_pct }}% OFF</span>
        {%- endif -%}
      </div>

      <!-- Preço no Pix -->
      {%- if settings.show_pix != false -%}
        <div class="pdp__price-pix-row">
          <span class="pdp__price-label">ou</span>
          <strong class="pdp__price-pix" id="pdp-price-pix">{{ pix_price_cents | money }}</strong>
          <span class="pdp__price-label">com Pix</span>
        </div>
      {%- endif -%}

      <!-- Parcelamento -->
      {%- if settings.show_installments != false and inst_count > 1 -%}
        <p class="pdp__installments">
          Até <strong>{{ inst_count }}x</strong> de <strong id="pdp-inst-value">{{ inst_value | money }}</strong> sem
          juros
          {%- if settings.show_installments_link != false -%}
            <a href="#" class="pdp__installments-link">Ver mais detalhes</a>
          {%- endif -%}
        </p>
      {%- endif -%}

      <!-- Cashback -->
      <div id="pdp-cashback-wrap">
        {%- render 'cashback', cashback_price: effective_price, cashback_mode: 'pdp' -%}
      </div>
    </div>

    {%- if pdp_videos_pos == 'below-price' -%}{{ pdp_videos_widget }}{%- endif -%}

    <!-- ── Descrição curta (metafield custom.descricao_curta) ── -->
    {%- if product.metafields.custom.descricao_curta != blank -%}
      <div class="pdp__desc pdp__desc--short">{{ product.metafields.custom.descricao_curta }}</div>
    {%- endif -%}

    <!-- ── Formulário de produto ── -->
    {%- form 'product', product, id: 'pdp-form', novalidate: true -%}
      <input
        type="hidden"
        name="id"
        value="{{ cv.id }}"
        id="pdp-variant-id"
        data-media-id="{{ cv.featured_media.id | default: cv.featured_image.id }}"
      >

      <!-- Opções (Cor, Tamanho...) — renderizadas sob demanda via Section Rendering API -->
      <div id="pdp-options-wrap" data-section-id="{{ section.id }}">
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign is_color = false
            if option.name == 'Color' or option.name == 'Cor' or option.name == 'Acabamento'
              assign is_color = true
            endif
            assign is_metal_color = false
            if settings.show_metal_color_swatches and option.name == 'Cor do Metal' or settings.show_metal_color_swatches and option.name == 'Metal'
              assign is_metal_color = true
            endif
          -%}

          <div class="pdp__option" data-option-group-index="{{ forloop.index0 }}">
            <div class="pdp__option-header">
              <span class="pdp__option-label">{{ option.name }}</span>
              <span class="pdp__option-value" id="pdp-opt-val-{{ forloop.index }}">
                {%- if has_variant -%}{{ option.selected_value }}{%- endif -%}
              </span>
            </div>

            {%- if is_color -%}
              <!-- Grade de swatches por imagem (6 colunas no mobile) -->
              <div class="pdp__swatches" data-option-index="{{ forloop.index0 }}">
                {%- for option_value in option.values -%}
                  {%- liquid
                    assign sw_variant = option_value.variant
                    assign sw_img = ''
                    assign sw_media_id = ''
                    if sw_variant.featured_media != blank
                      assign sw_img = sw_variant.featured_media.preview_image | image_url: width: 120
                      assign sw_media_id = sw_variant.featured_media.id
                    elsif sw_variant.featured_image != blank
                      assign sw_img = sw_variant.featured_image | image_url: width: 120
                      assign sw_media_id = sw_variant.featured_image.id
                    endif
                  -%}
                  <button
                    type="button"
                    class="pdp__swatch{% if has_variant and option_value.selected %} pdp__swatch--active{% endif %}{% unless option_value.available %} pdp__swatch--disabled{% endunless %}"
                    data-value="{{ option_value | escape }}"
                    data-option-value-id="{{ option_value.id }}"
                    aria-label="{{ option_value }}"
                    title="{{ option_value }}"
                    {% if sw_media_id != '' %}
                      data-media-id="{{ sw_media_id }}"
                    {% endif %}
                    {% unless option_value.available %}
                      aria-disabled="true"
                    {% endunless %}
                  >
                    {%- if sw_img != '' -%}
                      <img
                        src="{{ sw_img }}"
                        alt="{{ option_value | escape }}"
                        class="pdp__swatch-img"
                        loading="lazy"
                        width="120"
                        height="120"
                      >
                    {%- else -%}
                      <span
                        class="pdp__swatch-color"
                        style="background:var(--swatch-{{ option_value | downcase | replace: ' ', '-' }},var(--color-surface-container,#f8ece0));"
                      ></span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- elsif is_metal_color -%}
              <!-- Botões com swatch de cor do metal -->
              <div class="pdp__sizes pdp__sizes--metal" data-option-index="{{ forloop.index0 }}">
                {%- for option_value in option.values -%}
                  {%- assign metal_slug = option_value | downcase | replace: ' ', '-' -%}
                  <button
                    type="button"
                    class="pdp__size-btn pdp__size-btn--metal{% if has_variant and option_value.selected %} pdp__size-btn--active{% endif %}{% unless option_value.available %} pdp__size-btn--disabled{% endunless %}"
                    data-value="{{ option_value | escape }}"
                    data-option-value-id="{{ option_value.id }}"
                    aria-label="{{ option_value | escape }}"
                    {% unless option_value.available %}
                      aria-disabled="true"
                    {% endunless %}
                  >
                    <span
                      class="pdp__metal-dot"
                      aria-hidden="true"
                      style="background:var(--metal-{{ metal_slug }}, var(--color-surface-container,#f8ece0));"
                    ></span>
                    {{ option_value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <!-- Botões de tamanho -->
              <div class="pdp__sizes" data-option-index="{{ forloop.index0 }}">
                {%- for option_value in option.values -%}
                  <button
                    type="button"
                    class="pdp__size-btn{% if has_variant and option_value.selected %} pdp__size-btn--active{% endif %}{% unless option_value.available %} pdp__size-btn--disabled{% endunless %}"
                    data-value="{{ option_value | escape }}"
                    data-option-value-id="{{ option_value.id }}"
                    aria-label="{{ option_value | escape }}"
                    {% unless option_value.available %}
                      aria-disabled="true"
                    {% endunless %}
                  >
                    {{ option_value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- render 'pingente-customization', product: product -%}

      <!-- ── Campos Personalizados ── -->
      {%- for cf_i in (1..10) -%}
        {%- liquid
          assign cf_en_key = 'custom_field_' | append: cf_i | append: '_enable'
          assign cf_tag_key = 'custom_field_' | append: cf_i | append: '_tag'
          assign cf_enabled = settings[cf_en_key]
          assign cf_cfg_tag = settings[cf_tag_key]
        -%}
        {%- if cf_enabled and product.tags contains cf_cfg_tag -%}
          {%- comment -%}
            ⚡ Bolt: Optimize Custom Fields Loop
            💡 What: Replaced nested loop with a single loop and `contains` array check.
            🎯 Why: Iterating over `product.tags` and `(1..10)` causes O(M*N) overhead. `contains` reduces iterations to exactly 10.
            📊 Impact: Reduces iteration overhead from O(M*N) to O(N).
          {%- endcomment -%}
          {%- liquid
            assign cf_nm_key = 'custom_field_' | append: cf_i | append: '_name'
            assign cf_tt_key = 'custom_field_' | append: cf_i | append: '_title'
            assign cf_ph_key = 'custom_field_' | append: cf_i | append: '_placeholder'
            assign cf_hl_key = 'custom_field_' | append: cf_i | append: '_helper'
            assign cf_lm_key = 'custom_field_' | append: cf_i | append: '_limiter'
            assign cf_tp_key = 'custom_field_' | append: cf_i | append: '_type'
            assign cf_op_key = 'custom_field_' | append: cf_i | append: '_options'
            assign cf_rq_key = 'custom_field_' | append: cf_i | append: '_required'
            assign cf_name = settings[cf_nm_key]
            assign cf_title = settings[cf_tt_key]
            assign cf_placeholder = settings[cf_ph_key] | default: cf_title
            assign cf_helper = settings[cf_hl_key]
            assign cf_limiter = settings[cf_lm_key]
            assign cf_type = settings[cf_tp_key]
            assign cf_options = settings[cf_op_key]
            assign cf_req = settings[cf_rq_key]
          -%}
          <div class="pdp__custom-field">
            {%- if cf_type == 'text' or cf_type == 'date' -%}
              <label class="pdp__custom-field__label" for="cf-{{ cf_name | handle }}">
                {{- cf_title -}}
                {%- if cf_req -%}
                  <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
                {%- endif -%}
              </label>
              <input
                id="cf-{{ cf_name | handle }}"
                type="text"
                name="properties[{{ cf_name }}]"
                placeholder="{{ cf_placeholder }}"
                class="pdp__custom-field__input{% if cf_type == 'date' %} pdp__custom-field__input--date{% endif %}"
                {%- if cf_req %}
                  data-cf-required="true"
                {% endif %}
                {%- if cf_limiter != blank %}
                  maxlength="{{ cf_limiter }}"
                {% endif %}
              >
              {%- if cf_helper != blank or cf_limiter != blank -%}
                <div class="pdp__custom-field__footer">
                  {%- if cf_helper != blank -%}
                    <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
                  {%- endif -%}
                  {%- if cf_limiter != blank -%}
                    <span
                      class="pdp__custom-field__counter"
                      data-cf-counter
                      data-cf-max="{{ cf_limiter }}"
                      aria-live="polite"
                      >0 / {{ cf_limiter -}}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if cf_req -%}
                <p class="pdp__custom-field__error-msg">Este campo é obrigatório.</p>
              {%- endif -%}
            {%- elsif cf_type == 'long_text' -%}
              <label class="pdp__custom-field__label" for="cf-{{ cf_name | handle }}">
                {{- cf_title -}}
                {%- if cf_req -%}
                  <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
                {%- endif -%}
              </label>
              <textarea
                id="cf-{{ cf_name | handle }}"
                name="properties[{{ cf_name }}]"
                placeholder="{{ cf_placeholder }}"
                class="pdp__custom-field__textarea"
                {%- if cf_req %}
                  data-cf-required="true"
                {% endif %}
                {%- if cf_limiter != blank %}
                  maxlength="{{ cf_limiter }}"
                {% endif %}
                rows="3"
              ></textarea>
              {%- if cf_helper != blank or cf_limiter != blank -%}
                <div class="pdp__custom-field__footer">
                  {%- if cf_helper != blank -%}
                    <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
                  {%- endif -%}
                  {%- if cf_limiter != blank -%}
                    <span
                      class="pdp__custom-field__counter"
                      data-cf-counter
                      data-cf-max="{{ cf_limiter }}"
                      aria-live="polite"
                      >0 / {{ cf_limiter -}}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if cf_req -%}
                <p class="pdp__custom-field__error-msg">Este campo é obrigatório.</p>
              {%- endif -%}
            {%- elsif cf_type == 'radio' -%}
              <div class="pdp__custom-field__label">
                {{- cf_title -}}
                {%- if cf_req -%}
                  <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
                {%- endif -%}
              </div>
              <div class="pdp__custom-field__radio-group">
                {%- assign cf_opts = cf_options | split: ',' -%}
                {%- for cf_opt in cf_opts -%}
                  {%- assign opt_val = cf_opt | strip -%}
                  <button
                    type="button"
                    class="pdp__custom-field__radio-btn"
                    data-value="{{ opt_val | escape }}"
                    aria-label="{{ opt_val | escape }}"
                  >
                    {{- opt_val -}}
                  </button>
                {%- endfor -%}
              </div>
              <input
                type="hidden"
                name="properties[{{ cf_name }}]"
                id="cf-hidden-{{ cf_name | handle }}"
                class="pdp__custom-field__radio-val"
                {%- if cf_req %}
                  data-cf-required="true"
                {% endif %}
              >
              {%- if cf_helper != blank -%}
                <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
              {%- endif -%}
              {%- if cf_req -%}
                <p class="pdp__custom-field__error-msg">Selecione uma opção.</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Quantidade -->
      <div class="pdp__qty">
        <span class="pdp__option-label">Quantidade</span>
        <div class="pdp__qty-ctrl">
          <button type="button" class="pdp__qty-btn" id="pdp-qty-minus" aria-label="Diminuir">−</button>
          <input
            type="number"
            name="quantity"
            id="pdp-qty"
            value="1"
            min="1"
            class="pdp__qty-input"
            aria-label="Quantidade"
          >
          <button type="button" class="pdp__qty-btn" id="pdp-qty-plus" aria-label="Aumentar">+</button>
        </div>
      </div>

      {%- if pdp_videos_pos == 'above-cta' -%}{{ pdp_videos_widget }}{%- endif -%}

      <!-- CTAs -->
      <div class="pdp__ctas">
        <div id="pdp-add-btn-wrap" style="display:contents">
          {%- liquid
            # Só desabilita quando o cliente já escolheu uma variante e ela está esgotada.
            # Sem nada selecionado, deixa habilitado pra exibir o erro de validação no clique.
            assign cta_sold_out = false
            if has_variant and cv.available == false
              assign cta_sold_out = true
            endif
          -%}
          <button
            type="submit"
            class="ame-cta pdp__add-btn"
            id="pdp-add-btn"
            {% if cta_sold_out %}
              disabled
            {% endif %}
          >
            {%- if cta_sold_out -%}
              Esgotado
            {%- else -%}
              Adicionar ao Carrinho
              <span class="material-symbols-outlined" style="font-size:1rem;" aria-hidden="true">shopping_bag</span>
            {%- endif -%}
          </button>
        </div>

        <button type="button" class="pdp__wishlist-btn" aria-label="Favoritar" id="pdp-wishlist" aria-pressed="false">
          <span
            class="material-symbols-outlined"
            style="font-size:1.25rem;font-variation-settings:'FILL' 0;"
            aria-hidden="true"
            >favorite</span
          >
        </button>
      </div>
    {%- endform -%}
  </div>
  <!-- /pdp__info -->
</div>
<!-- /pdp -->

<!-- ── Acordeões de detalhes ── -->
<div class="pdp-accordions full-width">
  {%- for block in section.blocks -%}
    {%- if block.type == 'accordion' -%}
      <div class="ame-accordion" {{ block.shopify_attributes }}>
        <button
          class="ame-accordion__btn"
          type="button"
          aria-expanded="false"
          aria-controls="pdp-accordion-content-{{ section.id }}-{{ forloop.index }}"
        >
          <span>{{ block.settings.title }}</span>
          <span
            class="material-symbols-outlined ame-accordion__icon"
            style="font-variation-settings:'wght' 300;"
            aria-hidden="true"
            >add</span
          >
        </button>
        <div id="pdp-accordion-content-{{ section.id }}-{{ forloop.index }}" class="ame-accordion__content" hidden>
          <div class="ame-accordion__body">{{ block.settings.body }}</div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- if section.blocks.size == 0 and product.description != blank -%}
    <div class="ame-accordion">
      <button
        class="ame-accordion__btn"
        type="button"
        aria-expanded="false"
        aria-controls="pdp-accordion-content-{{ section.id }}-default"
      >
        <span>Detalhes do Produto</span>
        <span
          class="material-symbols-outlined ame-accordion__icon"
          style="font-variation-settings:'wght' 300;"
          aria-hidden="true"
          >add</span
        >
      </button>
      <div id="pdp-accordion-content-{{ section.id }}-default" class="ame-accordion__content" hidden>
        <div class="ame-accordion__body">{{ product.description }}</div>
      </div>
    </div>
  {%- endif -%}
</div>

<!-- ── Produtos relacionados ── -->
{%- if section.settings.show_related and recommendations.performed and recommendations.products_count > 0 -%}
  <div class="ame-pdp-related full-width">
    <div class="ame-pdp-related__header ame-reveal">
      <p class="ame-label-sm">Complete o Look</p>
      <h2 class="ame-pdp-related__title">Você Também Vai Amar.</h2>
    </div>
    <div class="ame-pdp-related__grid">
      {% comment %}
        ⚡ Bolt: Replace snippet render inside for-loop with `render ... for` syntax.
        💡 What: Pre-slices the recommendations to 4 products and uses the `render 'product-card' for array` tag instead of manually looping.
        🎯 Why: Liquid processes a `for` loop with a `render` inside by parsing and scoping the snippet per iteration (N+1 overhead).
        📊 Impact: Eliminates N+1 rendering overhead, improving product page rendering time.
        🔬 Measurement: Profile the Server Response time on product pages.
      {% endcomment %}
      {%- assign limited_recs = recommendations.products | slice: 0, 4 -%}
      {%- render 'product-card' for limited_recs as card_product -%}
    </div>
  </div>
{%- endif -%}

<script>
  (() => {
    /* ── Carousel ── */
    const track   = document.getElementById('pdp-track');
    const thumbs     = document.querySelectorAll('.pdp__thumb');
    const counter    = document.getElementById('pdp-current');
    const thumbsEl   = document.querySelector('.pdp__thumbs');
    const thumbsWrap = document.querySelector('.pdp__thumbs-wrap');
    let cur = 0;
    const total = thumbs.length || 1;

    function updateThumbIndicators() {
      if (!thumbsWrap || !thumbsEl) return;
      thumbsWrap.classList.toggle('can-scroll-up',   thumbsEl.scrollLeft > 4);
      thumbsWrap.classList.toggle('can-scroll-down',
        thumbsEl.scrollLeft < thumbsEl.scrollWidth - thumbsEl.clientWidth - 4);
    }

    function scrollThumbIntoView(thumb) {
      if (!thumbsEl || !thumb) return;
      const relLeft  = thumb.offsetLeft - thumbsEl.offsetLeft;
      const relRight = relLeft + thumb.offsetWidth;
      if (relRight > thumbsEl.scrollLeft + thumbsEl.clientWidth) {
        thumbsEl.scrollTo({ left: relRight - thumbsEl.clientWidth, behavior: 'smooth' });
      } else if (relLeft < thumbsEl.scrollLeft) {
        thumbsEl.scrollTo({ left: relLeft, behavior: 'smooth' });
      }
    }

    function goTo(i) {
      cur = Math.max(0, Math.min(i, total - 1));
      track.style.transform = `translateX(-${cur * 100}%)`;
      thumbs.forEach((t, idx) => t.classList.toggle('pdp__thumb--active', idx === cur));
      if (counter) counter.textContent = cur + 1;
      scrollThumbIntoView(thumbs[cur]);
    }

    if (thumbsEl) {
      thumbsEl.addEventListener('scroll', updateThumbIndicators, { passive: true });
      updateThumbIndicators();
    }

    document.getElementById('pdp-prev')?.addEventListener('click', () => goTo(cur - 1));
    document.getElementById('pdp-next')?.addEventListener('click', () => goTo(cur + 1));
    thumbs.forEach(t => t.addEventListener('click', () => goTo(+t.dataset.index)));

    /* swipe */
    let sx = 0;
    track?.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
    track?.addEventListener('touchend', e => {
      const dx = sx - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? cur + 1 : cur - 1);
    }, { passive: true });

    /* ── Quantidade ── */
    const qtyInput = document.getElementById('pdp-qty');
    document.getElementById('pdp-qty-minus')?.addEventListener('click', () => {
      if (qtyInput && +qtyInput.value > 1) qtyInput.value = +qtyInput.value - 1;
    });
    document.getElementById('pdp-qty-plus')?.addEventListener('click', () => {
      if (qtyInput) qtyInput.value = +qtyInput.value + 1;
    });

    /* ── Variantes (Section Rendering API — suporta >250 variantes) ── */
    const SECTION_ID = {{ section.id | json }};
    const PRODUCT_URL = {{ product.url | json }};

    function navigateGalleryToMedia(mediaId) {
      if (!mediaId || !track) return;
      const targetSlide = track.querySelector(`[data-media-id="${mediaId}"]`);
      if (!targetSlide) return;
      const slides = Array.from(track.querySelectorAll('.pdp__slide'));
      const idx = slides.indexOf(targetSlide);
      if (idx >= 0) goTo(idx);
    }

    async function refreshVariantSection() {
      const optionValueIds = [];
      document.querySelectorAll('#pdp-options-wrap [data-option-index]').forEach(g => {
        const active = g.querySelector('.pdp__swatch--active, .pdp__size-btn--active');
        if (active?.dataset.optionValueId) optionValueIds.push(active.dataset.optionValueId);
      });
      if (optionValueIds.length === 0) return;

      const params = new URLSearchParams({
        section_id: SECTION_ID,
        option_values: optionValueIds.join(','),
      });
      try {
        const res = await fetch(`${PRODUCT_URL}?${params.toString()}`, { headers: { Accept: 'text/html' } });
        if (!res.ok) return;
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        ['pdp-options-wrap', 'pdp-price-block', 'pdp-add-btn-wrap', 'pdp-img-badge-wrap'].forEach(id => {
          const fresh = doc.getElementById(id);
          const current = document.getElementById(id);
          if (fresh && current) current.replaceWith(fresh);
        });

        const freshVariantInput = doc.getElementById('pdp-variant-id');
        const currentVariantInput = document.getElementById('pdp-variant-id');
        if (freshVariantInput && currentVariantInput) {
          currentVariantInput.value = freshVariantInput.value;
          if (freshVariantInput.dataset.mediaId) {
            currentVariantInput.dataset.mediaId = freshVariantInput.dataset.mediaId;
          } else {
            delete currentVariantInput.dataset.mediaId;
          }
        }

        bindOptionClicks();

        // Prioriza a featured_media da variante selecionada (cobre opções como Tamanho,
        // Cor do Metal, Formato — que não têm data-media-id no botão). Fallback: swatch ativo.
        const variantMediaId = currentVariantInput?.dataset.mediaId;
        const newActive = document.querySelector('#pdp-options-wrap .pdp__swatch--active');
        if (variantMediaId) navigateGalleryToMedia(variantMediaId);
        else if (newActive?.dataset.mediaId) navigateGalleryToMedia(newActive.dataset.mediaId);

        document.dispatchEvent(new CustomEvent('pdp:variant-changed'));
      } catch (err) {
        console.warn('[pdp] refreshVariantSection failed', err);
      }
    }

    function isSelectionComplete() {
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      if (!groups.length) return true;
      return Array.from(groups).every(g =>
        g.querySelector('.pdp__swatch--active, .pdp__size-btn--active')
      );
    }

    /* ── Resumo "Você selecionou: X + Y + Z." sobre a imagem (mobile) ── */
    function updateSelectionInfo() {
      const wrap = document.querySelector('[data-selection-info]');
      if (!wrap) return;
      const valuesEl = wrap.querySelector('[data-selection-info-values]');
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      const values = [];
      groups.forEach(g => {
        const active = g.querySelector('.pdp__swatch--active, .pdp__size-btn--active');
        if (active?.dataset.value) values.push(active.dataset.value);
      });
      if (values.length === 0) {
        wrap.hidden = true;
        return;
      }
      valuesEl.textContent = values.join(' + ') + '.';
      wrap.hidden = false;
    }

    function bindOptionClicks() {
      document.querySelectorAll('#pdp-options-wrap [data-option-index]').forEach(group => {
        const btns = group.querySelectorAll('.pdp__swatch, .pdp__size-btn');
        btns.forEach(btn => btn.addEventListener('click', () => {
          if (btn.getAttribute('aria-disabled') === 'true') return;
          btns.forEach(b => b.classList.remove('pdp__swatch--active', 'pdp__size-btn--active'));
          btn.classList.add(btn.classList.contains('pdp__swatch') ? 'pdp__swatch--active' : 'pdp__size-btn--active');
          const valEl = document.getElementById(`pdp-opt-val-${+group.dataset.optionIndex + 1}`);
          if (valEl) valEl.textContent = btn.dataset.value;

          // Limpa o highlight de erro nesse grupo (cliente respondeu)
          group.closest('.pdp__option')?.classList.remove('pdp__option--invalid');

          if (btn.classList.contains('pdp__swatch') && btn.dataset.mediaId) {
            navigateGalleryToMedia(btn.dataset.mediaId);
          }

          updateSelectionInfo();

          // Section Rendering API só roda quando tudo está selecionado — sem isso o
          // servidor devolveria cv=nil e perderíamos os botões com seleção parcial.
          if (isSelectionComplete()) {
            refreshVariantSection();
          } else {
            // Sinaliza pro pingente revalidar o estado da coleira (mesmo sem variant final)
            document.dispatchEvent(new CustomEvent('pdp:variant-changed'));
          }
        }));
      });
    }

    bindOptionClicks();
    // Boot: caso a URL traga ?variant=... os botões já vêm marcados, então mostramos.
    updateSelectionInfo();
    // Re-aplica após Section Rendering API substituir o markup das opções.
    document.addEventListener('pdp:variant-changed', updateSelectionInfo);

    /* ── Validação no submit: destaca opções faltantes + scroll + toast ── */
    function validateAndHighlight() {
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      const missing = [];
      groups.forEach(g => {
        const wrap = g.closest('.pdp__option');
        if (!g.querySelector('.pdp__swatch--active, .pdp__size-btn--active')) {
          wrap?.classList.add('pdp__option--invalid');
          missing.push(wrap);
        } else {
          wrap?.classList.remove('pdp__option--invalid');
        }
      });
      if (missing.length === 0) return { ok: true };
      const labels = missing.map(w => w.querySelector('.pdp__option-label')?.textContent.trim()).filter(Boolean);
      // Scroll até o primeiro grupo faltante
      const headerH = document.querySelector('.ame-header-group')?.getBoundingClientRect().height || 0;
      const firstTop = missing[0].getBoundingClientRect().top + window.scrollY - headerH - 16;
      window.scrollTo({ top: firstTop, behavior: 'smooth' });
      return { ok: false, msg: labels.length
        ? `Selecione: ${labels.join(', ')}.`
        : 'Selecione todas as opções antes de continuar.' };
    }

    /* Toast simples no topo da PDP */
    function showSelectionToast(msg) {
      let toast = document.getElementById('pdp-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'pdp-toast';
        toast.className = 'pdp__toast';
        toast.setAttribute('role', 'alert');
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('is-visible');
      clearTimeout(showSelectionToast._t);
      showSelectionToast._t = setTimeout(() => toast.classList.remove('is-visible'), 3500);
    }

    // Expõe pra ser usado pelo handler de submit que já existe abaixo
    window.AmePdpValidate = function () {
      const r = validateAndHighlight();
      if (!r.ok) showSelectionToast(r.msg);
      return r.ok;
    };
    // Toast público — usado também pelo snippet do pingente
    window.AmePdpToast = showSelectionToast;

    /* ── Campos Personalizados — radio ── */
    document.querySelectorAll('.pdp__custom-field__radio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.pdp__custom-field');
        group?.querySelectorAll('.pdp__custom-field__radio-btn').forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        const hidden = group?.querySelector('.pdp__custom-field__radio-val');
        if (hidden) hidden.value = btn.dataset.value;
        group?.classList.remove('pdp__custom-field--error');
      });
    });

    /* ── Contador de caracteres dos campos personalizados ── */
    document.querySelectorAll('.pdp__custom-field [data-cf-counter]').forEach(counter => {
      const max = parseInt(counter.dataset.cfMax, 10) || 0;
      if (!max) return;
      const wrap = counter.closest('.pdp__custom-field');
      const field = wrap?.querySelector('input[maxlength], textarea[maxlength]');
      if (!field) return;
      const update = () => {
        const len = field.value.length;
        counter.textContent = `${len} / ${max}`;
        counter.classList.toggle('is-near', len >= max * 0.8 && len < max);
        counter.classList.toggle('is-full', len >= max);
      };
      field.addEventListener('input', update);
      update();
    });

    document.getElementById('pdp-form')?.addEventListener('input', e => {
      if (e.target.dataset.cfRequired) {
        e.target.closest('.pdp__custom-field')?.classList.remove('pdp__custom-field--error');
      }
    });

    /* ── Wishlist ── */
    const wishBtn = document.getElementById('pdp-wishlist');
    wishBtn?.addEventListener('click', () => {
      const on = wishBtn.classList.toggle('is-active');
      wishBtn.setAttribute('aria-pressed', on);
      wishBtn.querySelector('.material-symbols-outlined').style.fontVariationSettings = on ? "'FILL' 1" : "'FILL' 0";
    });

    /* ── Add to cart AJAX ── */
    document.getElementById('pdp-form')?.addEventListener('submit', async e => {
      e.preventDefault();

      /* Validate variant selection (todas as opções escolhidas) */
      if (!window.AmePdpValidate || !window.AmePdpValidate()) return;

      /* Validate required custom fields */
      let cfValid = true;
      e.target.querySelectorAll('[data-cf-required]').forEach(field => {
        const wrap = field.closest('.pdp__custom-field');
        if (!field.value.trim()) { cfValid = false; wrap?.classList.add('pdp__custom-field--error'); }
        else wrap?.classList.remove('pdp__custom-field--error');
      });
      if (!cfValid) return;

      /* Validate pingente (se cliente optou por adicionar) */
      if (window.amePingente?.isActive()) {
        const pv = window.amePingente.validate();
        if (!pv.ok) {
          (window.AmePdpToast || ((m) => alert(m)))(pv.msg);
          return;
        }
      }

      const btn  = document.getElementById('pdp-add-btn');
      const orig = btn.innerHTML;

      btn.innerHTML = 'Adicionando... <span class="material-symbols-outlined" style="font-size:1rem;animation:pdp-spin 0.6s linear infinite;" aria-hidden="true">refresh</span>';
      btn.disabled  = true;
      btn.setAttribute('aria-busy', 'true');

      try {
        /* Monta item da coleira a partir do form */
        const form = e.target;
        const coleiraId = form.querySelector('#pdp-variant-id')?.value;
        const coleiraQty = parseInt(form.querySelector('#pdp-qty')?.value || '1', 10);
        const coleiraProps = {};
        form.querySelectorAll('[name^="properties["]').forEach(el => {
          if (!el.value || !el.value.trim()) return;
          const key = el.name.replace(/^properties\[/, '').replace(/\]$/, '');
          coleiraProps[key] = el.value.trim();
        });
        const items = [{
          id: coleiraId,
          quantity: coleiraQty,
          ...(Object.keys(coleiraProps).length ? { properties: coleiraProps } : {})
        }];

        /* Adiciona pingente como item separado, se aplicável.
           Passa a quantidade da coleira pra manter 1 pingente por coleira. */
        if (window.amePingente?.isActive()) {
          const pingenteItem = window.amePingente.getCartItem(coleiraQty);
          if (pingenteItem) items.push(pingenteItem);
        }

        const res = await fetch('/cart/add.js', {
          method:  'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items })
        });

        if (!res.ok) throw new Error('cart/add failed');

        /* Busca carrinho atualizado e repassa ao drawer */
        const cartData = await (await fetch('/cart.js')).json();
        window.AmeCart?.refresh(cartData);
        window.AmeCart?.open();

        /* Feedback no botão */
        btn.innerHTML = 'Adicionado ✓';
        btn.removeAttribute('aria-busy');
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; }, 1800);

      } catch {
        btn.innerHTML = 'Tente novamente';
        btn.style.opacity = '0.7';
        btn.removeAttribute('aria-busy');
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; btn.style.opacity = ''; }, 2000);
      }
    });

    /* ── Acordeões ── */
    document.querySelectorAll('.ame-accordion__btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.ame-accordion__btn').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          b.nextElementSibling.setAttribute('hidden', '');
          b.nextElementSibling.style.maxHeight = '0';
        });
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          btn.nextElementSibling.removeAttribute('hidden');
          btn.nextElementSibling.style.maxHeight = '600px';
        }
      });
    });
  })();
</script>

<script>
  /* ── Imagem fixa no scroll mobile até o botão "Adicionar ao Carrinho" aparecer ── */
  (() => {
    // O wrapper sticky inclui imagem + barra "Você selecionou: ..." — vira fixed juntos
    const wrap = document.querySelector('.pdp__sticky-wrap');
    if (!wrap) return;

    // O CTA é re-buscado a cada update porque a Section Rendering API substitui o
    // nó do botão (#pdp-add-btn-wrap) ao trocar variante — referência cacheada vira órfã.
    const getCta = () => document.querySelector('.ame-cta.pdp__add-btn');

    const spacer = document.createElement('div');
    spacer.className = 'pdp__main-img-spacer';
    spacer.setAttribute('aria-hidden', 'true');
    wrap.after(spacer);

    const mq = window.matchMedia('(max-width: 1023px)');
    let pinned = false;
    let headerOffset = 0;

    function measureHeader() {
      const header = document.querySelector('.ame-header-group');
      headerOffset = header ? header.getBoundingClientRect().height : 0;
      wrap.style.setProperty('--pdp-pinned-top', headerOffset + 'px');
    }

    function pin() {
      if (pinned) return;
      spacer.style.height = wrap.offsetHeight + 'px';
      wrap.classList.add('is-pinned');
      pinned = true;
    }
    function unpin() {
      if (!pinned) return;
      wrap.classList.remove('is-pinned');
      wrap.style.transform = '';
      spacer.style.height = '';
      pinned = false;
    }

    function update() {
      if (!mq.matches) {
        unpin();
        return;
      }
      const cta = getCta();
      if (!cta) {
        unpin();
        return;
      }
      const ctaRect = cta.getBoundingClientRect();
      const refRect = pinned ? spacer.getBoundingClientRect() : wrap.getBoundingClientRect();
      const scrolledPastImage = refRect.top < headerOffset;

      if (!scrolledPastImage) {
        unpin();
        return;
      }

      pin();
      // Empurra a imagem pra cima quando o CTA se aproxima da base, evitando sobreposição
      const pinnedHeight = wrap.offsetHeight;
      const pinnedBottom = headerOffset + pinnedHeight;
      const overlap = pinnedBottom + 16 - ctaRect.top;
      if (overlap > 0) {
        const ty = Math.min(overlap, pinnedHeight + 16);
        wrap.style.transform = `translateY(-${ty}px)`;
      } else {
        wrap.style.transform = '';
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }

    function onResize() {
      measureHeader();
      if (pinned) spacer.style.height = wrap.offsetHeight + 'px';
      update();
    }

    measureHeader();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    if (mq.addEventListener) mq.addEventListener('change', onResize);
    // Re-avalia quando a variante muda (CTA/preço/badge são re-renderizados pelo Section Rendering API)
    document.addEventListener('pdp:variant-changed', () => requestAnimationFrame(update));

    if (document.readyState === 'complete') update();
    else window.addEventListener('load', update);
  })();
</script>

{% stylesheet %}
  .pdp__custom-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .pdp__custom-field__label {
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant, #4f4442);
    font-weight: 600;
  }

  .pdp__custom-field__req {
    color: var(--color-primary, #5a4742);
  }

  .pdp__custom-field__input,
  .pdp__custom-field__textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    border-radius: var(--radius-md, 4px);
    background: transparent;
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    transition: border-color 0.2s ease;
    outline: none;
  }

  .pdp__custom-field__input:focus,
  .pdp__custom-field__textarea:focus {
    border-color: var(--color-primary, #5a4742);
  }

  .pdp__custom-field__textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .pdp__custom-field__helper {
    font-size: 0.75rem;
    color: var(--color-on-surface-variant, #4f4442);
    opacity: 0.7;
    margin: 0;
  }

  .pdp__custom-field__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .pdp__custom-field__footer .pdp__custom-field__helper {
    flex: 1;
  }

  .pdp__custom-field__counter {
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.6875rem;
    color: var(--color-on-surface-variant, #4f4442);
    opacity: 0.55;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .pdp__custom-field__counter.is-near {
    opacity: 1;
    color: var(--color-primary, #5a4742);
  }
  .pdp__custom-field__counter.is-full {
    opacity: 1;
    color: #c0392b;
    font-weight: 600;
  }

  .pdp__custom-field__radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdp__custom-field__radio-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    border-radius: var(--radius-md, 4px);
    background: transparent;
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .pdp__custom-field__radio-btn:hover,
  .pdp__custom-field__radio-btn.is-selected {
    border-color: var(--color-primary, #5a4742);
    background: var(--color-surface-container, #f8ece0);
  }

  .pdp__custom-field__radio-btn.is-selected {
    font-weight: 600;
  }

  .pdp__custom-field__error-msg {
    font-size: 0.75rem;
    color: #c0392b;
    margin: 0;
    display: none;
  }

  .pdp__custom-field--error .pdp__custom-field__error-msg {
    display: block;
  }

  .pdp__custom-field--error .pdp__custom-field__label {
    color: #c0392b;
  }

  .pdp__custom-field--error .pdp__custom-field__input,
  .pdp__custom-field--error .pdp__custom-field__textarea {
    border-color: #c0392b;
  }

  .pdp__custom-field--error .pdp__custom-field__radio-btn {
    border-color: #c0392b;
  }

  /* ── Override: cor do botão selecionado e add-to-cart (configurável via painel) ── */
  .pdp .pdp__size-btn--active {
    background: var(--pdp-btn-bg, #000000);
    color: var(--pdp-btn-fg, #ffffff);
    border-color: var(--pdp-btn-bg, #000000);
  }

  .pdp .pdp__swatch--active {
    outline-color: var(--pdp-btn-bg, #000000);
  }

  .pdp .pdp__add-btn {
    background: var(--pdp-btn-bg, #000000);
    color: var(--pdp-btn-fg, #ffffff);
  }

  /* ── Largura flexível dos botões de variação ── */
  .pdp .pdp__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdp .pdp__size-btn {
    width: auto;
    padding: 0.625rem 1.125rem;
  }

  .pdp .pdp__size-btn.pdp__size-btn--metal {
    padding: 0.5rem 1rem;
  }

  .pdp__size-btn {
    border-radius: var(--radius-lg, 4px);
  }

  /* ── Pingente overlay sobre a imagem principal ── */
  .pdp__pingente-overlay {
    position: absolute;
    bottom: 6%;
    left: 35%;
    width: 30%;
    aspect-ratio: 1 / 1;
    z-index: 3;
    pointer-events: none;
    border-radius: 50%;
    overflow: hidden;
    /* filter: drop-shadow(0 6px 14px rgba(32, 27, 20, 0.28)); */
    opacity: 0;
    transform: translateY(6px) scale(0.9);
    transition: opacity 0.25s ease, transform 0.25s var(--ease-luxury, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .pdp__pingente-overlay[hidden] {
    display: none;
  }

  .pdp__pingente-overlay.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .pdp__pingente-overlay img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    /* transform: scale(1.6); */
    /*margin-top: 10px;*/
  }

  /* ── Resumo das variações escolhidas (abaixo da imagem, mobile) ── */
  .pdp__selection-info {
    padding: 0.625rem 1rem;
    background: var(--color-surface, #fff8f3);
    color: var(--color-on-background, #201b14);
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.67rem;
    line-height: 1.35;
    text-align: center;
    border-top: 1px solid rgba(210, 195, 192, 0.3);
    opacity: 0.8;
  }
  .pdp__selection-info[hidden] {
    display: none;
  }
  .pdp__selection-info__label {
    font-weight: 400;
    color: var(--color-on-surface-variant, #4f4442);
    margin-right: 0.25rem;
  }
  .pdp__selection-info__values {
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  /* Desktop não mostra (a coluna lateral já dá o feedback) */
  @media (min-width: 1024px) {
    .pdp__selection-info {
      display: none;
    }
  }

  /* Variante "over" — texto sobreposto no topo da imagem (libera espaço da tela) */
  .pdp__sticky-wrap--selection-over .pdp__main-img-wrap > .pdp__selection-info {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: 0.625rem 1rem 1.5rem;
    background: linear-gradient(to bottom, rgba(32, 27, 20, 0.7) 0%, rgba(32, 27, 20, 0.35) 60%, transparent 100%);
    color: #fff;
    border-top: none;
    pointer-events: none;
    opacity: 1;
  }
  .pdp__sticky-wrap--selection-over .pdp__main-img-wrap > .pdp__selection-info .pdp__selection-info__label {
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Validação: opções não selecionadas no clique do CTA ── */
  .pdp__option--invalid {
    border-radius: var(--radius-md, 4px);
    padding: 0.75rem;
    margin-left: -0.75rem;
    margin-right: -0.75rem;
    background: rgba(192, 57, 43, 0.06);
    box-shadow: inset 0 0 0 1px rgba(192, 57, 43, 0.55);
    animation: pdpOptionShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }
  .pdp__option--invalid .pdp__option-label {
    color: #c0392b;
  }
  @keyframes pdpOptionShake {
    10%,
    90% {
      transform: translateX(-2px);
    }
    20%,
    80% {
      transform: translateX(3px);
    }
    30%,
    50%,
    70% {
      transform: translateX(-5px);
    }
    40%,
    60% {
      transform: translateX(5px);
    }
  }

  /* ── Toast de erro de seleção ── */
  .pdp__toast {
    position: fixed;
    top: 5rem;
    left: 50%;
    transform: translate(-50%, -16px);
    z-index: 200;
    background: #201b14;
    color: #fff;
    font-family: var(--font-primary--family, 'Lexend', sans-serif);
    font-size: 0.875rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md, 4px);
    box-shadow: 0 12px 32px rgba(32, 27, 20, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    max-width: calc(100vw - 2rem);
    text-align: center;
  }
  .pdp__toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ── Imagem + barra de seleção ficam fixas no scroll mobile até o CTA aparecer ── */
  .pdp__main-img-spacer {
    width: 100%;
    display: none;
  }

  @media (max-width: 1023px) {
    .pdp__sticky-wrap.is-pinned {
      position: fixed;
      top: var(--pdp-pinned-top, 0px);
      left: 0;
      right: 0;
      width: 100%;
      margin: 0;
      /*padding: 0.625rem 0.75rem 0;*/
      padding: 0 0.75rem 0;
      z-index: 50;
      will-change: transform;
      background: var(--color-surface, #fff8f3);
      /*box-shadow: 0 8px 16px rgba(32, 27, 20, 0.08);*/
    }
    /* Imagem fica quadrada com borda lateral + sombra (efeito de flutuar) */
    .pdp__sticky-wrap.is-pinned .pdp__main-img-wrap {
      /*width: min(100%, 38vh);*/
      aspect-ratio: 1 / 1;
      height: auto;
      margin: 0 auto;
      border-radius: var(--radius-lg, 0.75rem);
      box-shadow: 0 10px 24px rgba(32, 27, 20, 0.18);
    }
    /* Pingente sobreposto reposicionado para acompanhar a imagem encolhida */
    .pdp__sticky-wrap.is-pinned .pdp__pingente-overlay {
      bottom: 5%;
      width: 30%;
    }
    .pdp__sticky-wrap.is-pinned + .pdp__main-img-spacer {
      display: block;
    }
  }
{% endstylesheet %}

