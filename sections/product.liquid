{% comment %}
    This section is used in the product template to render product page with
    media, content, and add-to-cart form.

    https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="mx-2 grid grid-cols-1 gap-2 lg:grid-cols-2">
    <aside>
        <div class="flex flex-col gap-3 lg:flex-row-reverse">

            {{- '<!-- Main viewer -->' }}
            <div class="flex-1 lg:flex lg:max-h-[100svh] lg:flex-col lg:gap-3 lg:overflow-y-auto" data-product-media>
                {% for media in product.media %}
                    {%- assign media_variant_ids = '' -%}
                    {%- for variant in product.variants -%}
                        {%- if variant.featured_media.id == media.id -%}
                            {%- if media_variant_ids == '' -%}
                                {%- assign media_variant_ids = variant.id | append: '' -%}
                            {%- else -%}
                                {%- assign media_variant_ids = media_variant_ids | append: ',' | append: variant.id -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                    <div
                        data-js="media-item"
                        data-media-id="{{ media.id }}"
                        {% if media_variant_ids != '' %}data-variant-media="{{ media_variant_ids }}"{% endif %}
                        {% unless forloop.first %}hidden{% endunless %}
                    >
                        {% case media.media_type %}
                            {% when 'image' %}
                                {% render 'product-media-image', media: media, class: 'w-full aspect-square object-cover' %}
                            {% when 'video', 'external_video' %}
                                {% render 'product-media-video', media: media, class: 'w-full aspect-square' %}
                            {% else %}
                                {% render 'image', image: media.preview_image, class: 'w-full aspect-square object-cover' %}
                        {% endcase %}
                    </div>
                {% else %}
                    {% render 'product-media-image', class: 'w-full aspect-square object-cover' %}
                {% endfor %}
            </div>

            {{- '<!-- Thumbnail strip -->' }}
            {% if product.media.size > 1 %}
                <div class="flex gap-2 overflow-x-auto lg:flex-col lg:w-16" data-product-thumbnails>
                    {% for media in product.media %}
                        {%- assign media_variant_ids = '' -%}
                        {%- for variant in product.variants -%}
                            {%- if variant.featured_media.id == media.id -%}
                                {%- if media_variant_ids == '' -%}
                                    {%- assign media_variant_ids = variant.id | append: '' -%}
                                {%- else -%}
                                    {%- assign media_variant_ids = media_variant_ids | append: ',' | append: variant.id -%}
                                {%- endif -%}
                            {%- endif -%}
                        {%- endfor -%}
                        <button
                            type="button"
                            data-js="thumbnail"
                            data-thumbnail="{{ media.id }}"
                            {% if media_variant_ids != '' %}data-variant-media="{{ media_variant_ids }}"{% endif %}
                            aria-pressed="{{ forloop.first }}"
                            class="w-16 h-16 shrink-0 overflow-hidden border"
                        >
                            {% render 'image', image: media.preview_image, widths: '64,128', class: 'w-full h-full object-cover' %}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </aside>

    <div>
        <div class="product-info">
            <h1>{{ product.title }}</h1>
            <p data-js="product-price">{{ current_variant.price | money }}</p>
            <p data-js="product-availability">
                {%- unless current_variant.available -%}Sold out{%- endunless -%}
            </p>
            <p>{{ product.description }}</p>
        </div>

        <div class="product-form">
            {% form 'product', product, id: 'product-form', data-js: 'product-form' %}
                {% render 'variant-picker', product: product, current_variant: current_variant %}

                <input type="number" name="quantity" min="1" value="1">

                <button
                    type="submit"
                    data-js="add-to-cart"
                    {% unless current_variant.available %}
                        disabled
                    {% endunless %}
                >
                    {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                </button>

                <p data-js="cart-status" role="status" aria-live="polite" class="mt-2 text-sm"></p>

                {{ form | payment_button }}
            {% endform %}
        </div>
    </div>
</div>

<div
  data-js="recommendations"
  data-product-id="{{ product.id }}"
  data-section-id="product-recommendations"
></div>

<script id="product-data" data-js="product-data" type="application/json">
    {{ product | json }}
</script>

<script id="variant-prices" data-js="variant-prices" type="application/json">
    {
        {% for variant in product.variants %}
            "{{ variant.id }}": "{{ variant.price | money }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
    }
</script>

{% schema %}
{
    "name": "t:general.product",
    "settings": [],
    "disabled_on": {
        "groups": ["header", "footer"]
    }
}
{% endschema %}
