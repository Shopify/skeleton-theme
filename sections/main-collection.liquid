<main class="collection-main space-main">
  <h1>{{ collection.title }}</h1>

  {% render 'filters' %}

  <div class="collection-products">
    {% paginate collection.products by 4 %}
      <div class="collection-products-grid">
        {% for product in collection.products %}
          <div class="collection-product">
            <a
              href="{{ product.url }}"
              class="link-reset"
              {% unless product.featured_image %}
                aria-label="View {{ product.title }}"
              {% endunless %}
            >
              {% if product.featured_image %}
                {% if forloop.first %}
                  {% assign fetchpriority = 'high' %}
                {% else %}
                  {% assign fetchpriority = 'auto' %}
                {% endif %}
                {% render 'image-collection', image: product.featured_image, fetchpriority: fetchpriority %}
              {% else %}
                <div class="collection-image-placeholder"></div>
              {% endif %}
            </a>
            <div class="collection-product-content">
              <h2 class="collection-product-title">
                <a href="{{ product.url }}" class="link-reset">{{ product.title | escape }}</a>
              </h2>
              <div>
                {% render 'price', product: product %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate %}
      {% endif %}
    {% endpaginate %}
  </div>
</main>

{% stylesheet %}
  .collection-products-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 576px) {
    .collection-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .collection-products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-product {
    display: grid;
    gap: 1rem;
  }

  .collection-image-placeholder {
    padding-top: 100%;
    background-color: var(--color-border);
  }

  .collection-product-content {
    display: grid;
    gap: 0.5rem;
  }

  .collection-product-title {
    font-size: 1.6rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
