<script defer src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% assign variant_images = product.images | where: 'attached_to_variant?', true %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign first_shown = false %}

<div class="product-main">
  <div class="product-main-images">
    <div class="product-gallery swiper">
      <div class="swiper-wrapper">
        {% if selected_variant.image != blank %}
          {% assign first_shown = true %}
          <div class="swiper-slide" data-variant-ids="{{ selected_variant.image.variants | map: 'id' | join: ',' }}">
            {% render 'image-pdp', image: selected_variant.image, preload: true %}
          </div>
        {% endif %}
        {% for image in variant_images %}
          {% unless image.id == selected_variant.image.id %}
            <div class="swiper-slide" data-variant-ids="{{ image.variants | map: 'id' | join: ',' }}">
              {% if first_shown %}
                {% assign loading = 'lazy' %}
              {% else %}
                {% assign loading = 'eager' %}
                {% assign first_shown = true %}
              {% endif %}
              {% render 'image-pdp', image: image, loading: loading %}
            </div>
          {% endunless %}
        {% endfor %}
        {% for media in product.media %}
          {% unless variant_images contains media %}
            {% if first_shown %}
              {% assign loading = 'lazy' %}
            {% else %}
              {% assign loading = 'eager' %}
              {% assign first_shown = true %}
            {% endif %}
            {% render 'media', media: media, loading: loading %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
    <div class="product-gallery-nav-wrap">
      <button
        type="button"
        class="product-gallery-nav-button product-gallery-nav-button-prev"
        aria-label="Previous thumbnail"
      >
        ←
      </button>
      <div class="product-gallery-nav swiper">
        <div class="swiper-wrapper">
          {% if selected_variant.image != blank %}
            <div class="swiper-slide" data-variant-ids="{{ selected_variant.image.variants | map: 'id' | join: ',' }}">
              {{
                selected_variant.image
                | image_url: width: 400, height: 400, crop: 'center'
                | image_tag: sizes: '100px', loading: 'eager'
              }}
            </div>
          {% endif %}
          {% for image in variant_images %}
            {% unless image.id == selected_variant.image.id %}
              <div class="swiper-slide" data-variant-ids="{{ image.variants | map: 'id' | join: ',' }}">
                <div class="product-image">
                  {{
                    image
                    | image_url: width: 400, height: 400, crop: 'center'
                    | image_tag: sizes: '100px', loading: 'eager'
                  }}
                </div>
              </div>
            {% endunless %}
          {% endfor %}
          {% for media in product.media %}
            {% unless variant_images contains media %}
              <div class="swiper-slide" data-variant-ids="">
                <div class="product-image">
                  {{
                    media.preview_image
                    | image_url: width: 400, height: 400, crop: 'center'
                    | image_tag: sizes: '100px', loading: 'eager'
                  }}
                </div>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
      <button
        type="button"
        class="product-gallery-nav-button product-gallery-nav-button-next"
        aria-label="Next thumbnail"
      >
        →
      </button>
    </div>
  </div>
  <div>
    <div class="product-main-info">
      <div class="product-form">
        {% form 'product', product %}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'title' -%}
                <h1>{{ product.title }}</h1>
              {%- when 'description' -%}
                <div class="product-description">{{ product.description }}</div>
              {%- when 'price' -%}
                {% render 'price' %}
              {%- when 'buy_button' -%}
                <div class="product-buy-button-wrap">
                  <button
                    type="submit"
                    value="{{ 'product.add_to_cart' | t }}"
                    class="product-buy-button button"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    {% if product.selected_or_first_available_variant.available == false %}
                      {{ 'product.sold_out' | t }}
                    {% else %}
                      {{ 'product.add_to_cart' | t }}
                    {% endif %}
                  </button>
                </div>
              {%- when 'quantity' -%}
                <input type="number" name="quantity" min="1" value="1">
              {%- when 'variant_selector' -%}
                {% render 'variant-selector', product: product %}
            {%- endcase -%}
          {%- endfor -%}

          <select name="id" class="product-variant-select hidden">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}
                  selected="selected"
                {% endif %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  @media (min-width: 768px) {
    .product-main {
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(2, 50%);
    }
  }

  .shopify-product-form {
    display: grid;
    gap: 1rem;
  }

  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .product-price-compare {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .product-gallery-video,
  .product-gallery-model {
    padding-top: 100%;
    position: relative;
  }

  .product-gallery-video video,
  .product-gallery-video iframe,
  .product-gallery-model model-viewer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .product-gallery-nav-wrap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    max-width: 100%;
    overflow: hidden;
  }

  .product-gallery-nav {
    min-width: 0;
    width: 100%;
    overflow: hidden;
  }

  .product-gallery-nav .swiper-slide {
    width: 10rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .product-gallery-nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #fff;
    color: #111;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
    z-index: 1;
  }

  .product-gallery-nav-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
{% endstylesheet %}

<script type="application/json" id="product-data">
  {
    "variants": {{ product.variants | json }},
    "moneyFormat": {{ shop.money_format | json }},
    "labels": {
      "addToCart": {{ 'product.add_to_cart' | t | json }},
      "soldOut": {{ 'product.sold_out' | t | json }}
    }
  }
</script>

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = new Swiper('.product-gallery', {
      slidesPerView: 1,
      allowTouchMove: true,
    });

    const galleryNav = new Swiper('.product-gallery-nav', {
      slidesPerView: 'auto',
      spaceBetween: 12,
      watchSlidesProgress: true,
      navigation: {
        nextEl: '.product-gallery-nav-button-next',
        prevEl: '.product-gallery-nav-button-prev',
      },
    });

    function pauseGalleryVideos() {
      document.querySelectorAll('.product-gallery .swiper-slide video').forEach((video) => {
        if (!video.paused) {
          video.pause();
        }
      });

      document.querySelectorAll('.product-gallery .swiper-slide iframe').forEach((frame) => {
        if (!frame.src) return;

        try {
          frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), '*');
          frame.contentWindow?.postMessage(JSON.stringify({ method: 'pause' }), '*');
        } catch (error) {
          // Ignore cross-origin iframe controls if the player does not expose a window.
        }
      });
    }

    gallery.on('slideChange', pauseGalleryVideos);

    Array.from(document.querySelectorAll('.product-gallery-nav .swiper-slide')).forEach((slide, index) => {
      slide.dataset.index = String(index);
    });

    const gallerySlides = Array.from(document.querySelectorAll('.product-gallery .swiper-slide'));
    const galleryNavSlides = Array.from(document.querySelectorAll('.product-gallery-nav .swiper-slide'));
    const galleryNavWrapper = document.querySelector('.product-gallery-nav .swiper-wrapper');

    galleryNavWrapper.addEventListener('click', (event) => {
      const slide = event.target.closest('.swiper-slide');
      if (!slide || !galleryNavWrapper.contains(slide)) return;

      const index = Number(slide.dataset.index);
      if (!Number.isNaN(index)) gallery.slideTo(index);
    });

    // Update price on variant change
    const productDataEl = document.getElementById('product-data');
    const productData = productDataEl
      ? JSON.parse(productDataEl.textContent)
      : { variants: [], moneyFormat: '$', labels: { addToCart: 'Add to cart', soldOut: 'Sold out' } };
    const productVariants = productData.variants || [];

    const variantSelect = document.querySelector('.product-form .product-variant-select');
    const priceCurrentEl = document.querySelector('.product-price-current');
    const priceCompareEl = document.querySelector('.product-price-compare');
    const moneyFormat = productData.moneyFormat || '$';

    function updateURLWithVariant(variantId) {
      if (!variantId) return;

      const url = new URL(window.location.href);
      url.searchParams.set('variant', String(variantId));
      window.history.replaceState({}, '', url);
    }

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }

      return '$' + (cents / 100).toFixed(2);
    }

    function matchesVariantOptions(variant, optionValues) {
      if (!variant || !variant.options || variant.options.length !== optionValues.length) {
        return false;
      }

      return optionValues.every((option, index) => option === null || variant.options[index] === option);
    }

    // Mark options as unavailable based on current selection
    function updateOptionAvailability() {
      const optionGroups = Array.from(document.querySelectorAll('.product-option-group'));

      if (!optionGroups.length) return;

      optionGroups.forEach((group, groupIndex) => {
        const optionInputs = Array.from(group.querySelectorAll('.product-option-input'));
        const currentSelection = optionGroups.map((optionGroup) => {
          const checkedInput = optionGroup.querySelector('.product-option-input:checked');
          return checkedInput ? checkedInput.value : null;
        });

        optionInputs.forEach((input) => {
          const candidateOptions = [...currentSelection];
          candidateOptions[groupIndex] = input.value;

          const hasAvailableVariant = productVariants.some((variant) => {
            return variant.available && matchesVariantOptions(variant, candidateOptions);
          });

          const isCurrentlySelected = input.checked;
          input.classList.toggle('disabled', !hasAvailableVariant && !isCurrentlySelected);
        });
      });
    }

    function updateBuyButtonState(selectedVariant) {
      const buyButton = document.querySelector('.product-buy-button');

      if (!buyButton) return;

      const isAvailable = !!selectedVariant && selectedVariant.available !== false;
      const label = isAvailable ? productData.labels.addToCart : productData.labels.soldOut;

      buyButton.disabled = !isAvailable;
      buyButton.setAttribute('aria-disabled', String(!isAvailable));
      buyButton.textContent = label;
    }

    function updatePriceDisplay(selectedVariant) {
      if (!priceCurrentEl) return;

      priceCurrentEl.textContent = formatMoney(selectedVariant.price);

      if (priceCompareEl) {
        const hasComparePrice = Number(selectedVariant.compare_at_price || 0) > Number(selectedVariant.price || 0);

        priceCompareEl.textContent = hasComparePrice ? formatMoney(selectedVariant.compare_at_price) : '';
        priceCompareEl.hidden = !hasComparePrice;
      }
    }

    function updateGalleryForVariant(selectedVariant) {
      const selectedVariantId = Number(selectedVariant.id);
      const matchingIndexes = gallerySlides.reduce((indexes, slide, index) => {
        const variantIds = slide.dataset.variantIds.split(',').map(Number);
        if (!slide.dataset.variantIds || variantIds.includes(selectedVariantId)) indexes.push(index);
        return indexes;
      }, []);
      const matchingGallerySlides = matchingIndexes.map((index) => gallerySlides[index]);
      const matchingGalleryNavSlides = matchingIndexes.map((index, activeIndex) => {
        const slide = galleryNavSlides[index];
        slide.dataset.index = String(activeIndex);
        return slide;
      });

      galleryNav.removeAllSlides();
      galleryNav.appendSlide(matchingGalleryNavSlides);
      gallery.removeAllSlides();
      gallery.appendSlide(matchingGallerySlides);
      galleryNav.slideTo(0, 0);
      gallery.slideTo(0, 0);
    }

    function updateVariantUI(syncUrl = true) {
      if (!variantSelect) return;

      const selectedVariant = productVariants.find((variant) => Number(variant.id) === Number(variantSelect.value));

      if (!selectedVariant) return;

      updateOptionAvailability();
      updateBuyButtonState(selectedVariant);
      updatePriceDisplay(selectedVariant);
      updateGalleryForVariant(selectedVariant);

      if (syncUrl) {
        updateURLWithVariant(selectedVariant.id);
      }
    }

    // Initialize variant selection based on URL parameter
    if (variantSelect) {
      const initialVariantId = new URLSearchParams(window.location.search).get('variant');
      const hasVariantInUrl = Boolean(
        initialVariantId && productVariants.some((variant) => String(variant.id) === initialVariantId)
      );

      if (hasVariantInUrl) {
        variantSelect.value = String(initialVariantId);
      }

      updateVariantUI(hasVariantInUrl);
      variantSelect.addEventListener('change', () => updateVariantUI(true));
    }

    // Update variant based on selected options
    function updateVariantFromOptions() {
      const selectedOptions = Array.from(document.querySelectorAll('.product-option-group'))
        .map((group) => {
          const checkedInput = group.querySelector('.product-option-input:checked');
          return checkedInput ? checkedInput.value : null;
        })
        .filter(Boolean);

      const matchingVariant = productVariants.find((variant) => {
        return (
          variant.options &&
          variant.options.length === selectedOptions.length &&
          variant.options.every((option, index) => option === selectedOptions[index])
        );
      });

      if (!matchingVariant) return;

      variantSelect.value = String(matchingVariant.id);
      updateURLWithVariant(matchingVariant.id);
      updateVariantUI(false);
    }

    document.querySelectorAll('.product-option-input').forEach((input) => {
      input.addEventListener('change', updateVariantFromOptions);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "t:general.title",
      "limit": 1
    },
    {
      "type": "description",
      "name": "t:general.description",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:general.price",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "t:general.quantity",
      "limit": 1
    },
    {
      "type": "buy_button",
      "name": "t:general.buy_button",
      "limit": 1
    },
    {
      "type": "variant_selector",
      "name": "t:general.variant_selector",
      "limit": 1
    }
  ]
}
{% endschema %}
