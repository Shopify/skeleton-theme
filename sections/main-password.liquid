<main class="password-main">
  <header class="password-header">
    <h1 class="password-title">
      {{ shop.name }}
    </h1>
    <div>
      <details class="password-modal-wrap">
        <summary class="password-summary">
          <span class="password-summary-content">
            {{ 'icon-lock.svg' | inline_asset_content }}
            <span>{{ 'password.enter' | t }}</span>
          </span>
        </summary>
        <div class="password-modal">
          <div class="password-modal-inner">
            <button type="button" class="password-modal-close button-reset">
              {{ 'icon-close.svg' | inline_asset_content }}
            </button>
            {% form 'storefront_password', class: 'password-modal-form' %}
              {% if form.errors %}
                {{ form.errors | default_errors }}
              {% endif %}

              <div class="password-modal-form-fields">
                <div
                  class="form-group password-errors"
                  data-password-errors="{% if form.errors %}true{% else %}false{% endif %}"
                >
                  <input
                    type="password"
                    name="password"
                    id="password-input"
                    class="form-group-input"
                    placeholder="{{ 'password.password' | t }}"
                  >

                  <label for="password-input" class="form-group-label">
                    {{ 'password.password' | t }}
                  </label>
                </div>

                <button type="submit" class="password-modal-submit button">
                  {{ 'password.submit' | t }}
                </button>
              </div>
            {% endform %}
          </div>
        </div>
      </details>
    </div>
  </header>

  <div class="password-content">
    <div class="password-content-inner">
      <h2 class="password-content-title">{{ 'password.title' | t }}</h2>

      <p>{{ section.settings.content }}</p>

      {% if shop.password_message != blank %}
        <p>{{ shop.password_message }}</p>
      {% endif %}
      <div class="password-subscribe">
        {% form 'customer', class: 'password-subscribe-form' %}
          {{ form.errors | default_errors }}

          <div>
            <input type="hidden" name="contact[tags]" value="newsletter">
          </div>

          <div class="email form-group">
            <input
              type="email"
              id="email"
              name="contact[email]"
              class="form-group-input"
              placeholder="{{ 'password.email' | t }}"
              required
            >
            <label for="email" class="form-group-label">{{ 'password.email' | t }}</label>
          </div>

          <div class="submit">
            <button type="submit" class="button-submit button-reset">
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="password-subscribe-success">{{ 'password.subscribe_success' | t }}</p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</main>

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const details = document.querySelector('.password-modal-wrap');
    const closeButton = document.querySelector('.password-modal-close');

    if (details && closeButton) {
      closeButton.addEventListener('click', () => {
        details.removeAttribute('open');
      });
    }

    const passwordErrors = document.querySelector('.password-errors').getAttribute('data-password-errors');
    if (passwordErrors === 'true') {
      details.setAttribute('open', 'open');
    }
  });
{% endjavascript %}

{% stylesheet %}
  .shopify-section:has(.password-main) {
    flex-grow: 1;
  }

  .password-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
  }

  @media (min-width: 576px) {
    .password-header {
      flex-direction: row;
    }
  }

  .passsword-title {
    margin: 0;
  }

  .password-summary {
    list-style: none;
    cursor: pointer;
  }

  .password-summary-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .password-content {
    min-height: 50rem;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .password-content-inner {
    display: grid;
    gap: 2rem;
    width: 35rem;
  }

  .password-content-title {
    margin: 0;
  }

  .password-subscribe {
    position: relative;
  }

  .password-subscribe-success {
    font-weight: bold;
    margin-top: 2rem;
  }

  .password-subscribe .button-submit {
    position: absolute;
    right: 1rem;
    top: 1rem;
    width: 2.2rem;
    height: 2.2rem;
  }

  .password-modal {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .password-modal-inner {
    min-width: 35rem;
  }

  .password-modal-form-fields {
    display: flex;
    gap: 1rem;
  }

  .password-modal-form .form-group {
    flex-grow: 1;
  }

  .password-modal-close {
    width: 2.5rem;
    position: absolute;
    top: 3rem;
    right: 3rem;
  }

  .password-modal-submit {
    width: 10rem;
  }

  .password-modal .errors ul {
    margin: 0 0 2rem;
    padding: 0 0 0 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "text",
      "id": "content",
      "label": "t:labels.password_content",
      "default": "Be the first to know when we launch."
    }
  ]
}
{% endschema %}
