{%- liquid
  if template == 'index'
    assign head_tag = 'h1'
  else
    assign head_tag = 'h2'
  endif
-%}

<header class="site-header">
  <{{ head_tag }}>
    {{ shop.name | link_to: routes.root_url }}
  </{{ head_tag }}>

  <nav class="site-nav" aria-label="Main navigation" aria-hidden="false">
    <ul class="site-nav-menu list-reset">
      {% for link in section.settings.menu.links %}
        <li>{{ link.title | link_to: link.url }}</li>
      {% endfor %}
    </ul>
  </nav>

  <div class="site-header-icons">
    <button
      class="site-nav-toggle button-reset"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Toggle navigation"
    >
      {{ 'icon-menu.svg' | inline_asset_content }}
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="cart-toggle">
      <sup class="cart-item-count {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</sup>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

<script>
  // Mobile menu toggle
  const navToggle = document.querySelector('.site-nav-toggle');
  const navMenu = document.querySelector('.site-nav');
  const mobileQuery = window.matchMedia('(max-width: 768px)');

  function updateMenuAccessibility() {
    const isOpen = navMenu.classList.contains('open');

    if (!mobileQuery.matches) {
      navMenu.setAttribute('aria-hidden', 'false');
      navToggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
      navMenu.classList.remove('anim-ready');
      return;
    }

    navMenu.setAttribute('aria-hidden', String(!isOpen));
    navToggle?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('overflow-hidden', isOpen);
    navMenu.classList.add('anim-ready');
  }

  if (navToggle && navMenu) {
    updateMenuAccessibility();

    navToggle.addEventListener('click', function () {
      const isOpen = navMenu.classList.toggle('open');
      updateMenuAccessibility();
      document.body.classList.toggle('overflow-hidden', isOpen && mobileQuery.matches);
    });

    window.addEventListener('resize', updateMenuAccessibility);
  }
</script>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
