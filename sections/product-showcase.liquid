{% comment %}
  Colour-panel product showcase: one tab and tinted panel per product. See
  snippets/product-showcase.liquid.
{% endcomment %}

{{ 'showcase.css' | asset_url | stylesheet_tag }}

<section class="block-container">
  {% render 'product-showcase',
    collection: section.settings.collection,
    limit: section.settings.limit,
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading
  %}
</section>

{% schema %}
{
  "name": "t:sections.product-showcase.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product-showcase.settings.eyebrow",
      "default": "The formulas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product-showcase.settings.heading",
      "default": "Find the one your skin is asking for."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.product-showcase.settings.collection",
      "info": "t:sections.product-showcase.settings.collection_info"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.product-showcase.settings.limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-showcase.name"
    }
  ],
  "tag": "div"
}
{% endschema %}
