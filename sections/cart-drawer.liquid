<div
  id="cart-drawer"
  data-js="cart-drawer"
  data-cart-url="{{ routes.cart_url }}"
  data-currency="{{ cart.currency.iso_code }}"
  class="fixed inset-0 z-50"
  hidden
  aria-hidden="true"
>
  <div data-js="cart-drawer-overlay" class="absolute inset-0 bg-black/40" aria-hidden="true"></div>

  <aside
    data-js="cart-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.title' | t }}"
    class="absolute right-0 top-0 h-full w-full max-w-md bg-white p-4 shadow-2xl"
  >
    <div class="flex items-center justify-between border-b pb-3">
      <h2 class="text-lg font-semibold">{{ 'cart.title' | t }}</h2>
      <button type="button" data-js="cart-close" class="h-9 w-9 border" aria-label="Close cart drawer">x</button>
    </div>

    <p data-js="cart-drawer-status" role="status" aria-live="polite" class="sr-only"></p>
    <p data-js="cart-drawer-error" role="alert" class="mt-1 min-h-5 text-sm text-red-700"></p>

    <ul data-js="cart-items" class="mt-3 max-h-[calc(100vh-240px)] overflow-y-auto" {% if cart.item_count == 0 %}hidden{% endif %}>
      {% for item in cart.items %}
        <li class="relative grid grid-cols-[64px_1fr] gap-3 border-b py-3" data-line="{{ forloop.index }}">
          <div data-js="cart-drawer-line-overlay" class="pointer-events-none absolute inset-0 z-10 hidden items-center justify-center bg-white/60">
            <span class="h-5 w-5 rounded-full border-2 border-black/20 border-t-black animate-spin" aria-hidden="true"></span>
          </div>

          {% if item.image %}
            <a href="{{ item.url }}" class="block h-16 w-16 overflow-hidden border">
              {% render 'image', image: item.image, width: 128, class: 'h-full w-full object-cover' %}
            </a>
          {% endif %}

          <div class="space-y-2">
            <a href="{{ item.url }}" class="block text-sm font-medium">{{ item.product.title }}</a>
            {% if item.variant.title != 'Default Title' %}
              <p class="text-xs opacity-70">{{ item.variant.title }}</p>
            {% endif %}

            <div class="flex items-center gap-2">
              <button type="button" data-js="cart-qty-dec" data-line="{{ forloop.index }}" aria-label="Decrease quantity" class="h-8 w-8 border">-</button>
              <span class="min-w-6 text-center text-sm" data-js="cart-qty-value">{{ item.quantity }}</span>
              <button type="button" data-js="cart-qty-inc" data-line="{{ forloop.index }}" aria-label="Increase quantity" class="h-8 w-8 border">+</button>
              <button type="button" data-js="cart-remove" data-line="{{ forloop.index }}" class="ml-auto text-sm underline">{{ 'cart.remove' | t }}</button>
            </div>
            <p class="text-sm">{{ item.final_line_price | money }}</p>
          </div>
        </li>
      {% endfor %}
    </ul>

    <div data-js="cart-empty" class="mt-4 text-sm" {% if cart.item_count > 0 %}hidden{% endif %}>
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="mt-2 inline-block underline">{{ 'cart.continue_shopping' | t }}</a>
    </div>

    <div data-js="cart-drawer-footer" class="absolute bottom-0 left-0 right-0 border-t bg-white p-4">
      <div class="mb-3 flex items-center justify-between">
        <p class="text-sm">{{ 'cart.subtotal' | t }}</p>
        <p data-js="cart-subtotal" class="text-sm font-semibold">{{ cart.total_price | money }}</p>
      </div>
      <a href="{{ routes.cart_url }}" class="block w-full border px-3 py-2 text-center">{{ 'cart.view_cart' | t }}</a>
      <form action="{{ routes.cart_url }}" method="post" class="mt-2">
        <button type="submit" name="checkout" class="w-full border px-3 py-2">{{ 'cart.checkout' | t }}</button>
      </form>
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
