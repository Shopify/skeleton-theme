<main class="collections-main">
  <h1>{{ 'collections.title' | t }}</h1>

  <div
    class="collections"
  >
    {% for collection in collections %}
      <a class="collections-card link-reset" href="{{ collection.url }}">
        {% if collection.featured_image %}
          {% render 'image-collection', image: collection.featured_image, class: 'collections-card-image' %}
        {% else %}
          <div class="collections-card-placeholder"></div>
        {% endif %}

        <div class="collections-card-content">
          <h2>{{ collection.title }}</h2>

          {% if collection.description %}
            <p>{{ collection.description | strip_html | truncatewords: 15 }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</main>

{% stylesheet %}
  .collections {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 576px) {
    .collections {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .collections {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collections-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1rem;
  }

  .collections-card-placeholder {
    padding-top: 100%;
    background-color: var(--color-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": []
}
{% endschema %}
