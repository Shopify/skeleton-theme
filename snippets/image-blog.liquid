{% liquid
  assign margins = settings.min_page_margin | times: 2
  assign grid_space = 5 | plus: margins
%}

{% assign sizes = '(min-width: '
  | append: settings.max_page_width
  | append: ') calc(('
  | append: settings.max_page_width
  | append: ' - '
  | append: grid_space
  | append: 'px) / 2), '
  | append: '(min-width: 576px) calc((100vw - '
  | append: grid_space
  | append: 'px) / 2), '
  | append: 'calc(100vw - '
  | append: margins
  | append: 'px)'
%}

<a class="blog-article-image" href="{{ product.url }}">
  {{ image | image_url: width: 1500, height: 1500, crop: 'center' | image_tag: sizes: sizes }}
</a>
