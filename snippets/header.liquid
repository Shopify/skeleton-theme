{% doc %}
  Renders the storefront header: brand logo, main menu, search, customer
  account entry, and bag link. Rendered from layout/theme.liquid so it wraps
  every page; menus come from Theme settings > Header. On small screens the menu collapses into a
  <details> drawer that needs no JavaScript.

  @example
  {% render 'header' %}
{% enddoc %}

<header class="site-header">
  <details class="site-header__drawer" scroll-lock>
    <summary class="site-header__menu-toggle" aria-label="{{ 'header.menu' | t }}">
      <span class="hamburger" aria-hidden="true"></span>
    </summary>
    <nav class="site-header__drawer-nav" aria-label="{{ 'header.menu' | t }}">
      <ul>
        {% for link in settings.header_menu.links %}
          <li>
            <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {% endfor %}
        <li><a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a></li>
        {% if shop.customer_accounts_enabled %}
          <li><a href="{{ routes.account_url }}">{{ 'header.account' | t }}</a></li>
        {% endif %}
      </ul>
    </nav>
  </details>

  <a class="site-header__logo" href="{{ routes.root_url }}">
    {%- if settings.logo -%}
      {{
        settings.logo
        | image_url: height: 160
        | image_tag: alt: shop.name, loading: 'eager', fetchpriority: 'high', class: 'site-header__logo-image'
      }}
    {%- else -%}
      <span class="site-header__wordmark">{{ shop.name }}</span>
    {%- endif -%}
  </a>

  <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
    <ul>
      {% for link in settings.header_menu.links %}
        <li>
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  <div class="site-header__icons">
    <details class="header-search" data-predictive-search data-search-url="{{ routes.search_url }}">
      <summary class="site-header__icon" aria-label="{{ 'header.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </summary>
      <div class="header-search__panel">
        <form class="header-search__form" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <label class="visually-hidden" for="HeaderSearchInput">{{ 'search.placeholder' | t }}</label>
          <input
            id="HeaderSearchInput"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            aria-controls="HeaderSearchResults"
          >
          <button type="submit" class="button">{{ 'search.submit' | t }}</button>
        </form>
        <div id="HeaderSearchResults" class="header-search__results" data-predictive-results aria-live="polite"></div>
      </div>
    </details>

    {% if shop.customer_accounts_enabled %}
      <shopify-account class="site-header__icon" menu="{{ settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a class="site-header__bag" href="{{ routes.cart_url }}" data-cart-drawer-open>
      <span class="site-header__bag-icon">{{ 'icon-bag.svg' | inline_asset_content }}</span>
      <span class="site-header__bag-label">{{ 'header.bag' | t }}</span>
      <span class="site-header__bag-count" data-cart-count-label>{{ cart.item_count }}</span>
    </a>
  </div>
</header>
