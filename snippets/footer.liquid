{% doc %}
  Renders the storefront footer: newsletter sign-up, two menu columns,
  the stacked brand logo, payment icons, and the copyright line. Rendered
  from layout/theme.liquid so it appears on every page; menus and payment
  icons come from Theme settings > Footer.

  @example
  {% render 'footer' %}
{% enddoc %}

<footer class="site-footer full-width">
  <div class="site-footer__inner">
    <div class="site-footer__newsletter">
      <h2 class="site-footer__heading">{{ 'footer.newsletter_title' | t }}</h2>
      <p>{{ 'footer.newsletter_body' | t }}</p>

      {% form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <p class="form-message" role="status">{{ 'footer.newsletter_success' | t }}</p>
        {% else %}
          {% if form.errors %}
            <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {% endif %}
          <div class="newsletter-form__field">
            <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter_email' | t }}</label>
            <input
              id="FooterNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'footer.newsletter_email' | t }}"
              required
            >
            <button type="submit" class="button">{{ 'footer.newsletter_submit' | t }}</button>
          </div>
        {% endif %}
      {% endform %}
    </div>

    {% for menu in (1..2) %}
      {%- liquid
        if forloop.first
          assign footer_menu = settings.footer_menu
        else
          assign footer_menu = settings.footer_menu_secondary
        endif
      -%}
      {% if footer_menu.links.size > 0 %}
        <nav class="site-footer__menu" aria-label="{{ footer_menu.title | escape }}">
          <h2 class="site-footer__menu-title">{{ footer_menu.title }}</h2>
          <ul>
            {% for link in footer_menu.links %}
              <li>{{ link.title | link_to: link.url }}</li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    {% endfor %}

    <div class="site-footer__brand">
      {%- if settings.logo_stacked -%}
        {{ settings.logo_stacked | image_url: width: 480 | image_tag: alt: shop.name, loading: 'lazy', class: 'site-footer__logo' }}
      {%- endif -%}
      <p class="site-footer__origin">{{ 'footer.origin' | t }}</p>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}
    </p>

    {% if settings.show_payment_icons %}
      <ul class="site-footer__payment" aria-label="{{ 'footer.payment_methods' | t }}">
        {% for type in shop.enabled_payment_types %}
          <li>{{ type | payment_type_svg_tag }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</footer>
