<nav class="pagination link-reset">
  {{ paginate | default_pagination }}
</nav>

{% stylesheet %}
  .pagination {
    display: flex;
    justify-content: center;
    margin: 5rem 0;
    gap: 2rem;

    font-size: 1.8rem;
  }

  @media (min-width: 768px) {
    .pagination {
      margin: 10rem 0;
    }
  }

  .pagination .current {
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
{% endstylesheet %}
