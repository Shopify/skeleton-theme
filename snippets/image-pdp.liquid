{% liquid
  assign margins = settings.min_page_margin | times: 2
  assign grid_space = 5 | plus: margins
%}

{% assign sizes = '(min-width: '
  | append: settings.max_page_width
  | append: ') calc(('
  | append: settings.max_page_width
  | append: ' - '
  | append: grid_space
  | append: 'px) / 2), '
  | append: '(min-width: 768px) calc((100vw - '
  | append: grid_space
  | append: 'px) / 2), '
  | append: 'calc(100vw - '
  | append: margins
  | append: 'px)'
%}

<div class="product-image">
  {{
    image
    | image_url: width: 1800, height: 1800, crop: 'center'
    | image_tag: sizes: sizes, preload: preload, loading: loading, alt: image.alt
    | default: product.title
  }}
</div>
