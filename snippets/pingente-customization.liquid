{% comment %}
  Âme — Customização de Pingente
  Ativado em produtos com a tag 'customizacao_pingente'.
  Progressive disclosure: Sim/Não → Tipo → Formato → Dados do pet/tutor.
  No submit, o produto pingente correspondente é adicionado ao carrinho
  junto da coleira como um item separado.
{% endcomment %}

{%- if product.tags contains 'customizacao_pingente' -%}
  {%- liquid
    capture pingente_metal_handle
      if settings.pingente_metal_product != blank
        echo settings.pingente_metal_product.handle
      endif
    endcapture

    capture pingente_couro_handles
      for p in settings.pingente_couro_products
        echo p.handle
        unless forloop.last
          echo ','
        endunless
      endfor
    endcapture

    capture pingente_metal_couro_handles
      for p in settings.pingente_metal_couro_products
        echo p.handle
        unless forloop.last
          echo ','
        endunless
      endfor
    endcapture
  -%}
  <section
    class="ame-pingente"
    data-pingente
    data-coleira-title="{{ product.title | escape }}"
    data-optin-template="{{ settings.pingente_optin_message | default: '' | escape }}"
    data-metal-handle="{{ pingente_metal_handle | strip }}"
    data-couro-handles="{{ pingente_couro_handles | strip }}"
    data-metal-couro-handles="{{ pingente_metal_couro_handles | strip }}"
    data-size-map="{{ settings.pingente_size_map | default: '' | escape }}"
  >
    <header class="ame-pingente__header">
      <p class="ame-pingente__eyebrow">Personalização</p>
      <h3 class="ame-pingente__title">Pingente de identificação</h3>
    </header>

    <!-- Passo 1: Sim / Não -->
    <div class="ame-pingente__step" data-pingente-step="1">
      {%- if settings.pingente_optin_message != blank -%}
        <p class="ame-pingente__optin-msg" data-pingente-optin-msg>
          {{- settings.pingente_optin_message -}}
        </p>
      {%- endif -%}
      <p class="ame-pingente__step-label">Deseja adicionar um pingente personalizado?</p>
      <div class="ame-pingente__opt-row">
        <label class="ame-pingente__opt">
          <input type="radio" name="ame-pingente-opt" value="sim" data-pingente-opt>
          <span>Sim</span>
        </label>
        <label class="ame-pingente__opt">
          <input type="radio" name="ame-pingente-opt" value="nao" data-pingente-opt checked>
          <span>Não</span>
        </label>
      </div>
    </div>

    <!-- Passo 2: Tipo -->
    <div class="ame-pingente__step" data-pingente-step="2" hidden>
      <p class="ame-pingente__step-label">Tipo do pingente</p>
      <div class="ame-pingente__tipo-grid">
        <label class="ame-pingente__tipo-card" data-pingente-tipo-card="metal">
          <input type="radio" name="ame-pingente-tipo" value="metal" data-pingente-tipo>
          <div class="ame-pingente__tipo-thumb" data-tipo-thumb>
            <span class="ame-pingente__tipo-placeholder" aria-hidden="true">
              <span class="material-symbols-outlined">image</span>
            </span>
          </div>
          <span class="ame-pingente__tipo-name">Metal</span>
          <span class="ame-pingente__tipo-price" data-tipo-price></span>
        </label>
        <label class="ame-pingente__tipo-card" data-pingente-tipo-card="couro">
          <input type="radio" name="ame-pingente-tipo" value="couro" data-pingente-tipo>
          <div class="ame-pingente__tipo-thumb" data-tipo-thumb>
            <span class="ame-pingente__tipo-placeholder" aria-hidden="true">
              <span class="material-symbols-outlined">image</span>
            </span>
          </div>
          <span class="ame-pingente__tipo-name">Couro</span>
          <span class="ame-pingente__tipo-price" data-tipo-price></span>
        </label>
        <label class="ame-pingente__tipo-card" data-pingente-tipo-card="metal-couro">
          <input type="radio" name="ame-pingente-tipo" value="metal-couro" data-pingente-tipo>
          <div class="ame-pingente__tipo-thumb" data-tipo-thumb>
            <span class="ame-pingente__tipo-placeholder" aria-hidden="true">
              <span class="material-symbols-outlined">image</span>
            </span>
          </div>
          <span class="ame-pingente__tipo-name">Metal com Couro</span>
          <span class="ame-pingente__tipo-price" data-tipo-price></span>
        </label>
      </div>
      <p class="ame-pingente__status" data-pingente-status></p>
    </div>

    <!-- Passo 3: Formato -->
    <div class="ame-pingente__step" data-pingente-step="3" hidden>
      <p class="ame-pingente__step-label">Formato do pingente</p>
      <div class="ame-pingente__formato-grid" data-pingente-formato-grid></div>
      {%- if settings.pingente_warning_text != blank -%}
        <p class="ame-pingente__warning">
          <span class="material-symbols-outlined" aria-hidden="true">info</span>
          <span>{{ settings.pingente_warning_text }}</span>
        </p>
      {%- endif -%}
    </div>

    <!-- Passo 4: Dados -->
    <div class="ame-pingente__step" data-pingente-step="4" hidden>
      <p class="ame-pingente__step-label">Informações para gravação</p>

      <div class="ame-pingente__field">
        <label for="ame-pingente-pet">
          Nome do pet <span class="ame-pingente__req" aria-hidden="true">*</span>
          <span class="ame-pingente-aviso">frente do pingente</span>
        </label>
        <div class="ame-pingente__input-wrap">
          <input
            type="text"
            id="ame-pingente-pet"
            data-pingente-pet
            placeholder="Ex: Marley"
            maxlength="20"
            autocomplete="off"
            required
          >
          <span class="ame-pingente__counter" data-pingente-counter data-max="13" aria-live="polite">0 / 13</span>
        </div>
        <p class="ame-pingente__error" data-pingente-error-pet>Informe o nome do pet.</p>
      </div>

      <div class="ame-pingente__field">
        <label for="ame-pingente-tutor"
          >Nome do tutor <span class="ame-pingente-aviso">verso do pingente 1ª linha</span></label
        >
        <div class="ame-pingente__input-wrap">
          <input
            type="text"
            id="ame-pingente-tutor"
            data-pingente-tutor
            placeholder="Ex: Maria Silva"
            maxlength="13"
            autocomplete="off"
          >
          <span class="ame-pingente__counter" data-pingente-counter data-max="13" aria-live="polite">0 / 13</span>
        </div>
      </div>

      <div class="ame-pingente__field">
        <label for="ame-pingente-tel"
          >Telefone do tutor <span class="ame-pingente-aviso">verso do pingente 2ª linha</span></label
        >
        <input
          type="tel"
          id="ame-pingente-tel"
          data-pingente-tel
          placeholder="11 99999-9999"
          maxlength="13"
          autocomplete="off"
          inputmode="numeric"
        >
      </div>
    </div>
  </section>

  <style>
    .ame-pingente {
      margin: 1.25rem 0 1.5rem;
      padding: 1.25rem 1.25rem 1rem;
      border: 1px solid rgba(210, 195, 192, 0.3);
      border-radius: var(--radius-lg, 0.5rem);
      /*background: linear-gradient(180deg, var(--color-surface-container, #f8ece0) 0%, transparent 100%);*/
    }

    .ame-pingente__header {
      margin-bottom: 1rem;
    }
    .ame-pingente__eyebrow {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.625rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(90, 71, 66, 0.55);
      margin: 0 0 0.375rem;
    }
    .ame-pingente__title {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--color-on-background, #201b14);
      margin: 0;
    }

    .ame-pingente__optin-msg {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.8125rem;
      line-height: 1.45;
      color: var(--color-on-surface-variant, #4f4442);
      margin: 0 0 0.875rem;
      padding: 0.625rem 0.75rem;
      background: rgba(90, 71, 66, 0.05);
      border-left: 2px solid var(--color-primary, #5a4742);
      border-radius: 0 var(--radius-sm, 2px) var(--radius-sm, 2px) 0;
    }
    .ame-pingente__optin-msg strong {
      color: var(--color-on-background, #201b14);
      font-weight: 600;
    }

    .ame-pingente__step + .ame-pingente__step {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(210, 195, 192, 0.25);
    }
    .ame-pingente__step[hidden] {
      display: none;
    }

    .ame-pingente__step-label {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-on-surface-variant, #4f4442);
      margin: 0 0 0.75rem;
    }

    /* Passo 1 — Sim / Não */
    .ame-pingente__opt-row {
      display: flex;
      gap: 0.5rem;
    }
    .ame-pingente__opt {
      flex: 1;
      cursor: pointer;
      position: relative;
    }
    .ame-pingente__opt input {
      position: absolute;
      opacity: 0;
      inset: 0;
    }
    .ame-pingente__opt span {
      display: block;
      padding: 0.75rem 1rem;
      text-align: center;
      background: transparent;
      border: 1px solid var(--color-outline-variant, #d2c3c0);
      border-radius: var(--radius-md, 4px);
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.8125rem;
      color: var(--color-on-surface-variant, #4f4442);
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .ame-pingente__opt input:checked + span {
      border-color: var(--color-primary, #5a4742);
      background: rgba(90, 71, 66, 0.06);
      color: var(--color-primary, #5a4742);
      font-weight: 500;
    }
    .ame-pingente__opt:hover span {
      border-color: var(--color-primary, #5a4742);
    }

    /* Passo 2 — Tipo */
    .ame-pingente__tipo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
    }
    @media (max-width: 480px) {
      .ame-pingente__tipo-grid {
        gap: 0.5rem;
      }
    }
    .ame-pingente__tipo-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      padding: 0.75rem 0.5rem;
      border: 1px solid var(--color-outline-variant, #d2c3c0);
      border-radius: var(--radius-lg, 4px);
      cursor: pointer;
      background: rgba(255, 255, 255, 0.4);
      transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }
    .ame-pingente__tipo-card:hover {
      border-color: var(--color-primary, #5a4742);
      transform: translateY(-1px);
    }
    .ame-pingente__tipo-card input {
      position: absolute;
      opacity: 0;
      inset: 0;
    }
    .ame-pingente__tipo-card:has(input:checked) {
      border-color: var(--color-primary, #5a4742);
      background: rgba(90, 71, 66, 0.06);
    }
    .ame-pingente__tipo-card.is-unavailable {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .ame-pingente__tipo-card.is-unavailable:hover {
      transform: none;
      border-color: var(--color-outline-variant, #d2c3c0);
      background: rgba(255, 255, 255, 0.4);
    }

    .ame-pingente__tipo-thumb {
      width: clamp(72px, 70%, 110px);
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-sm, 2px);
      background: var(--color-surface-container-highest, #ece1d5);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }
    .ame-pingente__tipo-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .ame-pingente__tipo-placeholder {
      color: rgba(90, 71, 66, 0.3);
    }
    .ame-pingente__tipo-placeholder .material-symbols-outlined {
      font-size: 1.5rem !important;
      font-variation-settings: 'wght' 200;
    }

    .ame-pingente__tipo-name {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.75rem;
      font-weight: 500;
      text-align: center;
      line-height: 1.2;
      color: var(--color-on-background, #201b14);
    }
    .ame-pingente__tipo-price {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.6875rem;
      color: var(--color-primary, #5a4742);
      font-weight: 600;
      min-height: 0.875rem;
    }
    .ame-pingente__tipo-price:empty {
      display: none;
    }

    /* Passo 3 — Formato */
    .ame-pingente__formato-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }
    @media (max-width: 480px) {
      .ame-pingente__formato-grid {
        gap: 0.375rem;
      }
    }
    .ame-pingente__formato-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem 0.375rem;
      border: 1px solid var(--color-outline-variant, #d2c3c0);
      border-radius: var(--radius-lg, 4px);
      cursor: pointer;
      background: rgba(255, 255, 255, 0.4);
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .ame-pingente__formato-card:hover {
      border-color: var(--color-primary, #5a4742);
    }
    .ame-pingente__formato-card input {
      position: absolute;
      opacity: 0;
      inset: 0;
    }
    .ame-pingente__formato-card:has(input:checked) {
      border-color: var(--color-primary, #5a4742);
      background: rgba(90, 71, 66, 0.08);
    }
    .ame-pingente__formato-card.is-unavailable {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .ame-pingente__formato-card.is-unavailable::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: linear-gradient(
        to top right,
        transparent calc(50% - 0.5px),
        rgba(90, 71, 66, 0.4) calc(50% - 0.5px),
        rgba(90, 71, 66, 0.4) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)
      );
      pointer-events: none;
    }

    .ame-pingente__formato-thumb {
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }
    .ame-pingente__formato-emoji {
      font-size: clamp(10px, 1.35rem, 1.6rem)
      line-height: 1;
      font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', 'Segoe UI Symbol', sans-serif;
    }
    @media (max-width: 480px) {
      .ame-pingente__formato-card {
        padding: 0.5rem 0.25rem;
      }
      .ame-pingente__formato-emoji {
        font-size: 1.5rem;
      }
    }
    .ame-pingente__formato-name {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--color-on-background, #201b14);
    }

    .ame-pingente__warning {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin: 0.875rem 0 0;
      padding: 0.625rem 0.75rem;
      background: rgba(90, 71, 66, 0.06);
      border-left: 2px solid var(--color-primary, #5a4742);
      border-radius: 0 var(--radius-sm, 2px) var(--radius-sm, 2px) 0;
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.75rem;
      line-height: 1.5;
      color: var(--color-on-surface-variant, #4f4442);
    }
    .ame-pingente__warning .material-symbols-outlined {
      font-size: 1rem !important;
      color: var(--color-primary, #5a4742);
      flex-shrink: 0;
      margin-top: 0.1rem;
    }

    /* Passo 4 — Campos */
    .ame-pingente__field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      margin-bottom: 0.875rem;
    }
    .ame-pingente__field:last-child {
      margin-bottom: 0;
    }
    .ame-pingente__field label {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-on-surface-variant, #4f4442);
      font-weight: 600;
    }
    .ame-pingente__req {
      color: var(--color-primary, #5a4742);
      margin-left: 0.1rem;
    }
    .ame-pingente__field input,
    .ame-pingente__field textarea {
      width: 100%;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--color-outline-variant, #d2c3c0);
      border-radius: var(--radius-md, 4px);
      background: rgba(255, 255, 255, 0.6);
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.875rem;
      color: var(--color-on-background, #201b14);
      outline: none;
      transition: border-color 0.2s ease, background 0.2s ease;
      box-sizing: border-box;
    }
    .ame-pingente__field input:focus,
    .ame-pingente__field textarea:focus {
      border-color: var(--color-primary, #5a4742);
      background: #fff;
    }
    .ame-pingente__field textarea {
      resize: vertical;
      min-height: 3.75rem;
    }

    .ame-pingente__error {
      display: none;
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.6875rem;
      color: #c0392b;
      margin: 0;
    }
    .ame-pingente__field.is-invalid .ame-pingente__error {
      display: block;
    }
    .ame-pingente__field.is-invalid input,
    .ame-pingente__field.is-invalid textarea {
      border-color: #c0392b;
    }

    /* Flash visual quando o cliente tenta adicionar ao carrinho sem completar */
    .ame-pingente__step.is-invalid {
      animation: amePingenteShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97);
    }
    .ame-pingente__step.is-invalid .ame-pingente__step-label {
      color: #c0392b;
    }
    @keyframes amePingenteShake {
      10%, 90% { transform: translateX(-2px); }
      20%, 80% { transform: translateX(3px); }
      30%, 50%, 70% { transform: translateX(-5px); }
      40%, 60% { transform: translateX(5px); }
    }

    .ame-pingente__input-wrap {
      position: relative;
    }
    .ame-pingente__input-wrap input {
      padding-right: 3.5rem; /* reserva espaço pro contador */
    }
    .ame-pingente__counter {
      position: absolute;
      right: 0.875rem;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.6875rem;
      color: var(--color-on-surface-variant, #4f4442);
      opacity: 0.55;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      transition: color 0.2s ease, opacity 0.2s ease;
    }
    .ame-pingente__counter.is-near {
      opacity: 1;
      color: var(--color-primary, #5a4742);
    }
    .ame-pingente__counter.is-full {
      opacity: 1;
      color: #c0392b;
      font-weight: 600;
    }

    .ame-pingente__status {
      font-family: var(--font-primary--family, 'Lexend', sans-serif);
      font-size: 0.75rem;
      color: var(--color-on-surface-variant, #4f4442);
      margin: 0.5rem 0 0;
      min-height: 1rem;
    }
    .ame-pingente__status.is-error {
      color: #c0392b;
    }
  </style>

  <script>
    (() => {
      const root = document.querySelector('[data-pingente]');
      if (!root) return;

      const TIPO_HANDLE_PREFIX = {
        metal: 'pingente-de-metal-para-identificacao-pet',
        couro: 'pingente-de-couro-para-identificacao-pet-',
        'metal-couro': 'pingente-de-metal-com-couro-para-identificacao-pet-',
      };
      const TIPO_NEEDS_COURO_COLOR = { metal: false, couro: true, 'metal-couro': true };
      const FORMATOS = ['Círculo', 'Coração', 'Flor', 'Osso'];

      /* SIZE_MAP padrão — sobrescrito pela textarea do painel se houver */
      const DEFAULT_SIZE_MAP = { XPP: 'P', 'XPP+': 'P', PP: 'P', P: 'P', M: 'G', G: 'G' };

      function parseSizeMap(raw) {
        const out = { ...DEFAULT_SIZE_MAP };
        if (!raw) return out;
        String(raw)
          .split(/[,\n;]+/)
          .map((s) => s.trim())
          .filter(Boolean)
          .forEach((pair) => {
            const [k, v] = pair.split('=').map((s) => (s || '').trim());
            if (k && v) out[k] = v;
          });
        return out;
      }
      const SIZE_MAP = parseSizeMap(root.dataset.sizeMap);

      /* Listas de produtos-pingente configuradas no painel (handles separados por vírgula) */
      function parseHandles(raw) {
        return String(raw || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
      }
      const CONFIGURED_HANDLES = {
        metal: root.dataset.metalHandle ? [root.dataset.metalHandle.trim()] : [],
        couro: parseHandles(root.dataset.couroHandles),
        'metal-couro': parseHandles(root.dataset.metalCouroHandles),
      };

      /* Ícones por formato — emojis */
      const FORMATO_ICON = {
        Círculo: '<span class="ame-pingente__formato-emoji" aria-hidden="true">⭕</span>',
        Coração: '<span class="ame-pingente__formato-emoji" aria-hidden="true">❤️</span>',
        Flor: '<span class="ame-pingente__formato-emoji" aria-hidden="true">🌸</span>',
        Osso: '<span class="ame-pingente__formato-emoji" aria-hidden="true">🦴</span>',
      };

      /* ── Helpers ── */
      function slugify(str) {
        return String(str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/\p{Diacritic}/gu, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
      function extractLastColor(cor) {
        if (!cor) return '';
        const parts = cor
          .split(/\s+com\s+/i)
          .map((s) => s.trim())
          .filter(Boolean);
        return parts[parts.length - 1] || '';
      }
      function buildHandle(tipo, corDoCouro) {
        const scope = CONFIGURED_HANDLES[tipo] || [];

        // Metal universal: 1 produto sem variação por cor.
        if (!TIPO_NEEDS_COURO_COLOR[tipo]) {
          if (scope[0]) return scope[0];
          return TIPO_HANDLE_PREFIX[tipo];
        }

        const slug = slugify(extractLastColor(corDoCouro));
        if (!slug) return null;

        // Procura primeiro dentro da lista configurada no painel: handle deve terminar
        // com o slug da cor (precedido por '-' pra evitar match parcial).
        if (scope.length) {
          const suffix = '-' + slug;
          const match = scope.find((h) => h === slug || h.endsWith(suffix));
          if (match) return match;
          return null; // Lista configurada mas sem match — não cai no fallback global.
        }

        // Sem lista configurada: cai no comportamento antigo (handle convencional).
        return TIPO_HANDLE_PREFIX[tipo] + slug;
      }
      function moneyFmt(cents) {
        if (window.Shopify?.formatMoney) return window.Shopify.formatMoney(cents);
        return 'R$ ' + ((cents || 0) / 100).toFixed(2).replace('.', ',');
      }
      function escapeHTML(str) {
        return String(str ?? '').replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            }[c])
        );
      }

      /* ── State ── */
      const state = {
        opted: false,
        tipo: null,
        formato: null,
        product: null,
        variant: null,
      };
      const productCache = new Map();

      async function fetchProduct(handle) {
        if (!handle) return null;
        if (productCache.has(handle)) return productCache.get(handle);
        try {
          const res = await fetch(`/products/${handle}.js`, { headers: { Accept: 'application/json' } });
          if (!res.ok) {
            productCache.set(handle, null);
            return null;
          }
          const product = await res.json();
          productCache.set(handle, product);
          return product;
        } catch (err) {
          return null;
        }
      }

      async function loadTipoThumbs() {
        const coleira = readColeiraSelection();
        const tipos = ['metal', 'couro', 'metal-couro'];
        await Promise.all(
          tipos.map(async (tipo) => {
            const card = root.querySelector(`[data-pingente-tipo-card="${tipo}"]`);
            if (!card) return;
            const thumb = card.querySelector('[data-tipo-thumb]');
            const priceEl = card.querySelector('[data-tipo-price]');
            const radio = card.querySelector('[data-pingente-tipo]');

            const handle = buildHandle(tipo, coleira.cor);
            const product = handle ? await fetchProduct(handle) : null;

            if (!product) {
              card.classList.add('is-unavailable');
              if (radio) radio.disabled = true;
              if (priceEl) priceEl.textContent = '';
              if (thumb)
                thumb.innerHTML =
                  '<span class="ame-pingente__tipo-placeholder" aria-hidden="true"><span class="material-symbols-outlined">block</span></span>';
              return;
            }

            card.classList.remove('is-unavailable');
            if (radio) radio.disabled = false;
            const imgSrc = product.featured_image || (product.images && product.images[0]) || '';
            if (thumb) {
              if (imgSrc) {
                thumb.innerHTML = `<img src="${escapeHTML(imgSrc)}" alt="${escapeHTML(
                  product.title || ''
                )}" loading="lazy">`;
              } else {
                thumb.innerHTML =
                  '<span class="ame-pingente__tipo-placeholder" aria-hidden="true"><span class="material-symbols-outlined">image</span></span>';
              }
            }
            if (priceEl && product.price) priceEl.textContent = '+ ' + moneyFmt(product.price);
          })
        );
      }

      /* ── Calcula range de preço dos pingentes e injeta na mensagem de opt-in ── */
      async function loadPriceRange() {
        const tpl = root.dataset.optinTemplate || '';
        const msgEl = root.querySelector('[data-pingente-optin-msg]');
        if (!msgEl || !tpl) return;
        if (!tpl.includes('{min}') && !tpl.includes('{max}')) return;

        const coleira = readColeiraSelection();
        const handles = ['metal', 'couro', 'metal-couro'].map((tipo) => buildHandle(tipo, coleira.cor)).filter(Boolean);
        const products = await Promise.all(handles.map(fetchProduct));
        const prices = products
          .filter(Boolean)
          .flatMap((p) => (p.variants || []).filter((v) => v.available).map((v) => v.price));
        if (!prices.length) return;
        const min = Math.min(...prices);
        const max = Math.max(...prices);
        msgEl.textContent = tpl.replace(/\{min\}/g, moneyFmt(min)).replace(/\{max\}/g, moneyFmt(max));
      }

      /* ── DOM refs ── */
      const step2 = root.querySelector('[data-pingente-step="2"]');
      const step3 = root.querySelector('[data-pingente-step="3"]');
      const step4 = root.querySelector('[data-pingente-step="4"]');
      const formatoGrid = root.querySelector('[data-pingente-formato-grid]');
      const statusEl = root.querySelector('[data-pingente-status]');
      const phoneInput = root.querySelector('[data-pingente-tel]');
      const petInput = root.querySelector('[data-pingente-pet]');
      const overlay = document.querySelector('[data-pingente-overlay]');
      const overlayImg = overlay?.querySelector('[data-pingente-overlay-img]');

      /* ── Overlay sobre a imagem principal ── */
      function updateOverlay() {
        if (!overlay || !overlayImg) return;
        const variant = state.variant;
        const src = variant?.featured_image?.src || state.product?.featured_image || '';
        if (state.opted && variant && variant.available && src) {
          overlayImg.src = src;
          overlayImg.alt = `Pingente ${state.formato || ''}`.trim();
          overlay.hidden = false;
          // Force reflow to ensure transition runs after un-hiding
          void overlay.offsetWidth;
          overlay.classList.add('is-visible');
        } else {
          overlay.classList.remove('is-visible');
          overlay.hidden = true;
          overlayImg.removeAttribute('src');
        }
      }

      /* ── Coleira selection ── */
      function readColeiraSelection() {
        const wrap = document.getElementById('pdp-options-wrap');
        const sel = { cor: null, corMetal: null, tamanho: null, raw: {} };
        if (!wrap) return sel;
        wrap.querySelectorAll('.pdp__option').forEach((opt) => {
          const label = opt.querySelector('.pdp__option-label')?.textContent.trim();
          const active = opt.querySelector('.pdp__swatch--active, .pdp__size-btn--active');
          if (!label || !active) return;
          sel.raw[label] = active.dataset.value;
          const norm = String(label)
            .toLowerCase()
            .normalize('NFD')
            .replace(/\p{Diacritic}/gu, '')
            .trim();
          if (norm === 'cor') sel.cor = active.dataset.value;
          else if (norm === 'cor do metal' || norm === 'metal') sel.corMetal = active.dataset.value;
          else if (norm === 'tamanho' || norm === 'size') sel.tamanho = active.dataset.value;
        });
        return sel;
      }

      /* ── Coleira completa? Esconde/exibe a section toda em função disso ── */
      function isColeiraComplete() {
        const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
        if (!groups.length) return true;
        return Array.from(groups).every((g) => g.querySelector('.pdp__swatch--active, .pdp__size-btn--active'));
      }
      function syncVisibility() {
        const ok = isColeiraComplete();
        root.hidden = !ok;
        if (!ok) {
          // Reset estado do pingente se a coleira virou incompleta
          state.opted = false;
          state.tipo = null;
          state.formato = null;
          state.product = null;
          state.variant = null;
          updateOverlay();
        }
      }
      syncVisibility();

      function setStatus(msg, isError) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.classList.toggle('is-error', !!isError);
      }

      /* ── Passo 1: Opt-in ── */
      root.querySelectorAll('[data-pingente-opt]').forEach((r) => {
        r.addEventListener('change', (e) => {
          state.opted = e.target.value === 'sim';
          step2.hidden = !state.opted;
          if (!state.opted) {
            state.tipo = null;
            state.formato = null;
            state.product = null;
            state.variant = null;
            step3.hidden = true;
            step4.hidden = true;
            setStatus('');
            updateOverlay();
          } else {
            loadTipoThumbs();
            if (state.tipo) handleTipoChange(state.tipo);
          }
        });
      });

      /* ── Passo 2: Tipo ── */
      root.querySelectorAll('[data-pingente-tipo]').forEach((r) => {
        r.addEventListener('change', (e) => {
          state.tipo = e.target.value;
          state.formato = null;
          handleTipoChange(state.tipo);
        });
      });

      async function handleTipoChange(tipo) {
        if (!tipo) return;
        const coleira = readColeiraSelection();
        console.info('[pingente] coleira selection:', coleira);
        const handle = buildHandle(tipo, coleira.cor);
        if (!handle) {
          setStatus('Selecione a cor da coleira antes de escolher o tipo do pingente.', true);
          state.product = null;
          state.variant = null;
          step3.hidden = true;
          step4.hidden = true;
          updateOverlay();
          return;
        }
        setStatus('Carregando opções...', false);
        const product = await fetchProduct(handle);
        if (!product) {
          console.warn('[pingente] produto pingente não encontrado:', handle);
          setStatus(
            'Pingente indisponível para a cor selecionada da coleira. Verifique se o produto pingente foi cadastrado com o handle correto.',
            true
          );
          state.product = null;
          state.variant = null;
          step3.hidden = true;
          step4.hidden = true;
          updateOverlay();
          return;
        }
        console.info('[pingente] produto carregado:', {
          handle,
          options: product.options,
          variants_count: product.variants?.length,
        });
        state.product = product;
        updateTipoPrice(tipo, product);
        setStatus('', false);
        step3.hidden = false;
        renderFormatos();
      }

      function updateTipoPrice(tipo, product) {
        const priceEl = root.querySelector(`[data-pingente-tipo-card="${tipo}"] [data-tipo-price]`);
        if (priceEl && product?.price) {
          priceEl.textContent = '+ ' + moneyFmt(product.price);
        }
      }

      /* ── Passo 3: Formato ── */
      function normalizeOptName(name) {
        return String(name || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/\p{Diacritic}/gu, '')
          .trim();
      }

      function getOptionIndexes(product) {
        const optNames = (product.options || []).map((o) => (typeof o === 'string' ? o : o.name));
        const findIdx = (matchers) =>
          optNames.findIndex((n) => {
            const norm = normalizeOptName(n);
            return matchers.some(
              (m) => norm === m || norm.startsWith(m + ' ') || norm.endsWith(' ' + m) || norm.includes(' ' + m + ' ')
            );
          });
        return {
          names: optNames,
          formato: findIdx(['formato']),
          corMetal: findIdx(['cor do metal', 'metal']),
          tamanho: findIdx(['tamanho', 'size']),
        };
      }

      /**
       * Lista de tamanhos a tentar, na ordem: mapeamento custom do painel → fallback default (P/G).
       * Permite que pingentes com menos tamanhos (ex: só P/G) continuem funcionando mesmo quando
       * o lojista mapeou a coleira para um tamanho mais granular (ex: XPP → XPP) que só existe
       * em alguns produtos-pingente.
       */
      function tamanhoCandidates(coleiraTamanho) {
        if (!coleiraTamanho) return [null];
        const out = [];
        const custom = SIZE_MAP[coleiraTamanho];
        const fallback = DEFAULT_SIZE_MAP[coleiraTamanho];
        if (custom) out.push(custom);
        if (fallback && !out.includes(fallback)) out.push(fallback);
        return out.length ? out : [null];
      }

      /** Acha a primeira variante disponível que case formato + cor do metal + um dos tamanhos candidatos */
      function findAvailableVariant(formato, idx, targetMetal, candidates) {
        for (const tamanho of candidates) {
          const v = state.product.variants.find((vv) => {
            if (vv[`option${idx.formato + 1}`] !== formato) return false;
            if (idx.corMetal !== -1 && targetMetal && vv[`option${idx.corMetal + 1}`] !== targetMetal) return false;
            if (idx.tamanho !== -1 && tamanho && vv[`option${idx.tamanho + 1}`] !== tamanho) return false;
            return true;
          });
          if (v && v.available) return v;
        }
        return null;
      }

      function renderFormatos() {
        if (!state.product || !formatoGrid) return;
        const idx = getOptionIndexes(state.product);
        console.info('[pingente] options index:', idx);
        if (idx.formato === -1) {
          const optNames = idx.names.join(', ') || '(nenhuma)';
          setStatus(
            `Produto de pingente não tem option "Formato". Options atuais: ${optNames}. Cadastre o produto com options "Cor do Metal", "Formato" e "Tamanho".`,
            true
          );
          formatoGrid.innerHTML = '';
          return;
        }

        const coleira = readColeiraSelection();
        const targetMetal = coleira.corMetal;
        const candidates = tamanhoCandidates(coleira.tamanho);

        const html = FORMATOS.map((formato) => {
          const variant = findAvailableVariant(formato, idx, targetMetal, candidates);
          // Fallback display: qualquer variante com esse formato (pra mostrar mesmo indisponível)
          const anyVariantOfFormato = state.product.variants.find((v) => v[`option${idx.formato + 1}`] === formato);
          const displayVariant = variant || anyVariantOfFormato;
          const available = !!variant;

          const icon = FORMATO_ICON[formato] || '';

          return `
          <label class="ame-pingente__formato-card ${
            available ? '' : 'is-unavailable'
          }" data-formato-card="${escapeHTML(formato)}">
            <input type="radio" name="ame-pingente-formato" value="${escapeHTML(formato)}" data-pingente-formato ${
            available ? '' : 'disabled'
          }>
            <div class="ame-pingente__formato-thumb">${icon}</div>
            <span class="ame-pingente__formato-name">${escapeHTML(formato)}</span>
          </label>
        `;
        }).join('');

        formatoGrid.innerHTML = html;

        formatoGrid.querySelectorAll('[data-pingente-formato]').forEach((r) => {
          r.addEventListener('change', (e) => {
            state.formato = e.target.value;
            resolveVariant();
          });
        });

        // Restaurar seleção anterior se o formato ainda estiver disponível
        if (state.formato) {
          const prev = formatoGrid.querySelector(`[value="${CSS.escape(state.formato)}"]:not(:disabled)`);
          if (prev) {
            prev.checked = true;
            resolveVariant();
            return;
          }
          state.formato = null;
        }
        state.variant = null;
        step4.hidden = true;
        updateOverlay();
      }

      /* ── Resolve final variant ── */
      function resolveVariant() {
        if (!state.product || !state.formato) {
          state.variant = null;
          step4.hidden = true;
          updateOverlay();
          return;
        }
        const idx = getOptionIndexes(state.product);
        const coleira = readColeiraSelection();
        const targetMetal = coleira.corMetal;
        const candidates = tamanhoCandidates(coleira.tamanho);

        const variant = findAvailableVariant(state.formato, idx, targetMetal, candidates);

        if (!variant) {
          setStatus('Combinação de pingente indisponível (cor do metal ou tamanho).', true);
          state.variant = null;
          step4.hidden = true;
          updateOverlay();
          return;
        }

        state.variant = variant;
        setStatus('', false);
        step4.hidden = false;
        updateOverlay();
      }

      /* ── Máscara de telefone ── */
      if (phoneInput) {
        phoneInput.addEventListener('input', (e) => {
          const digits = e.target.value.replace(/\D/g, '').slice(0, 11);
          let formatted = digits;
          if (digits.length > 7) {
            formatted = `${digits.slice(0, 2)} ${digits.slice(2, 7)}-${digits.slice(7)}`;
          } else if (digits.length > 2) {
            formatted = `${digits.slice(0, 2)} ${digits.slice(2)}`;
          }
          e.target.value = formatted;
        });
      }

      /* ── Limpa erro quando usuário digita ── */
      if (petInput) {
        petInput.addEventListener('input', () => {
          petInput.closest('.ame-pingente__field')?.classList.remove('is-invalid');
        });
      }

      /* ── Contador de caracteres ── */
      root.querySelectorAll('[data-pingente-counter]').forEach((counter) => {
        const max = parseInt(counter.dataset.max, 10) || 0;
        if (!max) return;
        const field = counter.closest('.ame-pingente__field')?.querySelector('input, textarea');
        if (!field) return;
        const update = () => {
          const len = field.value.length;
          counter.textContent = `${len} / ${max}`;
          counter.classList.toggle('is-near', len >= max * 0.8 && len < max);
          counter.classList.toggle('is-full', len >= max);
        };
        field.addEventListener('input', update);
        update();
      });

      /* ── Re-validar quando variante da coleira muda ── */
      document.addEventListener('pdp:variant-changed', () => {
        syncVisibility();
        if (root.hidden) return;
        loadPriceRange();
        if (!state.opted) return;
        loadTipoThumbs();
        if (state.tipo) handleTipoChange(state.tipo);
      });

      /* ── Boot: carrega range de preço em idle (não atrasa LCP) ── */
      const boot = () => loadPriceRange();
      if ('requestIdleCallback' in window) {
        requestIdleCallback(boot, { timeout: 2000 });
      } else {
        setTimeout(boot, 600);
      }

      /* ── API pública pro submit do product form ── */
      window.amePingente = {
        isActive() {
          return state.opted;
        },
        validate() {
          if (!state.opted) return { ok: true };

          const headerH = document.querySelector('.ame-header-group')?.getBoundingClientRect().height || 0;
          const scrollTo = (el) => {
            if (!el) return;
            const top = el.getBoundingClientRect().top + window.scrollY - headerH - 16;
            window.scrollTo({ top, behavior: 'smooth' });
          };
          const flashStep = (n) => {
            const step = root.querySelector(`[data-pingente-step="${n}"]`);
            if (!step) return null;
            step.classList.add('is-invalid');
            setTimeout(() => step.classList.remove('is-invalid'), 1600);
            return step;
          };

          if (!state.tipo) {
            scrollTo(flashStep(2));
            return { ok: false, msg: 'Selecione o tipo do pingente.' };
          }
          if (!state.formato) {
            scrollTo(flashStep(3));
            return { ok: false, msg: 'Selecione o formato do pingente.' };
          }
          if (!state.variant) {
            scrollTo(flashStep(2));
            return { ok: false, msg: 'Combinação do pingente não está disponível.' };
          }
          const pet = petInput?.value.trim() || '';
          if (!pet) {
            const field = petInput?.closest('.ame-pingente__field');
            field?.classList.add('is-invalid');
            scrollTo(field);
            setTimeout(() => petInput?.focus({ preventScroll: true }), 350);
            return { ok: false, msg: 'Informe o nome do pet.' };
          }
          return { ok: true };
        },
        getCartItem(quantity) {
          if (!state.opted || !state.variant) return null;
          const qty = Math.max(1, parseInt(quantity, 10) || 1);
          const pet = petInput?.value.trim() || '';
          const tutor = root.querySelector('[data-pingente-tutor]')?.value.trim() || '';
          const tel = root.querySelector('[data-pingente-tel]')?.value.trim() || '';

          // Identificação da coleira que originou este pingente — para o cliente
          // saber a qual produto cada pingente pertence quando há mais de um.
          const coleiraTitle = root.dataset.coleiraTitle || '';
          const coleira = readColeiraSelection();
          const opcoes = Object.entries(coleira.raw)
            .map(([k, v]) => `${k}: ${v}`)
            .join(', ');
          const coleiraLabel = [coleiraTitle, opcoes].filter(Boolean).join(' — ');

          const properties = {};
          if (coleiraLabel) properties['Coleira'] = coleiraLabel;
          properties['Nome do pet'] = pet;
          if (tutor) properties['Nome do tutor'] = tutor;
          if (tel) properties['Telefone do tutor'] = tel;
          return { id: state.variant.id, quantity: qty, properties };
        },
      };
    })();
  </script>
{%- endif -%}
