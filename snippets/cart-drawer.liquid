<div class="cart-drawer-container">
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-header-heading">{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer-close button-reset" aria-label="{{ 'cart.close_drawer' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer-contents">
        <ul class="cart-drawer-items list-reset">
          {% for item in cart.items %}
            <li class="cart-drawer-item">
              {% if item.image %}
                <a href="{{ item.url }}">
                  {{
                    item.image
                    | image_url: width: 400, height: 400, crop: 'center'
                    | image_tag: sizes: '102px', loading: 'lazy'
                  }}
                </a>
              {% endif %}

              <div class="cart-drawer-item-meta">
                <h3>
                  <a href="{{ item.url }}" class="link-reset">{{ item.product.title }}</a>
                </h3>

                <div class="cart-drawer-item-price">
                  <div>
                    {% if item.original_price > item.final_price %}
                      <s>{{ item.original_price | money }}</s>
                    {% endif %}

                    {{ item.final_price | money }}
                  </div>
                  <div>
                    {% if item.line_level_discount_allocations.size > 0 %}
                      <ul class="cart-drawer-item-discounts list-reset">
                        {% for discount_allocation in item.line_level_discount_allocations %}
                          <li class="cart-drawer-item-discount">
                            {{ 'icon-discount.svg' | inline_asset_content }}
                            {{ discount_allocation.discount_application.title }}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>

                <div class="cart-drawer-item-options">
                  {%- for option in item.options_with_values -%}
                    <dl class="cart-drawer-item-option">
                      <dt>{{ option.name }}:</dt>
                      <dd>{{ option.value }}</dd>
                    </dl>
                  {%- endfor -%}
                </div>
                <div class="cart-drawer-item-actions">
                  <div
                    class="cart-drawer-item-quantity"
                    role="group"
                    aria-label="{{ 'cart.quantity_selector_html' | t: product: item.product.title | escape }}"
                  >
                    <button
                      type="button"
                      class="cart-drawer-item-qty-button"
                      data-delta="-1"
                      data-key="{{ item.key }}"
                      aria-label="{{ 'cart.decrease_quantity_html' | t: product: item.product.title | escape }}"
                    >
                      −
                    </button>
                    <input
                      type="number"
                      min="0"
                      step="1"
                      class="cart-drawer-item-quantity-value"
                      aria-live="polite"
                      value="{{ item.quantity }}"
                      inputmode="numeric"
                      aria-label="{{ 'cart.quantity' | t }}"
                    >
                    <button
                      type="button"
                      class="cart-drawer-item-qty-button"
                      data-delta="1"
                      data-key="{{ item.key }}"
                      aria-label="{{ 'cart.increase_quantity_html' | t: product: item.product.title | escape }}"
                    >
                      +
                    </button>
                  </div>
                  <button
                    type="button"
                    class="cart-drawer-item-remove button-reset"
                    data-key="{{ item.key }}"
                    aria-label="{{ 'cart.remove_item' | t }}"
                  >
                    {{ 'icon-trash.svg' | inline_asset_content }}
                  </button>
                </div>
              </div>
              <div class="cart-drawer-item-line-price">
                <div>
                  {% if item.original_line_price > item.final_line_price %}
                    <s>{{ item.original_line_price | money }}</s>
                  {% endif %}
                </div>
                <div>
                  {{ item.final_line_price | money }}
                </div>
              </div>
            </li>
          {%- endfor %}
        </ul>
      </div>
      <div class="cart-drawer-footer">
        <div>
          {% if cart.cart_level_discount_applications.size > 0 %}
            <ul class="cart-drawer-footer-discounts list-reset">
              {% for discount_application in cart.cart_level_discount_applications %}
                <li class="cart-drawer-footer-discount">
                  {{ 'icon-discount.svg' | inline_asset_content }}
                  {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <div class="cart-drawer-footer-totals">
          {% if cart.item_count > 0 %}
            <span>{{ 'cart.subtotal' | t }}:</span> <span>{{ cart.total_price | money }}</span>
          {% endif %}
        </div>
        <div class="cart-drawer-footer-note">{{ 'cart.calculate' | t }}</div>
        <a href="/checkout" class="cart-drawer-button button">{{ 'cart.checkout' | t }}</a>
      </div>
    {% else %}
      <div class="cart-drawer-empty">
        <p class="cart-drawer-empty-heading">{{ 'cart.empty' | t }}</p>
        <div>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer-empty-button button">
            {{- 'cart.continue_shopping' | t -}}
          </a>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% style %}
  @scope {
    .cart-drawer-container {
      visibility: hidden;
      position: fixed;
      z-index: 1000;
      inset: 0;
      display: flex;
      justify-content: flex-end;
      background-color: rgba(0, 0, 0, 0.5);
      transition: visibility 0.3s ease;
    }

    .cart-drawer {
      height: 100%;
      width: 40rem;
      max-width: calc(100vw - 3rem);
      padding: 0 1.5rem;
      border-right: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: var(--color-background);
      transform: translate(100%);
      transition: transform 0.3s ease;
    }

    .cart-drawer-container.active {
      visibility: visible;
    }

    .cart-drawer-container.active .cart-drawer {
      transform: translate(0);
    }

    .cart-drawer-close {
      cursor: pointer;
      width: 3rem;
      height: 3rem;
    }

    .cart-drawer-close .icon-close {
      width: 2.5rem;
    }

    .cart-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0;
      border-bottom: 0.1rem solid rgba(0, 0, 0, 0.2);
    }

    .cart-drawer-header-heading {
      margin: 0;
    }

    .cart-drawer-contents {
      flex: 1;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 0, 0, 0.35) transparent;
      padding: 1rem 0.25rem 1rem 0;
    }

    .cart-drawer-contents::-webkit-scrollbar {
      width: 0.5rem;
    }

    .cart-drawer-contents::-webkit-scrollbar-track {
      background: transparent;
    }

    .cart-drawer-contents::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.35);
      border-radius: 999px;
    }

    .cart-drawer-contents::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 0, 0, 0.5);
    }

    .cart-drawer-items {
      display: grid;
      gap: 1rem;
    }

    .cart-drawer-item {
      display: grid;
      grid-template-columns: 1fr 2fr auto;
      gap: 1rem;
    }

    .cart-drawer-item-meta {
      display: grid;
      gap: 0.5rem;
    }

    .cart-drawer-item h3 {
      font-size: 1.4rem;
      margin: 0;
    }

    .cart-drawer-item-price {
      font-size: 1.4rem;
      display: grid;
      gap: 0.5rem;
    }

    .cart-drawer-item-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .cart-drawer .icon-discount {
      width: 1.2rem;
    }

    .cart-drawer-item-discount,
    .cart-drawer-footer-discount {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 1.2rem;
    }

    .cart-drawer s {
      opacity: 0.8;
      font-size: 1.2rem;
    }

    .cart-drawer-item-options {
      font-size: 1.2rem;
    }

    .cart-drawer-item-option {
      display: flex;
      gap: 0.2rem;
    }

    .cart-drawer-item-quantity {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      width: fit-content;
      padding: 0.4rem 0.6rem;
      border: 0.1rem solid rgba(0, 0, 0, 0.15);
      border-radius: 999rem;
    }

    .cart-drawer-item-qty-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      border: 0;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.05);
      cursor: pointer;
      font-size: 1.8rem;
      line-height: 1;
    }

    .cart-drawer-item-quantity-value {
      width: 4rem;
      min-width: 2rem;
      text-align: center;
      border: 0;
      background: transparent;
      font: inherit;
      appearance: textfield;
      -moz-appearance: textfield;
    }

    .cart-drawer-item-quantity-value::-webkit-outer-spin-button,
    .cart-drawer-item-quantity-value::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    .cart-drawer-item-remove {
      width: 2rem;
      height: 2rem;
      cursor: pointer;
    }

    .cart-drawer-item-line-price {
      display: flex;
      flex-direction: column;
    }

    .cart-drawer-item-line-price.is-loading {
      position: relative;
      color: transparent;
    }

    .cart-drawer-item-line-price.is-loading::before {
      content: '';
      display: block;
      width: 1.8rem;
      height: 1.8rem;
      border: 0.2rem solid rgba(0, 0, 0, 0.15);
      border-top-color: rgba(0, 0, 0, 0.6);
      border-radius: 50%;
      animation: cart-drawer-spin 0.7s linear infinite;
    }

    @keyframes cart-drawer-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .cart-drawer-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
      flex-grow: 1;
    }

    .cart-drawer-empty-heading {
      font-size: 3rem;
      font-weight: bold;
    }

    .cart-drawer-footer {
      padding: 1rem 0;
      border-top: 0.1rem solid rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .cart-drawer-footer-totals {
      display: flex;
      justify-content: space-between;
    }

    .cart-drawer-footer-note {
      font-size: 1.4rem;
    }

    .cart-drawer-button {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}
