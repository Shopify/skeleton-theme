{% assign margins = settings.min_page_margin | times: 2 %}
{% assign full_width = settings.max_page_width | minus: margins %}

{% assign sizes = '(min-width: '
  | append: settings.max_page_width
  | append: ') '
  | append: full_width
  | append: 'px, '
  | append: 'calc(100vw - '
  | append: margins
  | append: 'px)'
%}

<div class="article-image">
  {{ image | image_url: width: 2500, height: 1250, crop: 'center' | image_tag: sizes: sizes, preload: true }}
</div>
