{% liquid
  assign margins = settings.min_page_margin | times: 2
  assign grid_space = 30 | plus: margins
%}

{% assign sizes = '(min-width: '
  | append: settings.max_page_width
  | append: ') calc(('
  | append: settings.max_page_width
  | append: ' - '
  | append: grid_space
  | append: 'px) / 4), '
  | append: '(min-width: 768px) calc((100vw - '
  | append: grid_space
  | append: 'px) / 4), '
  | append: '(min-width: 576px) calc(50vw - '
  | append: settings.min_page_margin
  | append: 'px), calc(100vw - '
  | append: margins
  | append: 'px)'
%}

{% render 'image', image: image, url: url, width: 1000, height: 1000, crop: 'center', sizes: sizes, class: class %}
