{% assign visible_product_count = collection.products_count | default: collection.products.size %}
{% assign total_product_count = collection.all_products_count | default: visible_product_count %}

<div class="collection-toolbar">
  {% if collection.filters != empty or collection.sort_options.size > 0 %}
    {% assign active_filter_count = 0 %}
    {% for filter in collection.filters %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
    {% endfor %}

    <form class="collection-filters" action="{{ collection.url }}" method="get">
      <div class="collection-filters-wrap">
        {% if collection.filters != empty %}
          <header class="collection-filters-header">
            <h2 class="collection-filters-heading">Filter:</h2>

            {% comment %}
              {% if active_filter_count > 0 %}
                <a href="{{ collection.url }}" class="collection-filters-clear">Clear all</a>
              {% endif %}
            {% endcomment %}
          </header>

          {% for filter in collection.filters %}
            <details class="collection-filter">
              <summary>
                {{ filter.label }}
                {{ 'icon-dropdown.svg' | inline_asset_content }}
                {% if filter.active_values.size > 0 %}
                  <span class="collection-filter-active-count">{{ filter.active_values.size }}</span>
                {% endif %}
              </summary>

              <div class="collection-filter-content">
                {% case filter.type %}
                  {% when 'list', 'boolean' %}
                    <ul class="collection-filter-values list-reset" role="list">
                      {% for filter_value in filter.values %}
                        <li>
                          <label class="collection-filter-value {% if filter_value.count == 0 and filter_value.active == false %}is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ filter_value.param_name }}"
                              value="{{ filter_value.value }}"
                              {% if filter_value.active %}
                                checked
                              {% endif %}
                              {% if filter_value.count == 0 and filter_value.active == false %}
                                disabled
                              {% endif %}
                            >

                            {% if filter_value.swatch != blank %}
                              {% if filter_value.swatch.image != blank %}
                                <span
                                  class="collection-filter-swatch"
                                  style="background-image: url('{{ filter_value.swatch.image | image_url: width: 32 }}');"
                                ></span>
                              {% elsif filter_value.swatch.color != blank %}
                                <span
                                  class="collection-filter-swatch"
                                  style="background-color: {{ filter_value.swatch.color }};"
                                ></span>
                              {% endif %}
                            {% endif %}

                            <span>{{ filter_value.label }}</span>
                            <span class="collection-filter-value-count">({{ filter_value.count }})</span>
                          </label>
                        </li>
                      {% endfor %}
                    </ul>

                  {% when 'price_range' %}
                    <div class="collection-filter-price-range">
                      <label>
                        <span>From</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          min="0"
                          placeholder="0"
                        >
                      </label>

                      <label>
                        <span>To</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          min="0"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        >
                      </label>
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}
        {% endif %}
      </div>
      <div class="collection-sort-wrap">
        {% if collection.sort_options.size > 0 %}
          <label class="collection-sort">
            <span class="collection-sort-label">Sort by</span>
            <select name="sort_by" aria-label="Sort by">
              {% for option in collection.sort_options %}
                <option
                  value="{{ option.value }}"
                  {% if option.value == collection.sort_by %}
                    selected
                  {% endif %}
                >
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endif %}
        {% if visible_product_count > 0 %}
          <div class="collection-product-count">{{ visible_product_count }} of {{ total_product_count }} products</div>
        {% endif %}
      </div>
      <div></div>
    </form>
  {% endif %}
</div>

{% stylesheet %}
  .collection-toolbar {
    margin-block: 1.5rem;
  }

  .collection-product-count {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 600;
  }

  .collection-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .collection-filters-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .collection-sort-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .collection-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    font-size: 1.4rem;
  }

  .collection-sort-label {
    white-space: nowrap;
  }

  .collection-sort select {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .collection-filters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .collection-filters-heading {
    margin: 0;
    font-size: 1.4rem;
  }

  .collection-filters-clear {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .collection-filter {
    position: relative;
  }

  .collection-filter summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    padding-block: 0.875rem;
    font-size: 1.4rem;
    line-height: 1;
  }

  .collection-filter .icon-dropdown {
    width: 1rem;
    height: 0.6rem;
    position: relative;
    top: 0.1rem;
  }

  .collection-filter-active-count {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: 50%;
    background: currentColor;
    color: white;
    font-size: 0.75rem;
  }

  .collection-filter-content {
    padding: 1rem;
    position: absolute;
    left: 0;
    top: 100%;
    width: 35rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .collection-filter-values {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .collection-filter-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .collection-filter-value.is-disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .collection-filter-value input {
    margin: 0;
  }

  .collection-filter-swatch {
    width: 1rem;
    height: 1rem;
    border: 1px solid;
    border-radius: 50%;
    background-position: center;
    background-size: cover;
  }

  .collection-filter-value-count {
    opacity: 0.7;
  }

  .collection-filter-price-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .collection-filter-price-range label {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .collection-filter-price-range input {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid;
    background: transparent;
    color: inherit;
  }

  .collection-filters-apply {
    justify-self: start;
    padding: 0.625rem 1rem;
    border: 1px solid;
    color: white;
    cursor: pointer;
  }
{% endstylesheet %}

{% javascript %}
  // Close other filter groups when one is opened
  const filterGroups = document.querySelectorAll('.collection-filter');

  if (filterGroups.length) {
    filterGroups.forEach((group) => {
      group.addEventListener('toggle', () => {
        if (!group.open) return;

        filterGroups.forEach((otherGroup) => {
          if (otherGroup !== group) {
            otherGroup.removeAttribute('open');
          }
        });
      });
    });
  }

  // Update collection products via AJAX when filters change
  const collectionFiltersForm = document.querySelector('.collection-filters');
  const collectionProducts = document.querySelector('.collection-products');

  if (collectionFiltersForm && collectionProducts) {
    // Build the URL for the filtered collection based on the form data
    const getFilteredCollectionUrl = (form) => {
      const params = new URLSearchParams();
      const formData = new FormData(form);

      formData.forEach((value, key) => {
        if (String(value).trim() !== '') {
          params.append(key, String(value));
        }
      });

      const url = new URL(form.action || window.location.href, window.location.origin);
      url.search = params.toString();
      return url.toString();
    };

    // Update the product grid
    const updateCollectionProducts = async (url) => {
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
        },
      });

      if (!response.ok) {
        throw new Error(`Collection update failed: ${response.status}`);
      }

      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextCollectionProducts = doc.querySelector('.collection-products');

      if (!nextCollectionProducts) {
        return;
      }

      collectionProducts.innerHTML = nextCollectionProducts.innerHTML;
      window.history.pushState({ path: url }, '', url);
    };

    // Listen for submit
    collectionFiltersForm.addEventListener('submit', (event) => {
      event.preventDefault();

      const url = getFilteredCollectionUrl(event.currentTarget);

      updateCollectionProducts(url).catch((error) => {
        console.error(error);
        window.location.assign(event.currentTarget.action);
      });
    });

    // Listen for change
    collectionFiltersForm.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLElement)) {
        return;
      }

      if (!event.target.matches('input, select')) {
        return;
      }

      const url = getFilteredCollectionUrl(event.currentTarget);

      updateCollectionProducts(url).catch((error) => {
        console.error(error);
        window.location.assign(event.currentTarget.action);
      });
    });
  }
{% endjavascript %}
