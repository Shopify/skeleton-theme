{% assign visible_product_count = collection.products_count | default: collection.products.size %}
{% assign total_product_count = collection.all_products_count | default: visible_product_count %}

<div class="collection-toolbar">
  {% if collection.filters != empty or collection.sort_options.size > 0 %}
    {% assign active_filter_count = 0 %}
    {% for filter in collection.filters %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
    {% endfor %}

    <details class="collection-toolbar-details">
      <summary class="hide-md">
        <div class="collection-toolbar-toggle">
          {{ 'icon-filter.svg' | inline_asset_content }}
          {{ 'filters.filter_and_sort' | t }}
        </div>
      </summary>
      <div class="collection-toolbar-content">
        <form class="collection-filters" action="{{ collection.url }}" method="get">
          <button type="button" class="collection-toolbar-close hide-md" aria-label="{{ 'filters.close' | t }}">
            {{ 'icon-close.svg' | inline_asset_content }}
          </button>
          <div class="collection-filters-wrap">
            {% if collection.filters != empty %}
              <header class="collection-filters-header">
                <h2 class="collection-filters-heading">{{ 'filters.filter' | t }}</h2>
              </header>

              {% for filter in collection.filters %}
                <details class="collection-filter">
                  <summary>
                    {{ filter.label }}
                    {{ 'icon-dropdown.svg' | inline_asset_content }}
                  </summary>

                  <div class="collection-filter-content">
                    {% case filter.type %}
                      {% when 'list', 'boolean' %}
                        <ul class="collection-filter-values list-reset" role="list">
                          {% for filter_value in filter.values %}
                            <li>
                              <label class="collection-filter-value {% if filter_value.count == 0 and filter_value.active == false %}is-disabled{% endif %} {% if filter_value.swatch != blank %}is-color-value{% endif %}">
                                <input
                                  type="checkbox"
                                  name="{{ filter_value.param_name }}"
                                  value="{{ filter_value.value }}"
                                  {% if filter_value.active %}
                                    checked
                                  {% endif %}
                                  {% if filter_value.count == 0 and filter_value.active == false %}
                                    disabled
                                  {% endif %}
                                >

                                {% if filter_value.swatch != blank %}
                                  {% if filter_value.swatch.image != blank %}
                                    <span
                                      class="collection-filter-swatch"
                                      style="background-image: url('{{ filter_value.swatch.image | image_url: width: 32 }}');"
                                    ></span>
                                  {% elsif filter_value.swatch.color != blank %}
                                    <span
                                      class="collection-filter-swatch"
                                      style="background-color: {{ filter_value.swatch.color }};"
                                    ></span>
                                  {% endif %}
                                {% endif %}

                                <span class="collection-filter-value-label">{{ filter_value.label }}</span>
                                <span class="collection-filter-value-count">({{ filter_value.count }})</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>

                      {% when 'price_range' %}
                        {% assign product_price_min = collection.price_range.min | default: filter.range_min %}
                        {% assign product_price_max = collection.price_range.max | default: filter.range_max %}

                        {% assign min_value = filter.min_value.value | money_without_currency | replace: ',', '' %}
                        {% assign max_value = filter.max_value.value | money_without_currency | replace: ',', '' %}
                        {% assign slider_min = product_price_min
                          | money_without_currency
                          | replace: ',', ''
                          | default: '0'
                        %}
                        {% assign slider_max = product_price_max
                          | money_without_currency
                          | replace: ',', ''
                          | default: '100'
                        %}

                        <div
                          class="collection-filter-price-range"
                          data-range-min="{{ slider_min }}"
                          data-range-max="{{ slider_max }}"
                        >
                          <div class="collection-filter-price-range-inputs">
                            <label>
                              <span>{{ 'filters.from' | t }}</span>
                              <input
                                type="number"
                                name="{{ filter.min_value.param_name }}"
                                value="{{ min_value }}"
                                min="{{ slider_min }}"
                                max="{{ slider_max }}"
                                placeholder="{{ slider_min }}"
                                class="collection-price-input collection-price-input-min"
                              >
                            </label>

                            <span class="collection-filter-price-range-separator">-</span>

                            <label>
                              <span>{{ 'filters.to' | t }}</span>
                              <input
                                type="number"
                                name="{{ filter.max_value.param_name }}"
                                value="{{ max_value }}"
                                min="{{ slider_min }}"
                                max="{{ slider_max }}"
                                placeholder="{{ slider_max }}"
                                class="collection-price-input collection-price-input-max"
                              >
                            </label>
                          </div>

                          <div class="collection-price-slider">
                            <div class="collection-price-track">
                              <div class="collection-price-range-line"></div>
                            </div>

                            <input
                              type="range"
                              min="{{ slider_min }}"
                              max="{{ slider_max }}"
                              value="{{ min_value }}"
                              step="1"
                              class="collection-price-range-slider collection-price-range-slider-min"
                              aria-label="{{ 'filters.min_price' | t }}"
                            >
                            <input
                              type="range"
                              min="{{ slider_min }}"
                              max="{{ slider_max }}"
                              value="{{ max_value }}"
                              step="1"
                              class="collection-price-range-slider collection-price-range-slider-max"
                              aria-label="{{ 'filters.max_price' | t }}"
                            >
                          </div>
                        </div>
                    {% endcase %}
                  </div>
                </details>
              {% endfor %}
            {% endif %}
          </div>
          {% assign has_active_filters = false %}
          {% for filter in collection.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != blank %}
                {% assign has_active_filters = true %}
              {% elsif filter.max_value.value != blank %}
                {% assign has_active_filters = true %}
              {% endif %}
            {% elsif filter.active_values.size > 0 %}
              {% assign has_active_filters = true %}
            {% endif %}
          {% endfor %}

          <div class="collection-sort-wrap">
            {% if collection.sort_options.size > 0 %}
              <label class="collection-sort">
                <span class="collection-sort-label">{{ 'filters.sort_by' | t }}</span>
                <select name="sort_by" aria-label="{{ 'filters.sort_by' | t }}">
                  {% for option in collection.sort_options %}
                    <option
                      value="{{ option.value }}"
                      {% if option.value == collection.sort_by %}
                        selected
                      {% endif %}
                    >
                      {{ option.name }}
                    </option>
                  {% endfor %}
                </select>
              </label>
            {% endif %}
            {% if visible_product_count > 0 %}
              <div class="collection-product-count hide-sm">
                {{ 'filters.product_count_html' | t: count: visible_product_count, total: total_product_count }}
              </div>
            {% endif %}
          </div>
          {% if has_active_filters %}
            <div class="collection-active-filters-wrapper">
              <div class="collection-active-filters" aria-label="{{ 'filters.active_filters' | t }}">
                {% for filter in collection.filters %}
                  {% if filter.type == 'price_range' %}
                    {% if filter.min_value.value != blank %}
                      <a class="collection-active-filter" href="{{ filter.url_to_remove | default: collection.url }}">
                        <span>
                          {% if filter.max_value.value != blank %}
                            {{ filter.min_value.value | money }} – {{ filter.max_value.value | money }}
                          {% else %}
                            {{ filter.min_value.value | money }}+
                          {% endif %}
                        </span>
                        <span aria-hidden="true">×</span>
                      </a>
                    {% elsif filter.max_value.value != blank %}
                      {% assign max_price_formatted = filter.max_value.value | money %}
                      <a class="collection-active-filter" href="{{ filter.url_to_remove | default: collection.url }}">
                        <span>{{ 'filters.up_to_html' | t: price: max_price_formatted }}</span>
                        <span aria-hidden="true">×</span>
                      </a>
                    {% endif %}
                  {% else %}
                    {% for filter_value in filter.active_values %}
                      <a
                        class="collection-active-filter"
                        href="{{ filter_value.url_to_remove | default: collection.url }}"
                      >
                        <span>{{ filter_value.label }}</span>
                        <span aria-hidden="true">×</span>
                      </a>
                    {% endfor %}
                  {% endif %}
                {% endfor %}
              </div>

              <a class="collection-active-filters-clear" href="{{ collection.url }}">{{ 'filters.remove_all' | t }}</a>
            </div>
          {%- endif %}
        </form>
      </div>
    </details>
  {% endif %}
</div>

{% if visible_product_count > 0 %}
  <div class="collection-product-count hide-md">
    {{ 'filters.product_count_html' | t: count: visible_product_count, total: total_product_count }}
  </div>
{% endif %}

{% stylesheet %}
  .collection-toolbar {
    margin-block: 1.5rem;
  }

  .collection-filters {
    display: grid;
  }

  @media (max-width: 767px) {
    .collection-filters {
      height: 100%;
      width: 40rem;
      max-width: calc(100vw - 3rem);
      padding: 0 1.5rem;
      border-right: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: var(--color-background);
      transform: translate(100%);
      transition: transform 0.3s ease;
    }

    .collection-toolbar-details[open] .collection-filters {
      transform: translate(0);
    }
  }

  @media (min-width: 768px) {
    .collection-filters {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      justify-content: space-between;
    }

    .collection-toolbar-details:not([open])::details-content {
      content-visibility: visible;
    }
  }

  .collection-toolbar-details summary {
    list-style: none;
  }

  @media (max-width: 767px) {
    .collection-toolbar-content {
      visibility: hidden;
      position: fixed;
      z-index: 1000;
      inset: 0;
      display: flex;
      justify-content: flex-end;
      background-color: rgba(0, 0, 0, 0.5);
      transition: visibility 0.3s ease;
    }

    .collection-toolbar-details[open] .collection-toolbar-content {
      visibility: visible;
    }
  }

  .collection-toolbar-close {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 3;
    border: none;
    background: transparent;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }

  .collection-toolbar-close .icon-close {
    width: 1.6rem;
  }

  .collection-filters-wrap {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .collection-filters-wrap {
      flex-direction: row;
      align-items: center;
    }
  }

  .collection-active-filters-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .collection-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-active-filters-clear {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .collection-active-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    text-decoration: none;
    font-size: 1.4rem;
    line-height: 1;
  }

  .collection-active-filter span:last-child {
    font-size: 1.6rem;
    line-height: 1;
  }

  .collection-sort-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .collection-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    font-size: 1.4rem;
  }

  .collection-sort-label {
    white-space: nowrap;
  }

  .collection-sort select {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .collection-filters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .collection-filters-heading,
  .collection-toolbar-toggle {
    margin: 0;
    font-size: 1.4rem;
    display: flex;
    gap: 1rem;
  }

  .collection-toolbar-toggle {
    cursor: pointer;
  }

  .collection-filters-heading .icon-filter,
  .collection-toolbar-toggle .icon-filter {
    width: 2rem;
  }

  .collection-filters-clear {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .collection-filter {
    position: relative;
  }

  .collection-filter summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    padding-block: 0.875rem;
    font-size: 1.4rem;
    line-height: 1;
  }

  .collection-filter .icon-dropdown {
    width: 1rem;
    height: 0.6rem;
    position: relative;
    top: 0.1rem;
  }

  @media (min-width: 768px) {
    .collection-filter-content {
      position: absolute;
      left: 0;
      top: 100%;
      width: 35rem;
      padding: 1rem;
      background: var(--color-background);
      border: 1px solid var(--color-border);
    }
  }

  .collection-filter-values {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .collection-filter-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .collection-filter-value.is-disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .collection-filter-value input {
    margin: 0;
  }

  .collection-filter-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background-position: center;
    background-size: cover;
    display: inline-block;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .collection-filter-value.is-color-value {
    justify-content: flex-start;
  }

  .collection-filter-value.is-color-value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .collection-filter-value.is-color-value .collection-filter-value-label,
  .collection-filter-value.is-color-value .collection-filter-value-count {
    display: block;
    font-size: 1.1rem;
    line-height: 1.2;
    text-align: center;
  }

  .collection-filter-value.is-color-value .collection-filter-value-count {
    opacity: 0.7;
  }

  .collection-filter-value.is-color-value .collection-filter-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-color: rgba(0, 0, 0, 0.15);
  }

  .collection-filter-value.is-color-value input:checked + .collection-filter-swatch,
  .collection-filter-value.is-color-value input:focus-visible + .collection-filter-swatch {
    outline: 0.1rem solid var(--color-foreground);
    outline-offset: 0.1rem;
  }

  .collection-filter-value.is-color-value input:disabled + .collection-filter-swatch {
    opacity: 0.2;
  }

  .collection-filter-value-count {
    opacity: 0.7;
  }

  .collection-filter-price-range {
    display: grid;
    gap: 1rem;
  }

  .collection-filter-price-range-inputs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 0.75rem;
  }

  .collection-filter-price-range label {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .collection-filter-price-range-separator {
    display: grid;
    place-items: center;
    padding-bottom: 0.75rem;
    font-size: 1.8rem;
    line-height: 1;
    opacity: 0.8;
  }

  .collection-filter-price-range input[type='number'] {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .collection-price-slider {
    position: relative;
    height: 2.5rem;
    display: grid;
    align-items: center;
  }

  .collection-price-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 0.25rem;
    transform: translateY(-50%);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
  }

  .collection-price-range-line {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-foreground);
    transform-origin: left center;
  }

  .collection-price-range-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
    z-index: 1;
  }

  .collection-price-range-slider-max {
    z-index: 2;
  }

  .collection-price-range-slider::-webkit-slider-runnable-track {
    height: 0.25rem;
    background: transparent;
  }

  .collection-price-range-slider::-moz-range-track {
    height: 0.25rem;
    background: transparent;
  }

  .collection-price-range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-background);
    background: var(--color-foreground);
    margin-top: -0.625rem;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    transform: translateX(-50%);
  }

  .collection-price-range-slider-max::-webkit-slider-thumb {
    transform: translateX(50%);
  }

  .collection-price-range-slider::-moz-range-thumb {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-background);
    background: var(--color-foreground);
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    transform: translateX(-50%);
  }

  .collection-price-range-slider-max::-moz-range-thumb {
    transform: translateX(50%);
  }

  .collection-filters-apply {
    justify-self: start;
    padding: 0.625rem 1rem;
    border: 1px solid;
    color: white;
    cursor: pointer;
  }
{% endstylesheet %}

{% javascript %}
  const setupCollectionFilterInteractions = () => {
    const collectionProducts = document.querySelector('.collection-products');

    if (!collectionProducts) {
      return;
    }

    const filterGroups = document.querySelectorAll('.collection-filter');

    filterGroups.forEach((group) => {
      if (group.dataset.collectionFilterBound === 'true') {
        return;
      }

      group.dataset.collectionFilterBound = 'true';
      group.addEventListener('toggle', () => {
        if (!group.open) return;

        filterGroups.forEach((otherGroup) => {
          if (otherGroup !== group) {
            otherGroup.removeAttribute('open');
          }
        });
      });
    });

    const syncPriceRangeSlider = (group) => {
      const minInput = group.querySelector('.collection-price-input-min');
      const maxInput = group.querySelector('.collection-price-input-max');
      const minSlider = group.querySelector('.collection-price-range-slider-min');
      const maxSlider = group.querySelector('.collection-price-range-slider-max');
      const rangeLine = group.querySelector('.collection-price-range-line');

      if (!minInput || !maxInput || !minSlider || !maxSlider || !rangeLine) {
        return;
      }

      const min = Number(group.dataset.rangeMin || 0);
      const max = Number(group.dataset.rangeMax || 100);
      const hasSelection = String(minInput.value).trim() !== '' || String(maxInput.value).trim() !== '';

      if (!hasSelection) {
        minSlider.value = min;
        maxSlider.value = max;
        minInput.value = '';
        maxInput.value = '';
        rangeLine.style.left = '0%';
        rangeLine.style.width = '100%';
        return;
      }

      const minValue = Math.min(Number(minInput.value || min), Number(maxInput.value || max));
      const maxValue = Math.max(Number(minInput.value || min), Number(maxInput.value || max));

      const leftPercent = ((Math.min(Math.max(minValue, min), max) - min) / (max - min || 1)) * 100;
      const rightPercent = ((Math.min(Math.max(maxValue, min), max) - min) / (max - min || 1)) * 100;

      minSlider.value = Math.min(minValue, maxValue);
      maxSlider.value = Math.max(minValue, maxValue);
      minInput.value = minSlider.value;
      maxInput.value = maxSlider.value;
      rangeLine.style.left = `${leftPercent}%`;
      rangeLine.style.width = `${Math.max(rightPercent - leftPercent, 0)}%`;
    };

    const bindPriceRangeGroup = (group) => {
      if (!group || group.dataset.priceRangeBound === 'true') {
        return;
      }

      group.dataset.priceRangeBound = 'true';

      const minInput = group.querySelector('.collection-price-input-min');
      const maxInput = group.querySelector('.collection-price-input-max');
      const minSlider = group.querySelector('.collection-price-range-slider-min');
      const maxSlider = group.querySelector('.collection-price-range-slider-max');

      if (!minInput || !maxInput || !minSlider || !maxSlider) {
        return;
      }

      [minInput, maxInput].forEach((input) => {
        input.addEventListener('input', () => {
          const minValue = Number(minInput.value || 0);
          const maxValue = Number(maxInput.value || 0);

          if (minValue > maxValue) {
            if (document.activeElement === minInput) {
              maxInput.value = minInput.value;
            } else {
              minInput.value = maxInput.value;
            }
          }

          syncPriceRangeSlider(group);
        });
      });

      [minSlider, maxSlider].forEach((slider) => {
        slider.addEventListener('input', () => {
          const minValue = Number(minSlider.value || 0);
          const maxValue = Number(maxSlider.value || 0);

          if (minValue > maxValue) {
            if (slider === minSlider) {
              maxSlider.value = minSlider.value;
            } else {
              minSlider.value = maxSlider.value;
            }
          }

          minInput.value = minSlider.value;
          maxInput.value = maxSlider.value;
          syncPriceRangeSlider(group);
        });
      });

      syncPriceRangeSlider(group);
    };

    document.querySelectorAll('.collection-filter-price-range').forEach((group) => {
      bindPriceRangeGroup(group);
    });

    const getFilteredCollectionUrl = (form) => {
      const params = new URLSearchParams();
      const formData = new FormData(form);

      formData.forEach((value, key) => {
        if (String(value).trim() !== '') {
          params.append(key, String(value));
        }
      });

      const url = new URL(form.action || window.location.href, window.location.origin);
      url.search = params.toString();
      return url.toString();
    };

    let activeCollectionRequest = null;

    const updateCollectionProducts = async (url) => {
      if (activeCollectionRequest) {
        activeCollectionRequest.abort();
      }

      activeCollectionRequest = new AbortController();

      try {
        const response = await fetch(url, {
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
          },
          signal: activeCollectionRequest.signal,
        });

        if (!response.ok) {
          throw new Error(`Collection update failed: ${response.status}`);
        }

        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const nextCollectionFilters = doc.querySelector('.collection-filters');
        const nextCollectionProducts = doc.querySelector('.collection-products');
        const nextActiveFiltersWrapper = doc.querySelector('.collection-active-filters-wrapper');
        const nextProductCounts = doc.querySelectorAll('.collection-product-count');
        const currentCollectionFilters = document.querySelector('.collection-filters');
        const currentProductCounts = document.querySelectorAll('.collection-product-count');

        if (nextCollectionFilters && currentCollectionFilters) {
          currentCollectionFilters.replaceWith(nextCollectionFilters);
        }

        if (nextCollectionProducts) {
          collectionProducts.innerHTML = nextCollectionProducts.innerHTML;
        }

        if (nextProductCounts.length) {
          currentProductCounts.forEach((countEl, index) => {
            const nextCount = nextProductCounts[index] || nextProductCounts[0];

            if (nextCount) {
              countEl.innerHTML = nextCount.innerHTML;
            }
          });

          if (currentProductCounts.length < nextProductCounts.length) {
            const container =
              document.querySelector('.collection-filters') || document.querySelector('.collection-toolbar');

            if (container) {
              nextProductCounts.forEach((nextCount, index) => {
                if (index >= currentProductCounts.length) {
                  container.insertAdjacentHTML('beforeend', nextCount.outerHTML);
                }
              });
            }
          }
        }

        if (nextActiveFiltersWrapper) {
          const currentActiveFiltersWrapper = document.querySelector('.collection-active-filters-wrapper');

          if (currentActiveFiltersWrapper) {
            currentActiveFiltersWrapper.replaceWith(nextActiveFiltersWrapper);
          } else {
            document.querySelector('.collection-filters')?.append(nextActiveFiltersWrapper);
          }
        } else {
          const currentActiveFiltersWrapper = document.querySelector('.collection-active-filters-wrapper');

          if (currentActiveFiltersWrapper) {
            currentActiveFiltersWrapper.remove();
          }
        }

        setupCollectionFilterInteractions();
        window.history.pushState({ path: url }, '', url);
      } catch (error) {
        if (error.name === 'AbortError') {
          return;
        }

        console.error(error);
        window.location.assign(document.querySelector('.collection-filters')?.action || window.location.href);
      } finally {
        if (activeCollectionRequest && activeCollectionRequest.signal.aborted) {
          activeCollectionRequest = null;
        } else {
          activeCollectionRequest = null;
        }
      }
    };

    if (document.body.dataset.collectionFilterHandlersBound === 'true') {
      return;
    }

    document.body.dataset.collectionFilterHandlersBound = 'true';

    document.addEventListener('submit', (event) => {
      const form = event.target;

      if (!(form instanceof HTMLFormElement) || !form.matches('.collection-filters')) {
        return;
      }

      event.preventDefault();
      updateCollectionProducts(getFilteredCollectionUrl(form));
    });

    document.addEventListener('change', (event) => {
      const target = event.target;

      if (!(target instanceof HTMLElement) || !target.matches('input, select')) {
        return;
      }

      const form = target.closest('.collection-filters');

      if (!form) {
        return;
      }

      updateCollectionProducts(getFilteredCollectionUrl(form));
    });

    document.addEventListener('click', (event) => {
      const closeButton = event.target.closest('.collection-toolbar-close');

      if (closeButton) {
        const toolbarDetails = closeButton.closest('.collection-toolbar-details');

        if (toolbarDetails) {
          toolbarDetails.removeAttribute('open');
        }

        return;
      }

      const activeFilterLink = event.target.closest('.collection-active-filter');

      if (activeFilterLink) {
        event.preventDefault();
        updateCollectionProducts(activeFilterLink.href);
        return;
      }

      const clearLink = event.target.closest('.collection-active-filters-clear');

      if (!clearLink) {
        return;
      }

      event.preventDefault();
      updateCollectionProducts(clearLink.href);
    });
  };

  setupCollectionFilterInteractions();
{% endjavascript %}
