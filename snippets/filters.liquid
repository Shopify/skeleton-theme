{% assign visible_product_count = collection.products_count | default: collection.products.size %}
{% assign total_product_count = collection.all_products_count | default: visible_product_count %}

<div class="collection-toolbar">
  {% if collection.filters != empty or collection.sort_options.size > 0 %}
    {% assign active_filter_count = 0 %}
    {% for filter in collection.filters %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
    {% endfor %}

    <form class="collection-filters" action="{{ collection.url }}" method="get">
      <div class="collection-filters-wrap">
        {% if collection.filters != empty %}
          <header class="collection-filters-header">
            <h2 class="collection-filters-heading">Filter:</h2>

            {% comment %}
              {% if active_filter_count > 0 %}
                <a href="{{ collection.url }}" class="collection-filters-clear">Clear all</a>
              {% endif %}
            {% endcomment %}
          </header>

          {% for filter in collection.filters %}
            <details class="collection-filter">
              <summary>
                {{ filter.label }}
                {{ 'icon-dropdown.svg' | inline_asset_content }}
              </summary>

              <div class="collection-filter-content">
                {% case filter.type %}
                  {% when 'list', 'boolean' %}
                    <ul class="collection-filter-values list-reset" role="list">
                      {% for filter_value in filter.values %}
                        <li>
                          <label class="collection-filter-value {% if filter_value.count == 0 and filter_value.active == false %}is-disabled{% endif %} {% if filter_value.swatch != blank %}is-color-value{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ filter_value.param_name }}"
                              value="{{ filter_value.value }}"
                              {% if filter_value.active %}
                                checked
                              {% endif %}
                              {% if filter_value.count == 0 and filter_value.active == false %}
                                disabled
                              {% endif %}
                            >

                            {% if filter_value.swatch != blank %}
                              {% if filter_value.swatch.image != blank %}
                                <span
                                  class="collection-filter-swatch"
                                  style="background-image: url('{{ filter_value.swatch.image | image_url: width: 32 }}');"
                                ></span>
                              {% elsif filter_value.swatch.color != blank %}
                                <span
                                  class="collection-filter-swatch"
                                  style="background-color: {{ filter_value.swatch.color }};"
                                ></span>
                              {% endif %}
                            {% endif %}

                            <span class="collection-filter-value-label">{{ filter_value.label }}</span>
                            <span class="collection-filter-value-count">({{ filter_value.count }})</span>
                          </label>
                        </li>
                      {% endfor %}
                    </ul>

                  {% when 'price_range' %}
                    {% assign min_value = filter.min_value.value
                      | money_without_currency
                      | replace: ',', ''
                      | default: '0'
                    %}
                    {% assign max_value = filter.max_value.value
                      | money_without_currency
                      | replace: ',', ''
                      | default: filter.range_max
                      | money_without_currency
                      | replace: ',', ''
                    %}
                    {% assign slider_min = filter.range_min
                      | money_without_currency
                      | replace: ',', ''
                      | default: '0'
                    %}
                    {% assign slider_max = filter.range_max
                      | money_without_currency
                      | replace: ',', ''
                      | default: '100'
                    %}

                    <div
                      class="collection-filter-price-range"
                      data-range-min="{{ slider_min }}"
                      data-range-max="{{ slider_max }}"
                    >
                      <div class="collection-filter-price-range-inputs">
                        <label>
                          <span>From</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ min_value }}"
                            min="{{ slider_min }}"
                            max="{{ slider_max }}"
                            placeholder="{{ slider_min }}"
                            class="collection-price-input collection-price-input-min"
                          >
                        </label>

                        <span class="collection-filter-price-range-separator">-</span>

                        <label>
                          <span>To</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ max_value }}"
                            min="{{ slider_min }}"
                            max="{{ slider_max }}"
                            placeholder="{{ slider_max }}"
                            class="collection-price-input collection-price-input-max"
                          >
                        </label>
                      </div>

                      <div class="collection-price-slider">
                        <div class="collection-price-track">
                          <div class="collection-price-range-line"></div>
                        </div>

                        <input
                          type="range"
                          min="{{ slider_min }}"
                          max="{{ slider_max }}"
                          value="{{ min_value }}"
                          step="1"
                          class="collection-price-range-slider collection-price-range-slider-min"
                          aria-label="Minimum price"
                        >
                        <input
                          type="range"
                          min="{{ slider_min }}"
                          max="{{ slider_max }}"
                          value="{{ max_value }}"
                          step="1"
                          class="collection-price-range-slider collection-price-range-slider-max"
                          aria-label="Maximum price"
                        >
                      </div>
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}
        {% endif %}
      </div>
      {% assign has_active_filters = false %}
      {% for filter in collection.filters %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value != blank %}
            {% assign has_active_filters = true %}
          {% elsif filter.max_value.value != blank %}
            {% assign has_active_filters = true %}
          {% endif %}
        {% elsif filter.active_values.size > 0 %}
          {% assign has_active_filters = true %}
        {% endif %}
      {% endfor %}

      <div class="collection-sort-wrap">
        {% if collection.sort_options.size > 0 %}
          <label class="collection-sort">
            <span class="collection-sort-label">Sort by</span>
            <select name="sort_by" aria-label="Sort by">
              {% for option in collection.sort_options %}
                <option
                  value="{{ option.value }}"
                  {% if option.value == collection.sort_by %}
                    selected
                  {% endif %}
                >
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endif %}
        {% if visible_product_count > 0 %}
          <div class="collection-product-count">{{ visible_product_count }} of {{ total_product_count }} products</div>
        {% endif %}
      </div>
      {% if has_active_filters %}
        <div class="collection-active-filters-wrapper">
          <div class="collection-active-filters" aria-label="Active filters">
            {% for filter in collection.filters %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != blank %}
                  <a class="collection-active-filter" href="{{ filter.url_to_remove | default: collection.url }}">
                    <span>
                      {% if filter.max_value.value != blank %}
                        {{ filter.min_value.value | money }} – {{ filter.max_value.value | money }}
                      {% else %}
                        {{ filter.min_value.value | money }}+
                      {% endif %}
                    </span>
                    <span aria-hidden="true">×</span>
                  </a>
                {% elsif filter.max_value.value != blank %}
                  <a class="collection-active-filter" href="{{ filter.url_to_remove | default: collection.url }}">
                    <span>Up to {{ filter.max_value.value | money }}</span>
                    <span aria-hidden="true">×</span>
                  </a>
                {% endif %}
              {% else %}
                {% for filter_value in filter.active_values %}
                  <a class="collection-active-filter" href="{{ filter_value.url_to_remove | default: collection.url }}">
                    <span>{{ filter_value.label }}</span>
                    <span aria-hidden="true">×</span>
                  </a>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>

          <a class="collection-active-filters-clear" href="{{ collection.url }}">Remove all</a>
        </div>
      {% endif %}
    </form>
  {% endif %}
</div>

{% stylesheet %}
  .collection-toolbar {
    margin-block: 1.5rem;
  }

  .collection-filters {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr 1fr;
    justify-content: space-between;
  }

  .collection-filters-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .collection-active-filters-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .collection-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-active-filters-clear {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .collection-active-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    text-decoration: none;
    font-size: 1.4rem;
    line-height: 1;
  }

  .collection-active-filter span:last-child {
    font-size: 1.6rem;
    line-height: 1;
  }

  .collection-sort-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .collection-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    font-size: 1.4rem;
  }

  .collection-sort-label {
    white-space: nowrap;
  }

  .collection-sort select {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .collection-filters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .collection-filters-heading {
    margin: 0;
    font-size: 1.4rem;
  }

  .collection-filters-clear {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .collection-filter {
    position: relative;
  }

  .collection-filter summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    padding-block: 0.875rem;
    font-size: 1.4rem;
    line-height: 1;
  }

  .collection-filter .icon-dropdown {
    width: 1rem;
    height: 0.6rem;
    position: relative;
    top: 0.1rem;
  }

  .collection-filter-content {
    padding: 1rem;
    position: absolute;
    left: 0;
    top: 100%;
    width: 35rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .collection-filter-values {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .collection-filter-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .collection-filter-value.is-disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .collection-filter-value input {
    margin: 0;
  }

  .collection-filter-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background-position: center;
    background-size: cover;
    display: inline-block;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .collection-filter-value.is-color-value {
    justify-content: flex-start;
  }

  .collection-filter-value.is-color-value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .collection-filter-value.is-color-value .collection-filter-value-label,
  .collection-filter-value.is-color-value .collection-filter-value-count {
    display: block;
    font-size: 1.1rem;
    line-height: 1.2;
    text-align: center;
  }

  .collection-filter-value.is-color-value .collection-filter-value-count {
    opacity: 0.7;
  }

  .collection-filter-value.is-color-value .collection-filter-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-color: rgba(0, 0, 0, 0.15);
  }

  .collection-filter-value.is-color-value input:checked + .collection-filter-swatch,
  .collection-filter-value.is-color-value input:focus-visible + .collection-filter-swatch {
    outline: 0.1rem solid var(--color-foreground);
    outline-offset: 0.1rem;
  }

  .collection-filter-value.is-color-value input:disabled + .collection-filter-swatch {
    opacity: 0.2;
  }

  .collection-filter-value-count {
    opacity: 0.7;
  }

  .collection-filter-price-range {
    display: grid;
    gap: 1rem;
  }

  .collection-filter-price-range-inputs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 0.75rem;
  }

  .collection-filter-price-range label {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .collection-filter-price-range-separator {
    display: grid;
    place-items: center;
    padding-bottom: 0.75rem;
    font-size: 1.8rem;
    line-height: 1;
    opacity: 0.8;
  }

  .collection-filter-price-range input[type='number'] {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .collection-price-slider {
    position: relative;
    height: 2.5rem;
    display: grid;
    align-items: center;
  }

  .collection-price-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 0.25rem;
    transform: translateY(-50%);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
  }

  .collection-price-range-line {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-foreground);
    transform-origin: left center;
  }

  .collection-price-range-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
    z-index: 1;
  }

  .collection-price-range-slider-max {
    z-index: 2;
  }

  .collection-price-range-slider::-webkit-slider-runnable-track {
    height: 0.25rem;
    background: transparent;
  }

  .collection-price-range-slider::-moz-range-track {
    height: 0.25rem;
    background: transparent;
  }

  .collection-price-range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-background);
    background: var(--color-foreground);
    margin-top: -0.625rem;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    transform: translateX(-50%);
  }

  .collection-price-range-slider-max::-webkit-slider-thumb {
    transform: translateX(50%);
  }

  .collection-price-range-slider::-moz-range-thumb {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-background);
    background: var(--color-foreground);
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    transform: translateX(-50%);
  }

  .collection-price-range-slider-max::-moz-range-thumb {
    transform: translateX(50%);
  }

  .collection-filters-apply {
    justify-self: start;
    padding: 0.625rem 1rem;
    border: 1px solid;
    color: white;
    cursor: pointer;
  }
{% endstylesheet %}

{% javascript %}
  const setupCollectionFilterInteractions = () => {
    const filterGroups = document.querySelectorAll('.collection-filter');

    filterGroups.forEach((group) => {
      if (group.dataset.collectionFilterBound === 'true') {
        return;
      }

      group.dataset.collectionFilterBound = 'true';
      group.addEventListener('toggle', () => {
        if (!group.open) return;

        filterGroups.forEach((otherGroup) => {
          if (otherGroup !== group) {
            otherGroup.removeAttribute('open');
          }
        });
      });
    });

    const collectionFiltersForm = document.querySelector('.collection-filters');
    const collectionProducts = document.querySelector('.collection-products');
    const collectionClearAllLink = document.querySelector('.collection-active-filters-clear');

    if (!collectionFiltersForm || !collectionProducts) {
      return;
    }

    if (collectionFiltersForm.dataset.collectionBound === 'true') {
      return;
    }

    collectionFiltersForm.dataset.collectionBound = 'true';

    const getFilteredCollectionUrl = (form) => {
      const params = new URLSearchParams();
      const formData = new FormData(form);

      formData.forEach((value, key) => {
        if (String(value).trim() !== '') {
          params.append(key, String(value));
        }
      });

      const url = new URL(form.action || window.location.href, window.location.origin);
      url.search = params.toString();
      return url.toString();
    };

    const syncPriceRangeSlider = (group) => {
      const minInput = group.querySelector('.collection-price-input-min');
      const maxInput = group.querySelector('.collection-price-input-max');
      const minSlider = group.querySelector('.collection-price-range-slider-min');
      const maxSlider = group.querySelector('.collection-price-range-slider-max');
      const rangeLine = group.querySelector('.collection-price-range-line');

      if (!minInput || !maxInput || !minSlider || !maxSlider || !rangeLine) {
        return;
      }

      const min = Number(group.dataset.rangeMin || 0);
      const max = Number(group.dataset.rangeMax || 100);

      if (!minInput.value && !maxInput.value) {
        minInput.value = min;
        maxInput.value = max;
      }

      const minValue = Math.min(Number(minInput.value || min), Number(maxInput.value || max));
      const maxValue = Math.max(Number(minInput.value || min), Number(maxInput.value || max));

      const leftPercent = ((Math.min(Math.max(minValue, min), max) - min) / (max - min || 1)) * 100;
      const rightPercent = ((Math.min(Math.max(maxValue, min), max) - min) / (max - min || 1)) * 100;

      minSlider.value = Math.min(minValue, maxValue);
      maxSlider.value = Math.max(minValue, maxValue);
      minInput.value = minSlider.value;
      maxInput.value = maxSlider.value;
      rangeLine.style.left = `${leftPercent}%`;
      rangeLine.style.width = `${Math.max(rightPercent - leftPercent, 0)}%`;
    };

    document.querySelectorAll('.collection-filter-price-range').forEach((group) => {
      const minInput = group.querySelector('.collection-price-input-min');
      const maxInput = group.querySelector('.collection-price-input-max');
      const minSlider = group.querySelector('.collection-price-range-slider-min');
      const maxSlider = group.querySelector('.collection-price-range-slider-max');

      [minInput, maxInput].forEach((input) => {
        input.addEventListener('input', () => {
          const minValue = Number(minInput.value || 0);
          const maxValue = Number(maxInput.value || 0);

          if (minValue > maxValue) {
            if (document.activeElement === minInput) {
              maxInput.value = minInput.value;
            } else {
              minInput.value = maxInput.value;
            }
          }

          syncPriceRangeSlider(group);
        });
      });

      [minSlider, maxSlider].forEach((slider) => {
        slider.addEventListener('input', () => {
          const minValue = Number(minSlider.value || 0);
          const maxValue = Number(maxSlider.value || 0);

          if (minValue > maxValue) {
            if (slider === minSlider) {
              maxSlider.value = minSlider.value;
            } else {
              minSlider.value = maxSlider.value;
            }
          }

          minInput.value = minSlider.value;
          maxInput.value = maxSlider.value;
          syncPriceRangeSlider(group);
        });
      });

      syncPriceRangeSlider(group);
    });

    let activeCollectionRequest = null;

    const updateCollectionProducts = async (url) => {
      if (activeCollectionRequest) {
        activeCollectionRequest.abort();
      }

      activeCollectionRequest = new AbortController();

      try {
        const response = await fetch(url, {
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
          },
          signal: activeCollectionRequest.signal,
        });

        if (!response.ok) {
          throw new Error(`Collection update failed: ${response.status}`);
        }

        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const nextCollectionProducts = doc.querySelector('.collection-products');
        const nextActiveFiltersWrapper = doc.querySelector('.collection-active-filters-wrapper');

        if (nextCollectionProducts) {
          collectionProducts.innerHTML = nextCollectionProducts.innerHTML;
        }

        if (nextActiveFiltersWrapper) {
          const currentActiveFiltersWrapper = document.querySelector('.collection-active-filters-wrapper');

          if (currentActiveFiltersWrapper) {
            currentActiveFiltersWrapper.replaceWith(nextActiveFiltersWrapper);
          } else {
            collectionFiltersForm.append(nextActiveFiltersWrapper);
          }
        } else {
          const currentActiveFiltersWrapper = document.querySelector('.collection-active-filters-wrapper');

          if (currentActiveFiltersWrapper) {
            currentActiveFiltersWrapper.remove();
          }
        }

        window.history.pushState({ path: url }, '', url);
      } catch (error) {
        if (error.name === 'AbortError') {
          return;
        }

        console.error(error);
        window.location.assign(collectionFiltersForm.action);
      } finally {
        if (activeCollectionRequest && activeCollectionRequest.signal.aborted) {
          activeCollectionRequest = null;
        } else {
          activeCollectionRequest = null;
        }
      }
    };

    collectionFiltersForm.addEventListener('submit', (event) => {
      event.preventDefault();

      const url = getFilteredCollectionUrl(event.currentTarget);

      updateCollectionProducts(url);
    });

    collectionFiltersForm.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLElement)) {
        return;
      }

      if (!event.target.matches('input, select')) {
        return;
      }

      const url = getFilteredCollectionUrl(event.currentTarget);

      updateCollectionProducts(url);
    });

    if (collectionClearAllLink) {
      collectionClearAllLink.addEventListener('click', (event) => {
        event.preventDefault();

        updateCollectionProducts(collectionClearAllLink.href);
      });
    }
  };

  setupCollectionFilterInteractions();
{% endjavascript %}
