<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variants (body + heading base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% unless settings.type_primary_font.system? %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% render 'announcement-bar' %}

    <div class="block-container site-header-wrapper">
      {% render 'header' %}
    </div>

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div class="block-container site-footer-wrapper">
      {% render 'footer' %}
    </div>

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
