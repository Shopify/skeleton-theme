{% layout 'password' %}

{% block 'container', alignment: 'center', class: 'password-container' %}
  <div class="password">
    {%- if settings.logo_stacked -%}
      {{ settings.logo_stacked | image_url: width: 640 | image_tag: alt: shop.name, class: 'password__logo', loading: 'eager' }}
    {%- else -%}
      <p class="site-header__wordmark">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="page-title">{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p>{{ shop.password_message }}</p>
    {% endif %}

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {% if form.posted_successfully? %}
        <p class="form-message" role="status">{{ 'footer.newsletter_success' | t }}</p>
      {% else %}
        <div class="newsletter-form__field">
          <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'footer.newsletter_email' | t }}</label>
          <input id="PasswordNewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'footer.newsletter_email' | t }}" required>
          <button type="submit" class="button">{{ 'password.notify' | t }}</button>
        </div>
      {% endif %}
    {% endform %}

    <details class="password__login">
      <summary>{{ 'password.owner' | t }}</summary>
      {% form 'storefront_password' %}
        {% if form.errors %}
          {{ form.errors | default_errors }}
        {% endif %}

        <label for="password-input">
          {{ 'password.password' | t }}
        </label>
        <div class="newsletter-form__field">
          <input type="password" name="password" id="password-input">
          <button type="submit" class="button button--outline">
            {{ 'password.enter' | t }}
          </button>
        </div>
      {% endform %}
    </details>
  </div>
{% endblock %}
