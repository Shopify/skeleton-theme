{{ 'skin-lab.css' | asset_url | stylesheet_tag }}

<section class="block-container block-container--flush">
  <div
    class="hero full-width hero--{{ settings.hero_text_tone }}{% if settings.hero_image %} hero--has-image{% endif %}"
  >
    {%- if settings.hero_image -%}
      <div class="hero__media">
        {{
          settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1800, 2400',
            sizes: '100vw',
            alt: settings.hero_image.alt
        }}
      </div>
    {%- elsif settings.logo_mark -%}
      <div class="hero__mark" aria-hidden="true">
        {{ settings.logo_mark | image_url: width: 900 | image_tag: alt: '', loading: 'eager' }}
      </div>
    {%- endif -%}

    <div class="hero__content">
      <p class="eyebrow">{{ 'home.hero.eyebrow' | t }}</p>
      <h1 class="hero__title">{{ 'home.hero.title' | t }}</h1>
      <p class="hero__text">{{ 'home.hero.text' | t }}</p>
      <div class="button-row">
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.hero.primary_cta' | t }}</a>
        <a class="button button--outline" href="#quiz">{{ 'home.hero.quiz_cta' | t }}</a>
      </div>
    </div>
  </div>
</section>

<section class="block-container concerns-strip">
  <nav class="concerns" aria-label="{{ 'home.concerns.label' | t }}">
    <p class="concerns__label">{{ 'home.concerns.label' | t }}</p>
    <ul role="list">
      <li><a href="{{ routes.search_url }}?q=hyaluronic&type=product">{{ 'home.concerns.hydration' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=vitamin+c&type=product">{{ 'home.concerns.brightening' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=niacinamide&type=product">{{ 'home.concerns.pores' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=retinol&type=product">{{ 'home.concerns.ageing' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=barrier&type=product">{{ 'home.concerns.barrier' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=clarifying&type=product">{{ 'home.concerns.tone' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=rice&type=product">{{ 'home.concerns.dullness' | t }}</a></li>
    </ul>
  </nav>
</section>

<section class="block-container personal" data-personal hidden>
  <div class="personal__header">
    <div>
      <p class="eyebrow">{{ 'personal.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'personal.title' | t }}</h2>
      <p class="personal__summary" data-personal-summary></p>
    </div>
    <div class="button-row">
      <a class="button button--outline" href="#regimen">{{ 'personal.open_builder' | t }}</a>
      <a class="link-button" href="#quiz" data-quiz-restart>{{ 'personal.retake' | t }}</a>
    </div>
  </div>
  <ul class="mini-grid" role="list" data-personal-list></ul>
</section>

<section class="block-container">
  {%- liquid
    assign grid_eyebrow = 'home.collection.eyebrow' | t
    assign grid_heading = 'home.collection.title' | t
  -%}
  {% render 'product-grid',
    collection: settings.home_collection,
    limit: 8,
    eyebrow: grid_eyebrow,
    heading: grid_heading,
    show_view_all: true
  %}
</section>

<section class="block-container tone-inverse skin-lab-section" id="quiz">
  <div
    class="skin-lab"
    data-quiz
    data-label-added="{{ 'quiz.lab_added' | t | escape }}"
    data-label-empty="{{ 'quiz.lab_empty' | t | escape }}"
    data-label-brewing="{{ 'quiz.lab_brewing' | t | escape }}"
    data-label-ready="{{ 'quiz.lab_ready' | t | escape }}"
    data-label-targets="{{ 'quiz.lab_targets' | t | escape }}"
    data-label-support="{{ 'quiz.lab_support' | t | escape }}"
    data-label-compatible="{{ 'quiz.lab_compatible' | t | escape }}"
    hidden
  >
    <div class="skin-lab__intro">
      <p class="eyebrow">{{ 'quiz.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'quiz.title' | t }}</h2>
      <p>{{ 'quiz.intro' | t }}</p>
    </div>

    <div class="skin-lab__bench">
      <div class="skin-lab__stage" data-lab-stage>
        <svg class="skin-lab__bonds" data-lab-bonds aria-hidden="true"></svg>

        <div class="skin-lab__flask" data-lab-flask aria-hidden="true">
          <div class="skin-lab__liquid" data-lab-liquid>
            <span class="skin-lab__layer" data-lab-layer></span>
            <span class="skin-lab__layer" data-lab-layer></span>
            <span class="skin-lab__layer" data-lab-layer></span>
            <i></i><i></i><i></i><i></i><i></i>
          </div>
          {%- if settings.logo_mark -%}
            {{ settings.logo_mark | image_url: width: 240 | image_tag: alt: '', class: 'skin-lab__mark', loading: 'lazy' }}
          {%- endif -%}
          <span class="skin-lab__ring"></span>
          <span class="skin-lab__burst" data-lab-burst></span>
        </div>
        <div class="skin-lab__particles" data-lab-particles aria-hidden="true"></div>

        <form class="skin-lab__form" data-quiz-form novalidate>
          <fieldset class="skin-lab__step" data-quiz-step>
            <legend class="skin-lab__question">
              <span class="skin-lab__count">1 / 3</span>
              {{ 'quiz.q_concern' | t }}
            </legend>
            <div class="skin-lab__orbs skin-lab__orbs--8">
            <label class="skin-lab__orb" style="--orb-color: #5DB3E6; --i: 0; --n: 8;">
              <input type="radio" name="concern" value="hydration" required>
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_hydration' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_hydration' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #F4E604; --i: 1; --n: 8;">
              <input type="radio" name="concern" value="brightness">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_brightness' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_brightness' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #F0954A; --i: 2; --n: 8;">
              <input type="radio" name="concern" value="dark_spots">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_dark_spots' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_dark_spots' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #6BC48C; --i: 3; --n: 8;">
              <input type="radio" name="concern" value="pores">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_pores' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_pores' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #E0475A; --i: 4; --n: 8;">
              <input type="radio" name="concern" value="fine_lines">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_fine_lines' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_fine_lines' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #F29BC0; --i: 5; --n: 8;">
              <input type="radio" name="concern" value="barrier">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_barrier' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_barrier' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #B9A6F0; --i: 6; --n: 8;">
              <input type="radio" name="concern" value="tone">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_tone' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_tone' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #9ED6C4; --i: 7; --n: 8;">
              <input type="radio" name="concern" value="texture">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_texture' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.concern_texture' | t }}</span>
              </span>
            </label>
            </div>
          </fieldset>

          <fieldset class="skin-lab__step" data-quiz-step hidden>
            <legend class="skin-lab__question">
              <span class="skin-lab__count">2 / 3</span>
              {{ 'quiz.q_sensitive' | t }}
            </legend>
            <div class="skin-lab__orbs skin-lab__orbs--2">
            <label class="skin-lab__orb" style="--orb-color: #F29BC0; --i: 0; --n: 2;">
              <input type="radio" name="sensitive" value="yes" required>
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_sensitive_yes' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.sensitive_yes' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #6BC48C; --i: 1; --n: 2;">
              <input type="radio" name="sensitive" value="no">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_sensitive_no' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.sensitive_no' | t }}</span>
              </span>
            </label>
            </div>
          </fieldset>

          <fieldset class="skin-lab__step" data-quiz-step hidden>
            <legend class="skin-lab__question">
              <span class="skin-lab__count">3 / 3</span>
              {{ 'quiz.q_time' | t }}
            </legend>
            <div class="skin-lab__orbs skin-lab__orbs--3">
            <label class="skin-lab__orb" style="--orb-color: #F4E604; --i: 0; --n: 3;">
              <input type="radio" name="time" value="am" required>
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_time_am' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.time_am' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #7B7FD6; --i: 1; --n: 3;">
              <input type="radio" name="time" value="pm">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_time_pm' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.time_pm' | t }}</span>
              </span>
            </label>
            <label class="skin-lab__orb" style="--orb-color: #DFAB52; --i: 2; --n: 3;">
              <input type="radio" name="time" value="both">
              <span class="skin-lab__tile">
                <span class="skin-lab__symbol">{{ 'quiz.symbol_time_both' | t }}</span>
                <span class="skin-lab__name">{{ 'quiz.time_both' | t }}</span>
              </span>
            </label>
            </div>
          </fieldset>

          <p class="skin-lab__error" role="alert" data-quiz-error hidden>{{ 'quiz.choose_one' | t }}</p>

          <div class="skin-lab__nav">
            <button type="button" class="link-button" data-quiz-back hidden>{{ 'quiz.back' | t }}</button>
            <button type="submit" class="button button--small" data-quiz-next data-label-next="{{ 'quiz.next' | t }}" data-label-finish="{{ 'quiz.finish' | t }}">
              {{- 'quiz.next' | t -}}
            </button>
          </div>
        </form>
      </div>

      <aside class="skin-lab__notes" aria-labelledby="SkinLabNotesTitle">
        <h3 class="skin-lab__notes-title" id="SkinLabNotesTitle">{{ 'quiz.lab_notes' | t }}</h3>
        <p class="skin-lab__status" role="status" data-lab-status>{{ 'quiz.lab_empty' | t }}</p>
        <p class="skin-lab__formula-label">{{ 'quiz.lab_formula' | t }}</p>
        <ol class="skin-lab__formula" role="list" data-lab-formula></ol>
      </aside>
    </div>

    <div class="skin-lab__result" data-quiz-result hidden tabindex="-1">
      <div class="skin-lab__result-header">
        <div>
          <p class="eyebrow">{{ 'quiz.result_eyebrow' | t }}</p>
          <h3 class="skin-lab__result-title">
            {{ 'quiz.result_title' | t }}
            <span class="skin-lab__code" data-lab-code></span>
          </h3>
        </div>
        <button type="button" class="link-button" data-quiz-restart>{{ 'quiz.restart' | t }}</button>
      </div>
      <p class="skin-lab__result-note" data-quiz-note></p>
      <ul class="mini-grid" role="list" data-quiz-list></ul>
      <p class="skin-lab__check" data-lab-check></p>
      <div class="button-row">
        <button type="button" class="button" data-quiz-add>{{ 'quiz.add_all' | t }}</button>
        <a class="button button--outline" href="#regimen">{{ 'quiz.see_routine' | t }}</a>
      </div>
    </div>
  </div>
  <noscript>
    <div class="skin-lab__intro">
      <h2 class="section-title">{{ 'quiz.title' | t }}</h2>
      <p>{{ 'quiz.no_script' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.hero.primary_cta' | t }}</a>
    </div>
  </noscript>
</section>

<section class="block-container tone-surface">
  <div class="brand-story">
    <div class="clover" aria-hidden="true">
      <span class="clover__label">{{ 'home.story.shape_label' | t }}</span>
    </div>
    <div class="brand-story__copy">
      <p class="eyebrow">{{ 'home.story.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'home.story.title' | t }}</h2>
      <p>{{ 'home.story.body' | t }}</p>
      <ul class="pillars" role="list">
        <li>{{ 'home.story.pillar_powerful' | t }}</li>
        <li>{{ 'home.story.pillar_potential' | t }}</li>
        <li>{{ 'home.story.pillar_hydrate' | t }}</li>
        <li>{{ 'home.story.pillar_empower' | t }}</li>
        <li>{{ 'home.story.pillar_rejuvenate' | t }}</li>
        <li>{{ 'home.story.pillar_natural' | t }}</li>
      </ul>
    </div>
  </div>
</section>

<section class="block-container">
  <div class="regimen" id="regimen">
    <div class="regimen__intro">
      <p class="eyebrow">{{ 'home.regimen.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'home.regimen.title' | t }}</h2>
      <p>{{ 'home.regimen.body' | t }}</p>
    </div>

    <ol class="regimen__steps" role="list">
      <li>
        <span class="regimen__number">01</span>
        <h3>{{ 'home.regimen.step_1_title' | t }}</h3>
        <p>{{ 'home.regimen.step_1_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">02</span>
        <h3>{{ 'home.regimen.step_2_title' | t }}</h3>
        <p>{{ 'home.regimen.step_2_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">03</span>
        <h3>{{ 'home.regimen.step_3_title' | t }}</h3>
        <p>{{ 'home.regimen.step_3_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">04</span>
        <h3>{{ 'home.regimen.step_4_title' | t }}</h3>
        <p>{{ 'home.regimen.step_4_body' | t }}</p>
      </li>
    </ol>

    <div class="builder" data-routine-builder hidden>
      <h3 class="pairing__title">{{ 'routine.title' | t }}</h3>
      <p class="builder__intro">{{ 'routine.intro' | t }}</p>
      <div class="builder__picker" role="group" aria-label="{{ 'routine.pick_label' | t }}" data-builder-picker></div>

      <div class="builder__output" aria-live="polite">
        <div class="builder__col">
          <h4 class="builder__heading">{{ 'routine.am' | t }}</h4>
          <ol class="builder__steps" data-builder-am></ol>
        </div>
        <div class="builder__col builder__col--pm">
          <h4 class="builder__heading">{{ 'routine.pm' | t }}</h4>
          <ol class="builder__steps" data-builder-pm></ol>
        </div>
      </div>
      <div class="builder__alternate" data-builder-alternate hidden>
        <h4 class="builder__heading">{{ 'routine.alternate_title' | t }}</h4>
        <ul class="builder__steps" role="list"></ul>
      </div>
      <ul class="builder__notes" role="list" data-builder-notes></ul>

      <div class="button-row">
        <button type="button" class="button" data-builder-add disabled>{{ 'routine.add_routine' | t }}</button>
        <button type="button" class="button button--outline" data-builder-share>{{ 'routine.share' | t }}</button>
        <button type="button" class="link-button" data-builder-clear>{{ 'routine.clear' | t }}</button>
      </div>
      <p class="builder__status" role="status" data-builder-status></p>
    </div>

    <details class="pairing" open data-pairing-table>
      <summary class="pairing__title">{{ 'home.pairing.title' | t }}</summary>
      <table class="pairing__table">
        <thead>
          <tr>
            <th scope="col">{{ 'home.pairing.col_serum' | t }}</th>
            <th scope="col">{{ 'home.pairing.col_when' | t }}</th>
            <th scope="col">{{ 'home.pairing.col_avoid' | t }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ 'home.pairing.vitamin_c' | t }}</th>
            <td>{{ 'home.pairing.am' | t }}</td>
            <td>{{ 'home.pairing.vitamin_c_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.retinol' | t }}</th>
            <td>{{ 'home.pairing.pm' | t }}</td>
            <td>{{ 'home.pairing.retinol_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.niacinamide' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.niacinamide_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.hyaluronic' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.none' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.snail' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.snail_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.rice' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.rice_note' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.barrier' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.barrier_note' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.clarifying' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.clarifying_note' | t }}</td>
          </tr>
        </tbody>
      </table>
      <p class="pairing__note">{{ 'home.pairing.note' | t }}</p>
    </details>
  </div>
</section>

<section class="block-container" data-recently-viewed hidden>
  <div class="personal__header">
    <h2 class="section-title">{{ 'personal.recently_viewed' | t }}</h2>
  </div>
  <ul class="mini-grid" role="list" data-recently-list></ul>
</section>

<section class="block-container tone-inverse">
  <ul class="promises" role="list">
    <li>
      <h3>{{ 'home.promises.origin_title' | t }}</h3>
      <p>{{ 'home.promises.origin_body' | t }}</p>
    </li>
    <li>
      <h3>{{ 'home.promises.inci_title' | t }}</h3>
      <p>{{ 'home.promises.inci_body' | t }}</p>
    </li>
    <li>
      <h3>{{ 'home.promises.directions_title' | t }}</h3>
      <p>{{ 'home.promises.directions_body' | t }}</p>
    </li>
  </ul>
</section>
