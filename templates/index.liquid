<section class="block-container block-container--flush">
  <div
    class="hero full-width hero--{{ settings.hero_text_tone }}{% if settings.hero_image %} hero--has-image{% endif %}"
  >
    {%- if settings.hero_image -%}
      <div class="hero__media">
        {{
          settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1800, 2400',
            sizes: '100vw',
            alt: settings.hero_image.alt
        }}
      </div>
    {%- elsif settings.logo_mark -%}
      <div class="hero__mark" aria-hidden="true">
        {{ settings.logo_mark | image_url: width: 900 | image_tag: alt: '', loading: 'eager' }}
      </div>
    {%- endif -%}

    <div class="hero__content">
      <p class="eyebrow">{{ 'home.hero.eyebrow' | t }}</p>
      <h1 class="hero__title">{{ 'home.hero.title' | t }}</h1>
      <p class="hero__text">{{ 'home.hero.text' | t }}</p>
      <div class="button-row">
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.hero.primary_cta' | t }}</a>
        <a class="button button--outline" href="#quiz">{{ 'home.hero.quiz_cta' | t }}</a>
      </div>
    </div>
  </div>
</section>

<section class="block-container concerns-strip">
  <nav class="concerns" aria-label="{{ 'home.concerns.label' | t }}">
    <p class="concerns__label">{{ 'home.concerns.label' | t }}</p>
    <ul role="list">
      <li><a href="{{ routes.search_url }}?q=hyaluronic&type=product">{{ 'home.concerns.hydration' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=vitamin+c&type=product">{{ 'home.concerns.brightening' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=niacinamide&type=product">{{ 'home.concerns.pores' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=retinol&type=product">{{ 'home.concerns.ageing' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=barrier&type=product">{{ 'home.concerns.barrier' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=clarifying&type=product">{{ 'home.concerns.tone' | t }}</a></li>
      <li><a href="{{ routes.search_url }}?q=rice&type=product">{{ 'home.concerns.dullness' | t }}</a></li>
    </ul>
  </nav>
</section>

<section class="block-container personal" data-personal hidden>
  <div class="personal__header">
    <div>
      <p class="eyebrow">{{ 'personal.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'personal.title' | t }}</h2>
      <p class="personal__summary" data-personal-summary></p>
    </div>
    <div class="button-row">
      <a class="button button--outline" href="#regimen">{{ 'personal.open_builder' | t }}</a>
      <a class="link-button" href="#quiz" data-quiz-restart>{{ 'personal.retake' | t }}</a>
    </div>
  </div>
  <ul class="mini-grid" role="list" data-personal-list></ul>
</section>

<section class="block-container">
  {%- liquid
    assign grid_eyebrow = 'home.collection.eyebrow' | t
    assign grid_heading = 'home.collection.title' | t
  -%}
  {% render 'product-grid',
    collection: settings.home_collection,
    limit: 8,
    eyebrow: grid_eyebrow,
    heading: grid_heading,
    show_view_all: true
  %}
</section>

<section class="block-container tone-accent quiz-section" id="quiz">
  <div class="quiz" data-quiz hidden>
    <div class="quiz__intro">
      <p class="eyebrow">{{ 'quiz.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'quiz.title' | t }}</h2>
      <p>{{ 'quiz.intro' | t }}</p>
    </div>

    <form class="quiz__form" data-quiz-form novalidate>
      <fieldset class="quiz__step" data-quiz-step>
        <legend class="quiz__question">
          <span class="quiz__count">1 / 3</span>
          {{ 'quiz.q_concern' | t }}
        </legend>
        <div class="quiz__options">
          <label class="quiz__option"><input type="radio" name="concern" value="hydration" required><span>{{ 'quiz.concern_hydration' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="brightness"><span>{{ 'quiz.concern_brightness' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="dark_spots"><span>{{ 'quiz.concern_dark_spots' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="pores"><span>{{ 'quiz.concern_pores' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="fine_lines"><span>{{ 'quiz.concern_fine_lines' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="barrier"><span>{{ 'quiz.concern_barrier' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="tone"><span>{{ 'quiz.concern_tone' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="concern" value="texture"><span>{{ 'quiz.concern_texture' | t }}</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz__step" data-quiz-step hidden>
        <legend class="quiz__question">
          <span class="quiz__count">2 / 3</span>
          {{ 'quiz.q_sensitive' | t }}
        </legend>
        <div class="quiz__options">
          <label class="quiz__option"><input type="radio" name="sensitive" value="yes" required><span>{{ 'quiz.sensitive_yes' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="sensitive" value="no"><span>{{ 'quiz.sensitive_no' | t }}</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz__step" data-quiz-step hidden>
        <legend class="quiz__question">
          <span class="quiz__count">3 / 3</span>
          {{ 'quiz.q_time' | t }}
        </legend>
        <div class="quiz__options">
          <label class="quiz__option"><input type="radio" name="time" value="am" required><span>{{ 'quiz.time_am' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="time" value="pm"><span>{{ 'quiz.time_pm' | t }}</span></label>
          <label class="quiz__option"><input type="radio" name="time" value="both"><span>{{ 'quiz.time_both' | t }}</span></label>
        </div>
      </fieldset>

      <p class="quiz__error" role="alert" data-quiz-error hidden>{{ 'quiz.choose_one' | t }}</p>

      <div class="quiz__nav">
        <button type="button" class="button button--outline" data-quiz-back hidden>{{ 'quiz.back' | t }}</button>
        <button type="submit" class="button" data-quiz-next data-label-next="{{ 'quiz.next' | t }}" data-label-finish="{{ 'quiz.finish' | t }}">
          {{- 'quiz.next' | t -}}
        </button>
      </div>
    </form>

    <div class="quiz__result" data-quiz-result hidden tabindex="-1">
      <h3 class="quiz__result-title">{{ 'quiz.result_title' | t }}</h3>
      <p class="quiz__result-note" data-quiz-note></p>
      <ul class="mini-grid" role="list" data-quiz-list></ul>
      <div class="button-row">
        <button type="button" class="button" data-quiz-add>{{ 'quiz.add_all' | t }}</button>
        <a class="button button--outline" href="#regimen">{{ 'quiz.see_routine' | t }}</a>
        <button type="button" class="link-button" data-quiz-restart>{{ 'quiz.restart' | t }}</button>
      </div>
    </div>
  </div>
  <noscript>
    <div class="quiz__intro">
      <h2 class="section-title">{{ 'quiz.title' | t }}</h2>
      <p>{{ 'quiz.no_script' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.hero.primary_cta' | t }}</a>
    </div>
  </noscript>
</section>

<section class="block-container tone-surface">
  <div class="brand-story">
    <div class="clover" aria-hidden="true">
      <span class="clover__label">{{ 'home.story.shape_label' | t }}</span>
    </div>
    <div class="brand-story__copy">
      <p class="eyebrow">{{ 'home.story.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'home.story.title' | t }}</h2>
      <p>{{ 'home.story.body' | t }}</p>
      <ul class="pillars" role="list">
        <li>{{ 'home.story.pillar_powerful' | t }}</li>
        <li>{{ 'home.story.pillar_potential' | t }}</li>
        <li>{{ 'home.story.pillar_hydrate' | t }}</li>
        <li>{{ 'home.story.pillar_empower' | t }}</li>
        <li>{{ 'home.story.pillar_rejuvenate' | t }}</li>
        <li>{{ 'home.story.pillar_natural' | t }}</li>
      </ul>
    </div>
  </div>
</section>

<section class="block-container">
  <div class="regimen" id="regimen">
    <div class="regimen__intro">
      <p class="eyebrow">{{ 'home.regimen.eyebrow' | t }}</p>
      <h2 class="section-title">{{ 'home.regimen.title' | t }}</h2>
      <p>{{ 'home.regimen.body' | t }}</p>
    </div>

    <ol class="regimen__steps" role="list">
      <li>
        <span class="regimen__number">01</span>
        <h3>{{ 'home.regimen.step_1_title' | t }}</h3>
        <p>{{ 'home.regimen.step_1_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">02</span>
        <h3>{{ 'home.regimen.step_2_title' | t }}</h3>
        <p>{{ 'home.regimen.step_2_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">03</span>
        <h3>{{ 'home.regimen.step_3_title' | t }}</h3>
        <p>{{ 'home.regimen.step_3_body' | t }}</p>
      </li>
      <li>
        <span class="regimen__number">04</span>
        <h3>{{ 'home.regimen.step_4_title' | t }}</h3>
        <p>{{ 'home.regimen.step_4_body' | t }}</p>
      </li>
    </ol>

    <div class="builder" data-routine-builder hidden>
      <h3 class="pairing__title">{{ 'routine.title' | t }}</h3>
      <p class="builder__intro">{{ 'routine.intro' | t }}</p>
      <div class="builder__picker" role="group" aria-label="{{ 'routine.pick_label' | t }}" data-builder-picker></div>

      <div class="builder__output" aria-live="polite">
        <div class="builder__col">
          <h4 class="builder__heading">{{ 'routine.am' | t }}</h4>
          <ol class="builder__steps" data-builder-am></ol>
        </div>
        <div class="builder__col builder__col--pm">
          <h4 class="builder__heading">{{ 'routine.pm' | t }}</h4>
          <ol class="builder__steps" data-builder-pm></ol>
        </div>
      </div>
      <div class="builder__alternate" data-builder-alternate hidden>
        <h4 class="builder__heading">{{ 'routine.alternate_title' | t }}</h4>
        <ul class="builder__steps" role="list"></ul>
      </div>
      <ul class="builder__notes" role="list" data-builder-notes></ul>

      <div class="button-row">
        <button type="button" class="button" data-builder-add disabled>{{ 'routine.add_routine' | t }}</button>
        <button type="button" class="button button--outline" data-builder-share>{{ 'routine.share' | t }}</button>
        <button type="button" class="link-button" data-builder-clear>{{ 'routine.clear' | t }}</button>
      </div>
      <p class="builder__status" role="status" data-builder-status></p>
    </div>

    <details class="pairing" open data-pairing-table>
      <summary class="pairing__title">{{ 'home.pairing.title' | t }}</summary>
      <table class="pairing__table">
        <thead>
          <tr>
            <th scope="col">{{ 'home.pairing.col_serum' | t }}</th>
            <th scope="col">{{ 'home.pairing.col_when' | t }}</th>
            <th scope="col">{{ 'home.pairing.col_avoid' | t }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ 'home.pairing.vitamin_c' | t }}</th>
            <td>{{ 'home.pairing.am' | t }}</td>
            <td>{{ 'home.pairing.vitamin_c_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.retinol' | t }}</th>
            <td>{{ 'home.pairing.pm' | t }}</td>
            <td>{{ 'home.pairing.retinol_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.niacinamide' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.niacinamide_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.hyaluronic' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.none' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.snail' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.snail_avoid' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.rice' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.rice_note' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.barrier' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.barrier_note' | t }}</td>
          </tr>
          <tr>
            <th scope="row">{{ 'home.pairing.clarifying' | t }}</th>
            <td>{{ 'home.pairing.am_pm' | t }}</td>
            <td>{{ 'home.pairing.clarifying_note' | t }}</td>
          </tr>
        </tbody>
      </table>
      <p class="pairing__note">{{ 'home.pairing.note' | t }}</p>
    </details>
  </div>
</section>

<section class="block-container" data-recently-viewed hidden>
  <div class="personal__header">
    <h2 class="section-title">{{ 'personal.recently_viewed' | t }}</h2>
  </div>
  <ul class="mini-grid" role="list" data-recently-list></ul>
</section>

<section class="block-container tone-inverse">
  <ul class="promises" role="list">
    <li>
      <h3>{{ 'home.promises.origin_title' | t }}</h3>
      <p>{{ 'home.promises.origin_body' | t }}</p>
    </li>
    <li>
      <h3>{{ 'home.promises.inci_title' | t }}</h3>
      <p>{{ 'home.promises.inci_body' | t }}</p>
    </li>
    <li>
      <h3>{{ 'home.promises.directions_title' | t }}</h3>
      <p>{{ 'home.promises.directions_body' | t }}</p>
    </li>
  </ul>
</section>
