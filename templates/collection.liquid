<section class="block-container">
  {% paginate collection.products by 24 %}
    <div class="page-header">
      <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
      <h1 class="page-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="page-header__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {% render 'collection-filters', results: collection, count: collection.products_count %}

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}
          <li>
            {%- if forloop.index <= 4 -%}
              {% render 'product-card', product: product, image_loading: 'eager' %}
            {%- else -%}
              {% render 'product-card', product: product %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="empty-state">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}
  {% endpaginate %}
</section>
