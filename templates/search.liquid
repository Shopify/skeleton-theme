<section class="block-container">
  <div class="page-header">
    <h1 class="page-title">{{ 'search.title' | t }}</h1>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label>
      <input
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="button">{{ 'search.submit' | t }}</button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="empty-state">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="collection-toolbar__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {% paginate search.results by 24 %}
        <ul class="product-grid" role="list">
          {% for result in search.results %}
            <li>
              {%- if result.object_type == 'product' -%}
                {% render 'product-card', product: result %}
              {%- else -%}
                <article class="search-result">
                  <p class="eyebrow">{{ result.object_type }}</p>
                  <h2 class="search-result__title">{{ result.title | link_to: result.url }}</h2>
                  <p>{{ result.content | strip_html | truncatewords: 24 }}</p>
                </article>
              {%- endif -%}
            </li>
          {% endfor %}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
