[
  {
    "name": "theme_info",
    "theme_name": "Glow Verve",
    "theme_version": "1.0.0",
    "theme_author": "Glow Verve",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_mark",
        "label": "t:labels.logo_mark"
      },
      {
        "type": "image_picker",
        "id": "logo_stacked",
        "label": "t:labels.logo_stacked"
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 20,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "t:labels.logo_height",
        "default": 36
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "montserrat_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "text",
        "id": "custom_heading_font_url",
        "label": "t:labels.custom_heading_font_url",
        "info": "t:info.custom_heading_font_url"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#000000",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F7EBCD",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#DFAB52",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "accent_foreground_color",
        "default": "#000000",
        "label": "t:labels.accent_foreground"
      },
      {
        "type": "color",
        "id": "product_tile_color",
        "default": "#F5F3EE",
        "label": "t:labels.product_tile"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.announcement_bar",
    "settings": [
      {
        "type": "text",
        "id": "announcement_message",
        "label": "t:labels.message",
        "info": "t:info.announcement_message"
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "t:labels.link"
      }
    ]
  },
  {
    "name": "t:general.header",
    "settings": [
      {
        "type": "link_list",
        "id": "header_menu",
        "label": "t:labels.menu",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "customer_account_menu",
        "label": "t:labels.customer_account_menu",
        "default": "customer-account-main-menu"
      }
    ]
  },
  {
    "name": "t:general.footer",
    "settings": [
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "t:labels.menu",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "footer_menu_secondary",
        "label": "t:labels.menu_secondary",
        "default": "footer"
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "t:labels.show_payment_icons",
        "default": true
      }
    ]
  }
]
