{% doc %}
  Renders the storefront header: brand logo, main menu, search, customer
  account entry, and bag link. Composed directly in layout/theme.liquid so
  it wraps every page. On small screens the menu collapses into a
  <details> drawer that needs no JavaScript.

  Self-contained: callers leave the body empty.
{% enddoc %}

<header class="site-header" {{ block.shopify_attributes }}>
  <details class="site-header__drawer" scroll-lock>
    <summary class="site-header__menu-toggle" aria-label="{{ 'header.menu' | t }}">
      <span class="hamburger" aria-hidden="true"></span>
    </summary>
    <nav class="site-header__drawer-nav" aria-label="{{ 'header.menu' | t }}">
      <ul>
        {% for link in block.settings.menu.links %}
          <li>
            <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {% endfor %}
        <li><a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a></li>
        {% if shop.customer_accounts_enabled %}
          <li><a href="{{ routes.account_url }}">{{ 'header.account' | t }}</a></li>
        {% endif %}
      </ul>
    </nav>
  </details>

  <a class="site-header__logo" href="{{ routes.root_url }}">
    {%- if settings.logo -%}
      {{
        settings.logo
        | image_url: height: 160
        | image_tag: alt: shop.name, loading: 'eager', fetchpriority: 'high', class: 'site-header__logo-image'
      }}
    {%- else -%}
      <span class="site-header__wordmark">{{ shop.name }}</span>
    {%- endif -%}
  </a>

  <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
    <ul>
      {% for link in block.settings.menu.links %}
        <li>
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  <div class="site-header__icons">
    <a class="site-header__icon site-header__icon--search" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </a>

    {% if shop.customer_accounts_enabled %}
      <shopify-account class="site-header__icon" menu="{{ block.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a class="site-header__bag" href="{{ routes.cart_url }}">
      <span>{{ 'header.bag' | t }}</span>
      <span class="site-header__bag-count" aria-label="{{ 'header.bag_count' | t: count: cart.item_count }}">({{ cart.item_count }})</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
